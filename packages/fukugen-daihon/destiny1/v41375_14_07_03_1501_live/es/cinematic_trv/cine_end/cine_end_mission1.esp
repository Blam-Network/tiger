# es\cinematic_trv\cine_end\cine_end_mission1.esp
#
# Mission 1, the outro cinematic. As cine_speaker's, the activity is
# complete before the cinematic plays: retail sends activity_complete in the
# update that takes the lifetime to 4 and starts the cinematic (0.9 s after
# pregame). The end comes 2.1 s after the client's cinematic_finished.

cinematic_midmission cine_123a_end

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game()

script main():
    set_activity_complete()
    cine_123a_end.start()
    sleep_until(cine_123a_end.is_complete())
