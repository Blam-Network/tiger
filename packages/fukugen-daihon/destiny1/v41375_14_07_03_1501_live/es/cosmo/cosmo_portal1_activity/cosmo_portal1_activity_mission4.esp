# Mission 4: leave the refinery and head to the blast. Clears at the trigger.

trigger_volume_objective obj_s1_phase03_m1

thread init: pass

thread complete: pass

thread main:
    obj_s1_phase03_m1.objective_begin()
    sleep_until(obj_s1_phase03_m1.is_complete())
    obj_s1_phase03_m1.objective_end_silent()
