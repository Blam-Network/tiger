# es\cosmo\act_cosmo_m2_dome_c\act_cosmo_m2_dome_c_mission5.esp
#
# Mission 5, the beacon: with the waves dead the Ghost speaks and the
# objective sends the player to destroy the beacon, whose device comes on as
# the objective does (and the console's a second later). Once it is down
# the outro plays, the activity ends, and the Ghost and Rasputin close it
# out: Rasputin's broadcast follows the Ghost's line.
#
# The phase waits on the beacon's death as well as the objective's kill
# listener: the destructible kill carries the beacon's identifier only in
# its metadata, which the host's kill report does not pass on. One run: the
# pauses before the objective, after the beacon and between the closing
# lines are that run's.

destructible_objective obj_m2_o4b bind("0x365FAC19")
encounter_handle enc_dome_c_m2
sequence seq_d_o2_s03
sequence seq_m_outro
sequence seq_d_o2_s034
sequence seq_cosmo2_rasputin
sequence seq_d_o2_s04

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    insertion_point()
    seq_d_o2_s03.start()
    sleep(4)
    beacon = enc_dome_c_m2.obj_placement_m2_o4b._object
    enc_dome_c_m2.sc_beacon.wake()
    obj_m2_o4b.objective_begin()
    sleep_until(obj_m2_o4b.is_complete() or not beacon.is_alive())
    obj_m2_o4b.objective_end_silent()
    sleep(1)
    seq_m_outro.start()
    sc_closing_lines.wake()
    set_activity_complete()

script sc_closing_lines():
    sleep(1.5)
    seq_d_o2_s034.start()
    sleep_until(seq_d_o2_s034.is_done())
    seq_cosmo2_rasputin.start()
    sleep(2.5)
    seq_d_o2_s04.start()
