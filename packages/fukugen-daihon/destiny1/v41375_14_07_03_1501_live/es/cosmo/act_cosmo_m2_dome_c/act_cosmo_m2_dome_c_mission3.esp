# es\cosmo\act_cosmo_m2_dome_c\act_cosmo_m2_dome_c_mission3.esp
#
# Mission 3, dome_c: find the console and use it. The objective comes up
# with the Ghost's line as the phase starts, while the player is still on
# the Dry Sea. The Fallen on the way are enc_dome_c_m2's; when the captain
# in the guards' hall falls the music's second cue starts and the Ghost's
# line is cut. Using the console clears the objective; the Ghost speaks and
# the phase ends a few seconds into the line.
#
# One run: the pause before the Ghost's line and the hold after it are that
# run's.

@hard_wipe()
interactable_objective obj_m2_o3 bind("0x9DF3A02E")
encounter_handle enc_dome_c_m2
sequence seq_d_o2_s005
sequence seq_d_o2_s01
sequence seq_m_cue2

script init(): pass

script complete(): pass

script main():
    insertion_point()
    seq_d_o2_s005.start()
    sc_guards_hall.wake()
    obj_m2_o3.objective_begin()
    sleep_until(obj_m2_o3.is_complete())
    obj_m2_o3.objective_end_silent()
    sleep(1.5)
    seq_d_o2_s01.start()
    sleep(6)

script sc_guards_hall():
    sleep_until(enc_dome_c_m2.guards_captain_down == true)
    seq_d_o2_s005.stop()
    seq_m_cue2.start()
    seq_m_cue2.set_switch_mask(1)
