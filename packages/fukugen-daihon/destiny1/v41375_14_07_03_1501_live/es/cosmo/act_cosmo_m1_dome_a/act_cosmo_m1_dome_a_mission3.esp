# es\cosmo\act_cosmo_m1_dome_a\act_cosmo_m1_dome_a_mission3.esp
#
# Mission 3, the end: no objective. The fight music stops, the outro starts,
# and the activity completes a moment later; the results follow 30 seconds
# after that. From one retail 2.3.1 capture: the gaps are that run's.

sequence seq_m_cue1
sequence seq_m_outro

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    seq_m_cue1.stop()
    sleep(0.6)
    seq_m_outro.start()
    sleep(1.6)
    set_activity_complete()
