# es\cosmo\cine_reveal\cine_reveal_mission2.esp
#
# Mission 2, the Tower cinematic. Retail sends activity_complete 3.6-4.0 s
# after the phase starts (five runs) and starts the cinematic 0.4-0.5 s
# after that; the activity ends 1.5-2.3 s after the client's
# cinematic_finished.

cinematic_midmission cine_107_twr

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game()

script main():
    sleep(4)
    set_activity_complete()
    cine_107_twr.start()
    sleep_until(cine_107_twr.is_complete())
