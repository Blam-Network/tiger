# es\cosmo\act_cosmo_m0_5_hangar\act_cosmo_m0_5_hangar_mission2.esp
#
# Mission 2, back to the hangar: the music starts with the phase and steps up
# as the player gets there. The hangar's Fallen and the ultra are
# enc_hangar_m0_5's (and the ambient enc_hangar_amb1's); this phase waits on
# them. The bubble objective stays up until the ultra lands, then the loot
# objective comes up with its Vandals and clears as its loot is picked up
# (on 2.3.1 the ultra's kill and the quest pickup come in one packet).
#
# Four runs: every wait below held in all of them, within half a second.

@hard_wipe()
location hangar
trigger_bubble_objective obj_m0_5_goto_hangar bind(hangar)
collect_loot_objective obj_m0_5_loot bind("0x243999A0", 1)
squad sq_amb_fallen_ultra
sequence seq_m_cue1
sequence seq_d_o4_s01
sequence seq_d_o4_s02
sequence seq_d_o4_s03

script init(): pass

script complete(): pass

script main():
    seq_m_cue1.start()
    seq_m_cue1.set_switch_mask(3)
    seq_d_o4_s01.start()
    seq_d_o4_s02.start()
    obj_m0_5_goto_hangar.objective_begin()
    sleep_until(obj_m0_5_goto_hangar.is_complete())
    seq_m_cue1.set_switch_mask(7)
    sleep_until(sq_amb_fallen_ultra.alive_count() > 0)
    obj_m0_5_goto_hangar.objective_end_silent()
    sleep(2)
    seq_m_cue1.set_switch_mask(15)
    seq_d_o4_s03.start()
    sleep(3)
    obj_m0_5_loot.objective_begin()
    sleep_until(obj_m0_5_loot.is_complete())
    obj_m0_5_loot.objective_end_silent()
