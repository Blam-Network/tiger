# es\cosmo\act_cosmo_m0_5_hangar\act_cosmo_m0_5_hangar_mission2.esp
#
# Mission 2, back to the hangar: reach it, kill its Fallen, and the ultra
# comes in (enc_hangar_m0_5). The objective clears as the ultra lands; its
# Vandals follow, and the loot is picked up off the ultra. The music cue
# steps up on reaching the hangar and again when the ultra lands. From one
# retail capture.

c_location_sensor_host hangar
trigger_bubble_objective obj_m0_5_goto_hangar bind(hangar)
collect_loot_objective obj_m0_5_loot bind("0x243999A0", 1)
c_squad_sensor_host sq_amb_fallen_ultra
c_sequence_host seq_m_cue1
c_sequence_host seq_d_o4_s01
c_sequence_host seq_d_o4_s02
c_sequence_host seq_d_o4_s03

thread init: pass

thread complete: pass

thread main:
    seq_m_cue1.start()
    seq_m_cue1.set_switch_mask(3)
    seq_d_o4_s01.start()
    seq_d_o4_s02.start()
    sc_hangar_music.wake()
    obj_m0_5_goto_hangar.objective_begin()
    # the ultra lands once the hangar's Fallen are down
    sleep_until(sq_amb_fallen_ultra.alive_count() > 0)
    obj_m0_5_goto_hangar.objective_end_silent()
    sleep(2.1)
    seq_m_cue1.set_switch_mask(15)
    seq_d_o4_s03.start()
    sleep(2.9)
    obj_m0_5_loot.objective_begin()
    sleep_until(obj_m0_5_loot.is_complete())
    obj_m0_5_loot.objective_end_silent()

thread sc_hangar_music:
    sleep_until(obj_m0_5_goto_hangar.is_complete())
    seq_m_cue1.set_switch_mask(7)
