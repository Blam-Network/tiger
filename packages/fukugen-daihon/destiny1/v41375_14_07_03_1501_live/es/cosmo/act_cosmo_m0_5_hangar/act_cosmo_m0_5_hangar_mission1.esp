# es\cosmo\act_cosmo_m0_5_hangar\act_cosmo_m0_5_hangar_mission1.esp
#
# Mission 1, delta_s: the player uses two things in turn, the flare from the
# crash and then the next object (each ends on the player's interaction on the
# wire, so they are interactable objectives). The flare goes out as the first
# is used. The gap before the second is this run's wait.

c_object_sensor_host o_crashed_ship_flare
interactable_objective obj_m0_5_o1 bind("0x6607D3FA")
interactable_objective obj_m0_5_o2 bind("0xDE0933DB")
c_sequence_host seq_d_o1_s01
c_sequence_host seq_d_o1_s02
c_sequence_host seq_d_o2_s02
c_sequence_host seq_d_o2_s04
c_sequence_host seq_d_o2_s05
c_sequence_host seq_d_o2_s06

thread init: pass

thread complete: pass

thread main:
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    o_crashed_ship_flare.create()
    sleep(1.3)
    sc_first_line.wake()
    obj_m0_5_o1.objective_begin()
    sleep_until(obj_m0_5_o1.is_complete())
    o_crashed_ship_flare.delete_object()
    obj_m0_5_o1.objective_end()
    seq_d_o1_s02.start()
    sleep(27.4)
    seq_d_o2_s02.start()
    seq_d_o2_s04.start()
    obj_m0_5_o2.objective_begin()
    sleep_until(obj_m0_5_o2.is_complete())
    seq_d_o2_s04.stop()
    obj_m0_5_o2.objective_end_silent()
    seq_d_o2_s05.start()
    sleep(7.8)
    seq_d_o2_s06.start()
    # the next phase follows the last line
    sleep(2.9)

thread sc_first_line:
    sleep(1.3)
    seq_d_o1_s01.start()
