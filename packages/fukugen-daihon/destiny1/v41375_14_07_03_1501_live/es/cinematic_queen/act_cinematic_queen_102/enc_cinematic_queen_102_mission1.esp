# es\cinematic_queen\act_cinematic_queen_102\enc_cinematic_queen_102_mission1.esp
#
# Mission 1, the Queen cinematic. As cine_speaker's, the activity is
# complete before the cinematic plays: both runs send activity_complete in
# the update that takes the lifetime to 4 and starts the cinematic (0.9-1.1
# s after pregame). The end comes 1.5-1.8 s after the client's
# cinematic_finished, skipped or not.

cinematic_midmission pf_117_que

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game()

script main():
    set_activity_complete()
    pf_117_que.start()
    sleep_until(pf_117_que.is_complete())
