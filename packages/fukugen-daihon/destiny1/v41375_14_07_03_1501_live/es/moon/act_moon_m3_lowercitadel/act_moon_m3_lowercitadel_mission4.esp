# es\moon\act_moon_m3_lowercitadel\act_moon_m3_lowercitadel_mission4.esp
#
# Mission 4, the Grave: the chamber's console comes alive once the guards are
# dead; using it starts the Ghost's scan, and the player defends it until the
# scan is done. enc_strength_m3 runs the scan and the Hive waves; the
# objective clears when its console reports the scan finished. The console
# itself is placed by the activity root.

c_encounter_handle enc_strength_m3
interactable_placement pf_obj_strength_interact_place  # archetype not authored on TU0
interactable_objective pf_obj_strength_interact bind("0x9D0AD7E7")
generic_objective pf_obj_strength_defend
c_nav_point_host ap_defend
c_trigger_group_host tg_moon_m3_climax_so
c_sequence_host seq_wave_announce1
c_sequence_host seq_strength_music
c_sequence_host seq_d_o2_s03
c_sequence_host seq_d_o2_s04

thread init: pass

thread complete: pass

thread main:
    enc = enc_strength_m3
    seq_strength_music.set_switch_mask(15)
    enc.sc_scan.wake()
    pf_obj_strength_interact.objective_begin()
    sleep_until(pf_obj_strength_interact.is_complete())
    pf_obj_strength_interact.objective_end_silent()
    pf_obj_strength_interact_place._object.set_device_position(0.3)
    enc.sc_defend.wake()
    pf_obj_strength_defend.objective_begin(ap_defend)
    tg_moon_m3_climax_so.activate()
    seq_d_o2_s03.start()
    sc_wave_announce.wake()
    sc_ghost_nag.wake()
    sleep_until(enc.o_m3_console_scan.get_device_position() >= 1)
    pf_obj_strength_defend.complete()
    pf_obj_strength_defend.objective_end_silent()
    tg_moon_m3_climax_so.deactivate()
    set_activity_complete()
    sleep(1)
    pf_obj_strength_interact_place._object.set_device_position(1)

# the first wave is called out once the chamber's spec ops marker is up
thread sc_wave_announce:
    sleep_until(enc_strength_m3.o_m3_spec_ops.is_alive())
    sleep(1)
    seq_wave_announce1.start()

# the Ghost's line partway through the defence (one run)
thread sc_ghost_nag:
    sleep(38)
    seq_d_o2_s04.start()
