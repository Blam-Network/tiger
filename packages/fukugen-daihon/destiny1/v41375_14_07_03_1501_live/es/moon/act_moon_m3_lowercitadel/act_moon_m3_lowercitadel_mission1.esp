# es\moon\act_moon_m3_lowercitadel\act_moon_m3_lowercitadel_mission1.esp
#
# Mission 1, the way to the Lower Citadel: the activity goes live once the
# players are in, and the objective is to reach the Lower Citadel. It clears
# on entering the bubble. Two runs agree to a tenth of a second: the
# objective shows 1.8 s after the activity goes live (wire state 1, which
# TU0 has no verb for; act_moon_m1_launchtubes' first objective does the
# same) and goes active 12 s after that, with no incoming state between.

location lowercitadel
trigger_bubble_objective pf_objective_goto bind(lowercitadel)
sequence seq_d_o1_s03
sequence seq_d_o1_s031

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep(2)
    # the objective shows here (wire state 1)
    sleep(12)
    pf_objective_goto.objective_begin_immediate()
    sleep_until(pf_objective_goto.is_complete())
    pf_objective_goto.objective_end_silent()
    # the Ghost's lines for the way down stop with the objective
    seq_d_o1_s03.stop()
    seq_d_o1_s031.stop()
