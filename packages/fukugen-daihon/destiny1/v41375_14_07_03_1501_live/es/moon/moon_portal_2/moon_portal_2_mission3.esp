# es\moon\moon_portal_2\moon_portal_2_mission3.esp
#
# Mission 3: down through the lower hall to the lower citadel. Phogoth roars
# twice on the way, off the hall encounter's triggers; in the capture the
# objective cleared at the second roar, not at its own volume.

c_encounter_handle enc_uppercitadel_portal2
trigger_volume_objective pf_tv_lowercitadel_entrance
c_sequence_host moon_portal2_ogreroar01
c_sequence_host moon_portal2_ogreroar02

thread init: pass

thread complete: pass

thread main:
    enc = enc_uppercitadel_portal2
    pf_tv_lowercitadel_entrance.objective_begin()
    sleep_until(enc.pt_ogreroar01.is_triggered())
    moon_portal2_ogreroar01.start()
    sleep_until(enc.pt_ogreroar02.is_triggered() or pf_tv_lowercitadel_entrance.is_complete())
    moon_portal2_ogreroar02.start()
    pf_tv_lowercitadel_entrance.objective_end_silent()
    sleep_until_timeout(moon_portal2_ogreroar02.is_done(), 10)
