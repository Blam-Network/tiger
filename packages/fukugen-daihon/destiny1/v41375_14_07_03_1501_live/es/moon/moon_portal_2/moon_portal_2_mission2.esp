# es\moon\moon_portal_2\moon_portal_2_mission2.esp
#
# Mission 2, the hall: the Ghost works the door while the Hive come in three
# waves, left, right and rear, each behind a gate lock. The objective counts
# the locks as they fall and completes when the scan does; the hall encounter
# runs the waves, the locks and the scan. The exit opens with the objective.

@hard_wipe()
encounter_handle enc_uppercitadel_portal2
player_objective po_kill_reinforcements
nav_point ap_waveannounce_1
nav_point ap_waveannounce_2
nav_point ap_waveannounce_3
sequence moon_portal2_wave_announce1
sequence moon_portal2_wave_announce2
sequence moon_portal2_wave_announce3

script init(): pass

script complete(): pass

script main():
    enc = enc_uppercitadel_portal2
    enc.sc_hack.wake()
    sleep(3)
    po_kill_reinforcements.set_active()
    sleep(2)
    po_kill_reinforcements.progress_activate(0, 3)
    sleep(1)
    announce(moon_portal2_wave_announce1, ap_waveannounce_1)
    wait_for_lock(enc.o_gate_lock01, 1)
    sleep(10)
    announce(moon_portal2_wave_announce2, ap_waveannounce_2)
    wait_for_lock(enc.o_gate_lock02, 2)
    sleep(10)
    announce(moon_portal2_wave_announce3, ap_waveannounce_3)
    sleep_until(enc.pf_i_door_placement._object.get_device_position() >= 1)
    po_kill_reinforcements.progress_update(3)
    sleep_until(not enc.o_gate_lock03.is_alive())
    sleep(3)
    po_kill_reinforcements.set_complete()
    enc.o_door_dummy.set_device_position(1)
    sleep(3)
    po_kill_reinforcements.clear()
    sleep(2)

def announce(line, nav_point):
    line.start()
    po_kill_reinforcements.nav_point_activate(nav_point)

def wait_for_lock(lock, count):
    sleep_until(lock.get_device_position() >= 1)
    po_kill_reinforcements.progress_update(count)
