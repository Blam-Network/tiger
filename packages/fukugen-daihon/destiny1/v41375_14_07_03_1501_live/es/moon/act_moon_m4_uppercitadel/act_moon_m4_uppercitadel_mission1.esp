# es\moon\act_moon_m4_uppercitadel\act_moon_m4_uppercitadel_mission1.esp
#
# Mission 1, "Go to the Hellmouth". The activity goes active once the players
# are in; the Ghost talks at the landing zone and the objective comes up as
# soon as he has finished (11 s after his line started, which runs 10.4 s).
# It clears when a player enters the Hellmouth. One run.
#
# The objective showed state 1 on the wire 1.6 s after the spawn, before the
# Ghost's line; the host has no verb for that stage, so it is left out.

location hellmouth
trigger_bubble_objective pf_objective_hellmouth_goto bind(hellmouth)
sequence seq_d_accel_lz_s01

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep(2)
    seq_d_accel_lz_s01.start()
    sleep_until(seq_d_accel_lz_s01.is_done())
    pf_objective_hellmouth_goto.objective_begin_immediate()
    sleep_until(pf_objective_hellmouth_goto.is_complete())
    pf_objective_hellmouth_goto.objective_end_silent()
