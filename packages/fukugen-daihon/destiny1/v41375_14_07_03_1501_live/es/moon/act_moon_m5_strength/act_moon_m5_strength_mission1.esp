# es\moon\act_moon_m5_strength\act_moon_m5_strength_mission1.esp
#
# Mission 1, the Hellmouth: the Ghost reads the ritual off two Hive objects.
# The activity goes active once the players are in, and the objective comes
# up ten seconds later with a bar for the two objects. Each use moves the
# bar and the Ghost answers it three seconds on; after the second, his last
# two lines play out and the objective clears.
#
# The objects are enc_hellmouth_amb1's (obj_m5_multi_placement sets them
# out in the public bubble, 0xE3541DC3 and 0xEF6113DE), so the uses arrive
# on the Hellmouth's public host. This phase raises the activity flags that
# let the players use them and listens for the uses itself: the two-object
# objective has no archetype on TU0 (its rows are an object set).
#
# Two runs agree to the tick: active 10.3 / 10.4 s after the spawn (the wire
# shows a state 1 at 1.6 s first, which has no verb in the host), a line 3.0
# to 3.4 s after each use, the last line 5 s after that and the clear 1.8 /
# 1.9 s later.

encounter_handle obj_m5_multi_interact
activity_flag af_m5_multi_a
activity_flag af_m5_multi_b
interactable_incident_listener il_m5_multi_a
interactable_incident_listener il_m5_multi_b
sequence seq_d_o1_s075
sequence seq_d_o1_s078
sequence seq_d_o1_s08

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep(10)
    read_the_ritual()

# the two-object objective, start to finish
def read_the_ritual():
    po = obj_m5_multi_interact._player_objective
    po.set_active()
    po.progress_activate(0, 2)
    po.nav_point_activate(obj_m5_multi_interact._nav_point)
    il_m5_multi_a.import_only_bind("0xE3541DC3")
    il_m5_multi_b.import_only_bind("0xEF6113DE")
    il_m5_multi_a.reset()
    il_m5_multi_b.reset()
    af_m5_multi_a.import_only_bind("0xE3541DC3")
    af_m5_multi_b.import_only_bind("0xEF6113DE")
    af_m5_multi_a.activate()
    af_m5_multi_b.activate()
    sleep_until(objects_used() >= 1)
    po.progress_update(1)
    sleep(3)
    seq_d_o1_s075.start()
    sleep_until(objects_used() >= 2)
    po.progress_update(2)
    sleep(3)
    seq_d_o1_s078.start()
    sleep(5)
    seq_d_o1_s08.start()
    sleep(2)
    af_m5_multi_a.clear()
    af_m5_multi_b.clear()
    po.nav_point_clear()
    po.clear()

def objects_used():
    used = 0
    if il_m5_multi_a.get_count() > 0:
        used = used + 1
    if il_m5_multi_b.get_count() > 0:
        used = used + 1
    return used
