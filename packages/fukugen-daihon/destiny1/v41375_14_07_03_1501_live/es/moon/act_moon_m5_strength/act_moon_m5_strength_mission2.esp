# es\moon\act_moon_m5_strength\act_moon_m5_strength_mission2.esp
#
# Mission 2, on to the launch tubes. The Ghost's launch tubes lines start
# with the objective (mission 3 stops them); it clears when a player reaches
# the launch tubes bubble. Two runs.

location launchtubes
trigger_bubble_objective pf_objective_goto bind(launchtubes)
sequence seq_d_o2_s01
sequence seq_d_o2_s012
sequence seq_d_o2_s014

script init(): pass

script complete(): pass

script main():
    for line in [seq_d_o2_s01, seq_d_o2_s012, seq_d_o2_s014]:
        line.start()
    pf_objective_goto.objective_begin()
    sleep_until(pf_objective_goto.is_complete())
    pf_objective_goto.objective_end_silent()
