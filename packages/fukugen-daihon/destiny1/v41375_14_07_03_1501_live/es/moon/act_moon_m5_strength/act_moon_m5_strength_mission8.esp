# es\moon\act_moon_m5_strength\act_moon_m5_strength_mission8.esp
#
# Mission 8, the shard: use the button. The Ghost's lines and the music's
# end follow the press on this run's clock (the button's device runs
# 0.1 to 1 over nine seconds on the host); the chamber takes the anomaly
# down once the objective clears, and the activity completes 22 seconds
# after it.

c_encounter_handle unknown_d53aaa20
interactable_objective pf_objective_button_a bind("0x0AA54CC0")
interactable_placement pf_placement_button_a bind("0x0AA54CC0")
c_sequence_host seq_strength_music
c_sequence_host seq_d_o2_s06
c_sequence_host seq_d_o2_s07
c_sequence_host seq_music_ascent

thread init: pass

thread complete:
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

thread main:
    enc = unknown_d53aaa20
    pf_objective_button_a.objective_begin()
    sleep_until(pf_objective_button_a.is_complete())
    sleep(4)
    seq_d_o2_s06.start()
    sleep(6)
    seq_strength_music.stop()
    seq_strength_music.set_switch_mask(255)
    sleep(1)
    pf_objective_button_a.objective_end_silent()
    enc.sc_shard.wake()
    sleep(6)
    seq_d_o2_s07.start()
    sleep(16)
    seq_music_ascent.start()
    set_activity_complete()
