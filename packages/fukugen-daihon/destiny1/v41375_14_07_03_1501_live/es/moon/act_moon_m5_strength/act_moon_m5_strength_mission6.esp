# es\moon\act_moon_m5_strength\act_moon_m5_strength_mission6.esp
#
# Mission 6, into the chamber: fight through the approach to the ritual's
# trigger volume. The approach's Hive belong to enc_strength_m5.

@hard_wipe()
trigger_volume_objective pf_obj_ritual_trigger

script init(): pass

script complete(): pass

script main():
    pf_obj_ritual_trigger.objective_begin()
    sleep_until(pf_obj_ritual_trigger.is_complete())
    pf_obj_ritual_trigger.objective_end_silent()
