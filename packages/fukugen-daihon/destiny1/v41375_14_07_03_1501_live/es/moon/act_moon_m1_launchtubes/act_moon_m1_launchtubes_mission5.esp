# es\moon\act_moon_m1_launchtubes\act_moon_m1_launchtubes_mission5.esp
#
# Mission 5, the launch tubes: find the fallen Guardian, then hit the button
# he died at. The button does nothing (the Hive are waiting): it sinks in,
# the music moves on and the phase ends a few seconds after the press, with
# the Ghost's lines. Two runs agree on every delay here to a second.

generic_objective pf_gen_obj_find_guardian
nav_point ap_find_guardian
player_trigger pt_guardian_down
interactable_objective pf_objective_button_false bind("0xB5C2FDD1")
interactable_placement pf_placement_button_false bind("0xB5C2FDD1")
sequence seq_d_o2_s06
sequence seq_d_o2_s07
sequence seq_d_o2_s08
sequence seq_music_launchtubes

script init(): pass

script complete(): pass

script main():
    seq_d_o2_s08.start()
    pf_gen_obj_find_guardian.objective_begin(ap_find_guardian)
    sleep_until(pt_guardian_down.is_triggered())
    sleep(1)
    pf_gen_obj_find_guardian.objective_end_silent()
    pf_objective_button_false.objective_begin()
    sleep_until(pf_objective_button_false.is_complete())
    sleep(1)
    seq_music_launchtubes.set_switch_mask(7)
    sleep(3)
    pf_placement_button_false._object.set_device_position(1)
    sleep(3)
    seq_d_o2_s06.stop()
    seq_d_o2_s07.stop()
    seq_d_o2_s08.stop()
    pf_objective_button_false.objective_end_silent()
