# es\moon\act_moon_m1_launchtubes\act_moon_m1_launchtubes_mission8.esp
#
# Mission 8, the court: reach the dead Guardian's Ghost, then kill the Knight
# that guards it (the launch tubes encounter brings it in at the Ghost's
# volume). The music moves on as the kill objective goes active and ends
# with the Knight. Two runs agree to a second.

@hard_wipe()
trigger_group tg_moon_m1_climax_so
trigger_volume_objective pf_trigger_ghost
kill_squad_objective pf_objective_kill bind("0x3DFAFA17", 1)
squad sq_court_high_b
sequence seq_d_o2_s09
sequence seq_music_launchtubes

script init(): pass

script complete(): pass

script main():
    tg_moon_m1_climax_so.activate()
    seq_d_o2_s09.start()
    sleep(2)
    pf_trigger_ghost.objective_begin()
    sleep_until(pf_trigger_ghost.is_complete())
    sleep(1)
    pf_trigger_ghost.objective_end_silent()
    pf_objective_kill.objective_begin()
    seq_music_launchtubes.set_switch_mask(63)
    # The objective's listener counts kills that name the Knight's identifier
    # (0x3DFAFA17); neither run's kill incident did, so the Knight's own death
    # ends it as well.
    sleep_until(pf_objective_kill.is_complete() or sq_court_high_b.alive_count() == 0)
    sleep(1)
    seq_music_launchtubes.set_switch_mask(127)
    seq_music_launchtubes.stop()
    pf_objective_kill.objective_end_silent()
    tg_moon_m1_climax_so.deactivate()
