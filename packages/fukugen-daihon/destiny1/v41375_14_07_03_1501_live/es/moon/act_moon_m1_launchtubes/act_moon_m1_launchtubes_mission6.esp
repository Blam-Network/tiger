# es\moon\act_moon_m1_launchtubes\act_moon_m1_launchtubes_mission6.esp
#
# Mission 6, the Hive emerge: the cinematic at the launch tube gate. The
# player is put back at the gate once it has played.

cinematic_midmission pf_cine_110_mst

script init(): pass

script complete(): pass

script main():
    pf_cine_110_mst.start()
    sleep_until(pf_cine_110_mst.is_complete())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
