# es\moon\act_moon_m7_selection\act_moon_m7_selection_mission1.esp
#
# Mission 1, the accelerator. The activity goes active once the players are
# in and the launch tubes phase follows three seconds later (3.0 s in the
# one run), with the intro music and the first lines (unknown_995fbd7f).

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep(3)
