# es\mars\act_mars_m01_valley\act_mars_m01_valley_mission3.esp
#
# Mission 3, "Clear the base": the garage is open and the alarm is up. The
# Cabal come in by dropship (enc_plains_m01); the objective clears once the
# second ship's troops are down too. The Ghost's base lines play here.
#
# One run: the 6 s after the last kill is the gap to the next phase on the
# wire (a host incident we cannot name sits in the middle of it).

generic_objective sp_objective_kill
c_nav_point_host np_base
c_sequence_host seq_music_cabal_intro
c_sequence_host seq_dialog_plains_tunnel
c_sequence_host seq_dialog_plains_base_alert
c_sequence_host seq_dialog_plains_base_arrive
c_squad_sensor_host sq_base_phalanx
c_squad_sensor_host sq_base_legionary_a
c_squad_sensor_host sq_base_legionary_b
c_squad_sensor_host sq_base_legionary_c
c_squad_sensor_host sq_backup_legionary_a
c_squad_sensor_host sq_backup_legionary_b
c_squad_sensor_host sq_sand_legionary_a
c_squad_sensor_host sq_sand_legionary_b
c_squad_sensor_host sq_sand_legionary_c
c_squad_sensor_host sq_anchor_centurion

thread init: pass

thread complete: pass

thread main:
    insertion_point()
    seq_dialog_plains_tunnel.stop()
    seq_dialog_plains_base_alert.start()
    seq_music_cabal_intro.set_switch_mask(7)
    sc_base_arrive.wake()
    sp_objective_kill.objective_begin(np_base)
    sleep_until(sand_alive_count() > 0)
    sleep_until(base_alive_count() + sand_alive_count() == 0)
    sp_objective_kill.objective_end_silent()
    seq_music_cabal_intro.stop()
    sleep(6)

# the Ghost on the base's first casualty (one run: the phalanx died first)
thread sc_base_arrive:
    sleep_until(sq_base_phalanx.alive_count() > 0)
    sleep_until(sq_base_phalanx.alive_count() == 0)
    seq_dialog_plains_base_arrive.start()

def base_alive_count():
    return sq_base_phalanx.alive_count() + sq_base_legionary_a.alive_count() + sq_base_legionary_b.alive_count() + sq_base_legionary_c.alive_count() + sq_backup_legionary_a.alive_count() + sq_backup_legionary_b.alive_count()

def sand_alive_count():
    return sq_anchor_centurion.alive_count() + sq_sand_legionary_a.alive_count() + sq_sand_legionary_b.alive_count() + sq_sand_legionary_c.alive_count()
