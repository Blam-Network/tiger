# es\mars\act_mars_m05_warbase\act_mars_m05_warbase_mission5.esp
#
# Mission 5, phase_6_gatehouse. The Ghost appears at the gatehouse and sends
# the player to the wall; reaching it springs the ambush (enc_gatehouse_m05's
# waves), which the player holds out against until the last wave is dead.
# Then the door button: using it opens the ambush door and lets the
# gatehouse encounter send its miniboss out behind the player. The climax
# trigger group is up from the wall objective to the door.

c_object_sensor_host o_m05_ghost
trigger_volume_objective pf_trigger_wall
c_trigger_group_host tg_mars_m5_gatehouse_climax_so
generic_objective pf_gen_obj_ambush
c_nav_point_host ap_gatehouse_wall
interactable_objective pf_objective_button_door bind("0x5B54C09C")
interactable_placement pf_placement_button_door bind("0x5B54C09C")
c_encounter_handle enc_gatehouse_m05
c_sequence_host seq_d_o2_s01
c_sequence_host seq_d_o2_s02
c_sequence_host seq_d_o2_s065
c_sequence_host seq_d_o2_s07

thread init: pass

thread complete: pass

thread main:
    enc = enc_gatehouse_m05
    o_m05_ghost.create()
    sleep(1)
    pf_trigger_wall.objective_begin()
    tg_mars_m5_gatehouse_climax_so.activate()
    seq_d_o2_s02.start()
    sleep_until(pf_trigger_wall.is_complete())
    sleep(1)
    pf_trigger_wall.objective_end_silent()
    seq_d_o2_s01.stop()
    seq_d_o2_s02.stop()
    pf_gen_obj_ambush.objective_begin(ap_gatehouse_wall)
    enc.sc_waves.wake()
    sleep_until(enc.ambush_complete)
    pf_gen_obj_ambush.objective_end_silent()
    sleep(0.7)
    pf_objective_button_door.objective_begin()
    seq_d_o2_s065.start()
    sleep_until(pf_objective_button_door.is_complete())
    sleep(2)
    seq_d_o2_s07.start()
    sleep(4)
    pf_objective_button_door.objective_end_silent()
    tg_mars_m5_gatehouse_climax_so.deactivate()
    enc.sc_miniboss.wake()
