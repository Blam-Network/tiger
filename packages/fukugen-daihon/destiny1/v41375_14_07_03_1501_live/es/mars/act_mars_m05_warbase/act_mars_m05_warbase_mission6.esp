# es\mars\act_mars_m05_warbase\act_mars_m05_warbase_mission6.esp
#
# Mission 6, phase_7_warbase_goto: out of the gatehouse and on to the
# warbase. The Ghost's line plays while the objective is up. Clears as a
# player enters the warbase's bubble.

location warbase
trigger_bubble_objective pf_objective_goto bind(warbase)
sequence seq_d_o3_s01

script init(): pass

script complete(): pass

script main():
    pf_objective_goto.objective_begin()
    seq_d_o3_s01.start()
    sleep_until(pf_objective_goto.is_complete())
    sleep(0.7)
    pf_objective_goto.objective_end_silent()
    seq_d_o3_s01.stop()
