# es\mars\act_mars_m05_warbase\act_mars_m05_warbase_mission9.esp
#
# Mission 9, phase_warbase_complete: the end. The ascent music plays, the
# Ghost's last line, and the activity ends half a minute later: the
# results come up with the completion, as retail's did.

sequence seq_music_ascent
sequence seq_d_o3_s12

script init(): pass

script complete(): pass

script main():
    seq_music_ascent.start()
    set_activity_complete()
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)
    sleep(1)
    seq_d_o3_s12.start()
