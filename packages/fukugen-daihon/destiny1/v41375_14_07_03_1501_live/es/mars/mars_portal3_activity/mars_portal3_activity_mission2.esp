# es\mars\mars_portal3_activity\mars_portal3_activity_mission2.esp
#
# Mission 2, the upper garden: get to its gate. The objective comes up with
# the phase and clears as a player reaches the gate's volume, which ends the
# phase. enc_uppergarden_portal3 holds the Vex on the stairs. One run.

@hard_wipe()
trigger_volume_objective pf_objective_gate

script init(): pass

script complete(): pass

script main():
    pf_objective_gate.objective_begin()
    sleep_until(pf_objective_gate.is_complete())
    pf_objective_gate.objective_end_silent()
