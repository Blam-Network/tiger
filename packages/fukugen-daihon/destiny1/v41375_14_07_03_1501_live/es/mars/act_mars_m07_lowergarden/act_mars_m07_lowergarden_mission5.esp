# es\mars\act_mars_m07_lowergarden\act_mars_m07_lowergarden_mission5.esp
#
# Mission 5, the lower garden: reach the arena, scan the two glyphs, scan
# the kiosk, then go through the door to the heart. The glyph objective has
# no archetype on TU0 (its rows are an object set), so this phase drives
# its rows itself: each glyph's activity flag is what lets the player use
# it, and goes down as that glyph is scanned; the objective clears with the
# second scan, in whichever order the player takes them. The lowergarden
# encounter runs the scans, the block, the key and the door; this phase
# follows what it makes. The door opens twenty-six seconds after the key
# appears (2026-10-26 run). The phase ends as the player reaches the heart's
# ledge.

@hard_wipe()
trigger_volume_objective sp_objective_goto
encounter_handle sp_objective_glyphs
activity_flag af_glyph_a bind("0x2D8F17DF")
activity_flag af_glyph_b bind("0xF348E09A")
countdown_objective sp_objective_kiosk bind("0xE2E80144")
trigger_volume_objective sp_objective_heart_goto
encounter_handle enc_lowergarden_m07
sequence seq_dialog_lowergarden_door_open
sequence seq_sound_lowergarden_darkness
sequence seq_music_garden_ambience

script init(): pass

script complete(): pass

script main():
    enc = enc_lowergarden_m07
    sp_objective_goto.objective_begin()
    sleep_until(sp_objective_goto.is_complete())
    sp_objective_goto.objective_end_silent()
    glyphs_begin()
    # each scan shows as that glyph's Ghost cage (the objective moves on the
    # same tick on the wire)
    sleep_until(enc.o_west_ghost_cage.is_alive() or enc.o_east_ghost_cage.is_alive())
    if enc.o_west_ghost_cage.is_alive():
        af_glyph_a.clear()
        sleep_until(enc.o_east_ghost_cage.is_alive())
    else:
        af_glyph_b.clear()
        sleep_until(enc.o_west_ghost_cage.is_alive())
    glyphs_end()
    # the hydra is down and the block comes up in front of the kiosk
    sleep_until(enc.o_block.is_alive())
    sleep(1)
    sp_objective_kiosk.objective_begin()
    sleep_until(enc.sp_specops_door.o_key.is_alive())
    sleep(1)
    sp_objective_kiosk.complete()
    sp_objective_kiosk.objective_end_silent()
    sleep(26)
    seq_dialog_lowergarden_door_open.start()
    seq_sound_lowergarden_darkness.start()
    sp_objective_heart_goto.objective_begin()
    sleep_until(sp_objective_heart_goto.is_complete())
    seq_music_garden_ambience.stop()
    sp_objective_heart_goto.objective_end_silent()

def glyphs_begin():
    po = sp_objective_glyphs._player_objective
    po.set_incoming()
    sleep(2)
    sp_objective_glyphs._incoming_sequence.start()
    sleep_until_timeout(sp_objective_glyphs._incoming_sequence.is_done(), 10)
    po.set_active()
    po.nav_point_activate(sp_objective_glyphs._nav_point)
    af_glyph_a.activate()
    af_glyph_b.activate()

def glyphs_end():
    af_glyph_a.clear()
    af_glyph_b.clear()
    sp_objective_glyphs._player_objective.nav_point_clear()
    sp_objective_glyphs._player_objective.clear()
