# es\mars\act_mars_m07_lowergarden\act_mars_m07_lowergarden_mission7.esp
#
# Mission 7, the hop down: the player comes back from the cinematic at the
# heart with Vex waiting below, all seven goblin squads placed as the
# player spawns, two of them holding the stair. A third joins the stair
# nine seconds in and another once one of the pair is down; when the other
# falls too, the stair is given up. The objective clears as the last of
# them dies, and the darkness phase follows ten seconds later. The door
# back closes behind the player. One run (2026-10-26) for the spacing; an
# earlier one brought the last two squads in late instead.

@hard_wipe()
generic_objective sp_objective_kill
encounter_handle enc_lowergarden_m07
sequence seq_music_lowergarden

script init(): pass

script complete(): pass

script main():
    # back from the cinematic: the lifetime is live again once the players are
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    enc = enc_lowergarden_m07
    seq_music_lowergarden.start()
    seq_music_lowergarden.set_switch_mask(1)
    enc.o_door_back.create()
    for sq in [enc.sq_minions_init_goblin_a, enc.sq_minions_init_goblin_b, enc.sq_minions_init_goblin_c, enc.sq_minions_init_goblin_d, enc.sq_minions_init_goblin_e]:
        place_on_task(sq, "0x07AA50F5")
    for sq in [enc.sq_minions_init_goblin_f, enc.sq_minions_init_goblin_g]:
        place_on_task(sq, "0x4E0EFB16")
    sp_objective_kill.objective_begin(nil)
    sc_stair.wake()
    sleep_until(init_goblins_alive_count() == 0)
    sleep(1)
    sp_objective_kill.objective_end_silent()
    sleep(10)

script sc_stair():
    enc = enc_lowergarden_m07
    sleep(9)
    enc.sq_minions_init_goblin_b.set_task("0x4E0EFB16")
    sleep_until(enc.sq_minions_init_goblin_f.alive_count() == 0 or enc.sq_minions_init_goblin_g.alive_count() == 0)
    sleep(4)
    enc.sq_minions_init_goblin_e.set_task("0x4E0EFB16")
    sleep_until(enc.sq_minions_init_goblin_f.alive_count() + enc.sq_minions_init_goblin_g.alive_count() == 0)
    for sq in [enc.sq_minions_init_goblin_b, enc.sq_minions_init_goblin_e]:
        sq.set_task("0x07AA50F5")

def init_goblins_alive_count():
    enc = enc_lowergarden_m07
    return enc.sq_minions_init_goblin_a.alive_count() + enc.sq_minions_init_goblin_b.alive_count() + enc.sq_minions_init_goblin_c.alive_count() + enc.sq_minions_init_goblin_d.alive_count() + enc.sq_minions_init_goblin_e.alive_count() + enc.sq_minions_init_goblin_f.alive_count() + enc.sq_minions_init_goblin_g.alive_count()

def place_on_task(sq, task):
    sq.set_task(task)
    sq.place()
