# es\mars\act_mars_m07_lowergarden\act_mars_m07_lowergarden_mission10.esp
#
# Mission 10, the outro: the dead heart's collar lights up and the
# spectacle plays, the Ghost has the last word, and the activity completes
# once a player stands on the ledge again. The ending cinematic is its own
# activity (cine_end). One run for the gaps.

c_encounter_handle enc_lowergarden_m07
c_sequence_host seq_sound_lowergarden_darkness
c_sequence_host seq_dialog_lowergarden_outro
c_sequence_host seq_music_outro

thread init: pass

thread complete:
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

thread main:
    heart = enc_lowergarden_m07.sp_specops_heart
    sleep(15)
    heart.o_collar_illum.set_device_position(1)
    heart.o_dumpling_control_notrans.set_device_position(0)
    heart.o_spectacle.set_device_position(1)
    seq_sound_lowergarden_darkness.stop()
    sleep(4)
    seq_dialog_lowergarden_outro.start()
    sleep_until(enc_lowergarden_m07.pm_ledge.test_any_inside())
    seq_music_outro.start()
    set_activity_complete()
