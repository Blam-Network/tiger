# es\mars\act_mars_m06_subway\act_mars_m06_subway_mission5.esp
#
# Mission 5, the lobby's north platform and pit. Clears when the player
# reaches the subway stairs on the far side.

trigger_volume_objective pf_objective_lobby_n_trigger

thread init: pass

thread complete: pass

thread main:
    pf_objective_lobby_n_trigger.objective_begin()
    sleep_until(pf_objective_lobby_n_trigger.is_complete())
    pf_objective_lobby_n_trigger.objective_end_silent()
