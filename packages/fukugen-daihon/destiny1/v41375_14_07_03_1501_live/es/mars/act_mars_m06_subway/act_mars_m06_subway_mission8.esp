# es\mars\act_mars_m06_subway\act_mars_m06_subway_mission8.esp
#
# Mission 8, the end: the Ghost scans the conflux. The pulse effect comes
# up with the objective at the phase start, the Ghost's second clear line
# as it goes active, the scan takes a few seconds once the player starts
# it, and the Vex block on the subway opens as the activity ends.
# One run (2026-11-01): the three seconds of the scan and the ten seconds
# after it are that run's.

object m06_subway_ghost_pulse
interactable_objective pf_objective_subway_interact bind("0xB0327A81")
interactable_placement pf_placement_subway_interact bind("0xB0327A81")
sequence seq_d_subway_clear_s02
object o_m06_subway_vexblock_a

script init(): pass

script complete():
    o_m06_subway_vexblock_a.set_device_position(0)
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    m06_subway_ghost_pulse.create()
    pf_objective_subway_interact.objective_begin()
    seq_d_subway_clear_s02.start()
    sleep_until(pf_objective_subway_interact.is_complete())
    # the scan itself: the conflux cracks open, then settles
    pf_placement_subway_interact._object.set_device_position(0.1)
    sleep(3)
    pf_placement_subway_interact._object.set_device_position(1)
    pf_objective_subway_interact.objective_end_silent()
    set_activity_complete()
    sleep(10)
