# es\mars\act_mars_m06_subway\act_mars_m06_subway_mission7.esp
#
# Mission 7, "Destroy the Warp Gates", then "Clear the Vex". The five gates
# and their squads belong to enc_subway_m06; the kill objective counts the
# gates, and the clear waits for the last Vex on the tracks. The clear's
# trigger volumes are declared for their rows; nothing on the wire used them.
# From one retail capture: the three seconds after the last kill are that
# run's.

trigger_volume tv_warpgate_destroy
trigger_volume tv_vex_clear
nav_point ap_subway_conflux
kill_squad_objective pf_objective_kill_warp_gates bind("0xF93FFC2A", 5)
generic_objective pf_objective_generic_clear
squad sq_plat_wide_support1
squad sq_plat_wide_support2
squad sq_plat_wide_support3
squad sq_plat_wide_support4
squad sq_plat_thin_support1
squad sq_plat_thin_support2
squad sq_warpgate1_support1
squad sq_warpgate1_support2
squad sq_warpgate1_support3
squad sq_warpgate1_support4
squad sq_warpgate2_support1
squad sq_warpgate2_support2
squad sq_warpgate2_support3
squad sq_warpgate2_support4
squad sq_warpgate3_anchor1
squad sq_warpgate3_support1
squad sq_warpgate3_support2
squad sq_warpgate4_major_anchor1
squad sq_warpgate4_support1
squad sq_warpgate4_support2
squad sq_warpgate5_anchor1
squad sq_warpgate5_support1
squad sq_warpgate5_support2

script init(): pass

script complete(): pass

script main():
    pf_objective_kill_warp_gates.objective_begin()
    sleep_until(pf_objective_kill_warp_gates.is_complete())
    pf_objective_kill_warp_gates.objective_end_silent()
    pf_objective_generic_clear.objective_begin(ap_subway_conflux)
    sleep_until(subway_alive_count() > 0)
    sleep_until(subway_alive_count() == 0)
    sleep(3)
    pf_objective_generic_clear.objective_end_silent()

def subway_alive_count():
    count = 0
    for sq in [sq_plat_wide_support1, sq_plat_wide_support2, sq_plat_wide_support3, sq_plat_wide_support4, sq_plat_thin_support1, sq_plat_thin_support2, sq_warpgate1_support1, sq_warpgate1_support2, sq_warpgate1_support3, sq_warpgate1_support4, sq_warpgate2_support1, sq_warpgate2_support2, sq_warpgate2_support3, sq_warpgate2_support4, sq_warpgate3_anchor1, sq_warpgate3_support1, sq_warpgate3_support2, sq_warpgate4_major_anchor1, sq_warpgate4_support1, sq_warpgate4_support2, sq_warpgate5_anchor1, sq_warpgate5_support1, sq_warpgate5_support2]:
        count = count + sq.alive_count()
    return count
