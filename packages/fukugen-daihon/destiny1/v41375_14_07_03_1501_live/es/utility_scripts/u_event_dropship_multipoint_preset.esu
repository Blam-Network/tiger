# es\utility_scripts\u_event_dropship_multipoint_preset.esu
#
# The glimmer drop's presentation (a pf_event_dropship_multipoint_fallen's
# pf_preset): the public event objective, the pre-engage volume around the
# first point, and the lines and music the event plays, each with a generic
# take. Bound as the Walker drop's preset binds its own: the specific takes
# to the objective, the generic ones left alone. Retail's dry sea run played
# the announce, the engage, the wave update and ending time lines, the gold
# ending and the music; the rest are declared for the endings no run has
# shown. The pre-engage trigger never moved in that run.

player_objective po_event_dropship_multipoint
trigger_volume tv_drill_pre_engage
player_trigger pt_drill_pre_engage bind(tv_drill_pre_engage)
sequence seq_intro_behavior
sequence seq_glimmer_announce bind(po_event_dropship_multipoint, e_sequence_suppression_behavior.postpone)
sequence seq_glimmer_announce_generic
sequence seq_glimmer_engage bind(po_event_dropship_multipoint, e_sequence_suppression_behavior.skip)
sequence seq_glimmer_engage_generic
sequence seq_glimmer_update_wave_generic
sequence seq_glimmer_ending_time_generic
sequence seq_glimmer_complete_gold bind(po_event_dropship_multipoint, e_sequence_suppression_behavior.skip)
sequence seq_glimmer_complete_gold_generic
sequence seq_glimmer_complete_silver bind(po_event_dropship_multipoint, e_sequence_suppression_behavior.skip)
sequence seq_glimmer_complete_silver_generic
sequence seq_glimmer_complete_bronze bind(po_event_dropship_multipoint, e_sequence_suppression_behavior.skip)
sequence seq_glimmer_complete_bronze_generic
sequence seq_glimmer_complete_failure bind(po_event_dropship_multipoint, e_sequence_suppression_behavior.skip)
sequence seq_glimmer_complete_failure_generic
sequence seq_glimmer_music1 bind(po_event_dropship_multipoint, e_sequence_suppression_behavior.postpone)
