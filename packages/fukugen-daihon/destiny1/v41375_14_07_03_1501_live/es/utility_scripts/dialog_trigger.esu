# es\utility_scripts\dialog_trigger.esu
#
# A line of dialogue that plays the first time a player enters a volume.

sequence _dialog_sequence
static_array<trigger_volume, 1> _trigger_volume
player_trigger _player_trigger

def import_only_bind(_player_objective, _suppression_behavior):
    _dialog_sequence.import_only_bind(_player_objective, _suppression_behavior)
    return true

def user_import():
    for volume in _trigger_volume:
        volume.import_only_clear_slice_set_assignment()
        _player_trigger.import_only_bind(volume)
    return true

script main():
    _player_trigger.reset()
    sleep_until(_player_trigger.is_triggered(), 0.5)
    _dialog_sequence.start()

def enable():
    main.restart()

def is_triggered():
    return _player_trigger.is_triggered()

def disable():
    main.kill()
