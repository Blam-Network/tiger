# es\utility_scripts\u_event_patrol_preset.esu
#
# The target patrol's presentation (pf_event_patrol's pf_preset): the public
# event objective and the lines and music it plays. Bound as the countdown's
# preset binds its own: the specific takes to the objective, the generic
# ones left alone. Retail's two Moon runs played the announce, the engage,
# one progress update, the ending progress, the gold ending and the music;
# the rest are declared for the endings no run has shown.

player_objective po_event_patrol
sequence seq_intro_behavior
sequence seq_patrol_announce bind(po_event_patrol, e_sequence_suppression_behavior.postpone)
sequence seq_patrol_engage
sequence seq_patrol_engage_generic
sequence seq_patrol_update_progress bind(po_event_patrol, e_sequence_suppression_behavior.skip)
sequence seq_patrol_ending_progress bind(po_event_patrol, e_sequence_suppression_behavior.skip)
sequence seq_patrol_complete_gold bind(po_event_patrol, e_sequence_suppression_behavior.skip)
sequence seq_patrol_complete_gold_generic
sequence seq_patrol_complete_silver bind(po_event_patrol, e_sequence_suppression_behavior.skip)
sequence seq_patrol_complete_silver_generic
sequence seq_patrol_complete_bronze bind(po_event_patrol, e_sequence_suppression_behavior.skip)
sequence seq_patrol_complete_bronze_generic
sequence seq_patrol_complete_failure bind(po_event_patrol, e_sequence_suppression_behavior.skip)
sequence seq_patrol_complete_failure_generic
sequence seq_patrol_music1 bind(po_event_patrol, e_sequence_suppression_behavior.postpone)
