# es\utility_scripts\countdown_placement.esu
#
# A placement the players capture by holding on it (Exclusion Zone's vent,
# garage control and checkpoint console). Ported from the alpha's; TU0's
# rows are the object and its filter, so the activity flag is the script's
# own, bound by the same identifier as the objective that points at it.

c_object_sensor_host _object
real _minimum_time_to_reset = 10
c_activity_flag _activity_flag
c_object_filter_sensor_host _object_filter
c_capturable_host _capturable bind(_object)

def import_only_bind(identifier):
    return _activity_flag.import_only_bind(identifier)

def is_captured():
    return _capturable.is_captured()

startup thread main:
    _object.create()
    _object_filter.add_players_with_activity_flag(_activity_flag)
    _capturable.set_filter(_object_filter)
    _capturable.lock()

    while true:
        _capturable.reset()
        while not _activity_flag.is_active():
            sleep(1)
        _capturable.unlock()
        while not _capturable.is_captured():
            sleep(1)
        _capturable.lock()
        sleep(_minimum_time_to_reset)
