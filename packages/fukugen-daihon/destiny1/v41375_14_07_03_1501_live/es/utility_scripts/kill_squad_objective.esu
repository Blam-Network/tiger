# es\utility_scripts\kill_squad_objective.esu
#
# A kill count objective: kill N of a squad, with a progress bar.

string_hash _identifier
int _count
encounter_binding _squad
kill_incident_listener _incident_listener
player_objective _player_objective
sequence _incoming_sequence
nav_point _nav_point
string_hash _any_kill_hash = "any_kill"
sequence _completion_sequence

def import_only_bind(identifier, count):
    _identifier = identifier
    _count = count
    return _squad.import_only_bind_object(identifier)

def get_count():
    return _incident_listener.get_count()

def is_complete():
    return _incident_listener.get_count() >= _count

def objective_begin():
    _player_objective.set_incoming()
    sleep(2)
    _incoming_sequence.start()
    sleep_until_timeout(_incoming_sequence.is_done(), 10)
    objective_begin_immediate()

def objective_begin_immediate():
    _player_objective.set_active()
    _player_objective.nav_point_activate_with_fallback(_squad, _nav_point)
    _player_objective.progress_activate(0, _count)
    progress_watcher.restart()
    objective_begin_silent()

def objective_begin_silent():
    _incident_listener.reset()
    _incident_listener.bind_squad_identifier(_identifier)
    _incident_listener.bind_incident_name_hash(_any_kill_hash)

script progress_watcher():
    while _player_objective.is_active() and not _player_objective.progress_is_complete():
        _player_objective.progress_update(_incident_listener.get_count())
        sleep(1)

def objective_end():
    _player_objective.nav_point_clear()
    _completion_sequence.start()
    sleep_until_timeout(_completion_sequence.is_done(), 10)
    _player_objective.set_complete()
    sleep(2)
    _player_objective.clear()

def objective_end_silent():
    _player_objective.clear()
