# es\venus\act_venus_m06_ketch\act_venus_m06_ketch_mission5.esp
#
# Mission 5, the outro. In the same frame the ketch music stops, the
# Ghost's last line and the ascent music start and the activity completes;
# the results come up 30 seconds on. One run: unconfirmed.

sequence venus_m06_music_cue2
sequence md_vn06_020_60
sequence venus_m06_music_ascent

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    venus_m06_music_cue2.stop()
    md_vn06_020_60.start()
    venus_m06_music_ascent.start()
    set_activity_complete()
