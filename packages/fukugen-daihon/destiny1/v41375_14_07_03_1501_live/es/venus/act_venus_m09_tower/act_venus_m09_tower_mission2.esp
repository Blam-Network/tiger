# es\venus\act_venus_m09_tower\act_venus_m09_tower_mission2.esp
#
# Mission 2, phase_lower_tower_elevator: start the lift up the tower. The
# lift's controls are the lower tower's placement, usable only while the
# objective's flag is up. Using them wakes the lift but the Fallen shield it,
# lock the bridge behind the players and send their vanguard: the anchor
# captain, the blade vandals and two shank packs (enc_lower_tower_m09's
# sc_vanguard). The lift runs once the vanguard is dead.

@hard_wipe()
interactable_objective pf_tower_elevator bind("tower_elevator")
generic_objective pf_eliminate_vanguard
nav_point ap_kill_fallen
# the vanguard's ground in front of the lift
trigger_volume tv_kill_fallen
object invisible_device_networked
encounter_handle enc_lower_tower_m09
sequence venus_m09_intro_music
sequence md_vn09_010_50
sequence md_vn09_010_60
sequence md_vn09_010_70
sequence md_vn09_010_80
sequence md_vn09_010_90

script init(): pass

script complete(): pass

script main():
    enc = enc_lower_tower_m09
    pf_tower_elevator.objective_begin()
    md_vn09_010_50.start()
    sleep_until(pf_tower_elevator.is_complete())
    md_vn09_010_50.stop()
    pf_tower_elevator.objective_end_silent()

    # the lift wakes and the Fallen answer
    invisible_device_networked.create()
    invisible_device_networked.set_device_position(0)
    md_vn09_010_60.start()
    enc.sc_vanguard.wake()
    venus_m09_intro_music.set_switch_mask(3)
    sleep(3)
    pf_eliminate_vanguard.objective_begin(ap_kill_fallen)
    md_vn09_010_70.start()
    sleep_until(enc.reinforced)
    md_vn09_010_80.start()
    sleep_until(enc.vanguard_cleared)
    sleep(1)
    pf_eliminate_vanguard.objective_end()
    venus_m09_intro_music.set_switch_mask(1)

    # the shield is down: the lift runs
    invisible_device_networked.set_device_position(1)
    md_vn09_010_90.start()
    sleep(2)
