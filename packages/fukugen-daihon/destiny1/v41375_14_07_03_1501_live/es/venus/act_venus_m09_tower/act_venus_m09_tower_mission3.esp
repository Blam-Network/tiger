# es\venus\act_venus_m09_tower\act_venus_m09_tower_mission3.esp
#
# Mission 3, phase_tower_find_boss: ride the lift up into the Terminus, then
# find the Fallen captain. The way up clears at the top of the lift; the hunt
# waits until nobody is left in the lower tower (or half a minute), then
# clears as a player reaches the captain's platform. The Fallen on the way are
# enc_tower_m09's.

@hard_wipe()
trigger_volume_objective pf_ascend_tower
trigger_volume_objective pf_find_boss
location lower_tower
player_monitor pm_lower_tower bind(lower_tower)
sequence md_vn09_020_10
sequence md_vn09_020_20
sequence md_vn09_020_40

script init(): pass

script complete(): pass

script main():
    pf_ascend_tower.objective_begin()
    md_vn09_020_10.start()
    sleep_until(pf_ascend_tower.is_complete())
    md_vn09_020_20.start()
    pf_ascend_tower.objective_end()

    # the fireteam regroups at the top
    sleep_until_timeout(not pm_lower_tower.test_any_inside(), 30)
    pf_find_boss.objective_begin()
    md_vn09_020_40.start()
    sleep_until(pf_find_boss.is_complete())
    sleep(1)
    pf_find_boss.objective_end_silent()
