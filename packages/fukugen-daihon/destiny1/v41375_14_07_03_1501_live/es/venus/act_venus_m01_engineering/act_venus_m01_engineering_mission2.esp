# es\venus\act_venus_m01_engineering\act_venus_m01_engineering_mission2.esp
#
# Mission 2, the Shattered Coast: the Ghost scans two sensors. The player
# uses each one; the Ghost's line follows and the objective goes when it is
# over. The first sensor's objective just goes, the second's completes. A
# trigger on the way to the second sensor plays the Ghost's nag. The lines
# live in unknown_529d4bdc's bundle.

interactable_objective pf_sensor01 bind("sensor01")
interactable_objective pf_sensor02 bind("sensor02")
nav_point ap_shattered
sequence md_vn01_010_60
player_trigger pt_vn01_010_70
sequence md_vn01_010_70
sequence md_vn01_010_80
sequence md_vn01_010_90

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    # retail brings the objective in 1.8 s after the spawn and sets it active
    # ten seconds later (a stage TU0 has no verb for); it starts active here
    sleep(11)
    pf_sensor01.objective_begin_immediate()
    sleep_until(pf_sensor01.is_complete())
    md_vn01_010_60.start()
    sleep_until(md_vn01_010_60.is_done())
    pf_sensor01.objective_end_silent()
    sc_second_sensor_nag.wake()
    pf_sensor02.objective_begin()
    sleep_until(pf_sensor02.is_complete())
    md_vn01_010_80.start()
    sleep_until(md_vn01_010_80.is_done())
    pf_sensor02.objective_end()
    sleep(1)
    md_vn01_010_90.start()
    sleep_until(md_vn01_010_90.is_done())

# the trigger is armed with the second sensor's objective
script sc_second_sensor_nag():
    pt_vn01_010_70.enable()
    sleep_until(pt_vn01_010_70.is_triggered())
    md_vn01_010_70.start()
