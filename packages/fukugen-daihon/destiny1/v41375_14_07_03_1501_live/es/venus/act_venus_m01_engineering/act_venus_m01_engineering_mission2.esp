# es\venus\act_venus_m01_engineering\act_venus_m01_engineering_mission2.esp
#
# Mission 2, the Shattered Coast: the Ghost scans two sensors. Each scan ends
# with a Ghost line; the way to the second sensor is nagged after twenty
# seconds. The lines live in unknown_529d4bdc's bundle.

countdown_objective pf_sensor01
countdown_objective pf_sensor02
nav_point ap_shattered
sequence md_vn01_010_60
player_trigger pt_vn01_010_70
sequence md_vn01_010_70
sequence md_vn01_010_80
sequence md_vn01_010_90

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    sleep(1)
    pf_sensor01.objective_begin()
    # the scan runs its course; nothing on the wire ends it (single run)
    sleep(54)
    pf_sensor01.complete()
    venus_m01_010_d60.wake()
    sleep_until(md_vn01_010_60.is_done())
    pf_sensor01.objective_end_silent()
    pf_sensor02.objective_begin()
    venus_m01_010_d70.wake()
    sleep(40)
    pf_sensor02.complete()
    venus_m01_010_d80.wake()
    sleep_until(md_vn01_010_80.is_done())
    pf_sensor02.objective_end()
    venus_m01_010_d90.wake()
    sleep_until(md_vn01_010_90.is_done())

script venus_m01_010_d60():
    md_vn01_010_60.start()
    print("md_vn01_010_60")

# the nag on the way to the second sensor
script venus_m01_010_d70():
    pt_vn01_010_70.enable()
    sleep_until_timeout(pt_vn01_010_70.is_triggered(), 20)
    md_vn01_010_70.start()
    print("md_vn01_010_70")

script venus_m01_010_d80():
    md_vn01_010_80.start()
    print("md_vn01_010_80")

script venus_m01_010_d90():
    md_vn01_010_90.start()
    print("md_vn01_010_90")
