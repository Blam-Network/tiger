# es\venus\act_venus_m01_engineering\act_venus_m01_engineering_mission5.esp
#
# Mission 5, hold the entrance: three defensive waves out of the Vex clouds,
# each once the last is dead. Completes when the entrance is quiet; the music
# steps up on the last wave and again at the end, then the Ghost sends the
# player on.

@hard_wipe()
generic_objective pf_resist_vex
trigger_volume tv_resist_vex
nav_point ap_resist_vex
encounter_handle enc_entrance_m01
sequence venus_m01_music_cue1
sequence md_vn01_020_100

script init(): pass

script complete(): pass

script main():
    pf_resist_vex.objective_begin_immediate(ap_resist_vex)
    enc_entrance_m01.sc_resist.wake()
    sc_last_wave_music.wake()
    sleep_until(enc_entrance_m01.entrance_clear == true)
    sleep(1)
    pf_resist_vex.objective_end()
    sleep(1)
    venus_m01_music_cue1.set_switch_mask(31)
    sleep(5)
    md_vn01_020_100.start()
    sleep_until(md_vn01_020_100.is_done())

script sc_last_wave_music():
    sleep_until(enc_entrance_m01.i_resist_wave >= 3)
    venus_m01_music_cue1.set_switch_mask(15)
