# es\venus\act_venus_m01_engineering\act_venus_m01_engineering_mission4.esp
#
# Mission 4, the Vex conflux: hack it, then kill the Vex it calls out of the
# clouds. The kill objective stays up through the next mission's waves; its own
# thread clears it once the entrance is quiet.

@hard_wipe()
countdown_objective pf_vex_block bind("vex_block")
interactable_incident_listener il_vex_block
generic_objective pf_kill_vex
trigger_volume tv_kill_vex
nav_point ap_kill_vex
encounter_handle enc_entrance_m01
sequence venus_m01_music_cue1
sequence md_vn01_020_60
sequence md_vn01_020_70

script init(): pass

script complete(): pass

script main():
    pf_vex_block.objective_begin()
    il_vex_block.import_only_bind(pf_vex_block._object.import_identifier())
    sleep_until(il_vex_block.get_count() > 0)
    pf_vex_block.complete()
    venus_m01_020_d60.wake()
    sleep_until(md_vn01_020_60.is_done())
    pf_vex_block.objective_end_silent()
    venus_m01_020_d70.wake()
    venus_m01_music_cue1.set_switch_mask(7)
    enc_entrance_m01.sc_conflux_hacked.wake()
    sleep_until(md_vn01_020_70.is_done())
    pf_kill_vex.objective_begin(ap_kill_vex)
    sleep_until(enc_entrance_m01.conflux_clear == true)
    insertion_point()
    sc_kill_vex_end.wake()

script sc_kill_vex_end():
    sleep_until(enc_entrance_m01.entrance_clear == true)
    pf_kill_vex.objective_end_silent()

script venus_m01_020_d60():
    md_vn01_020_60.start()
    print("md_vn01_020_60")

script venus_m01_020_d70():
    md_vn01_020_70.start()
    print("md_vn01_020_70")
