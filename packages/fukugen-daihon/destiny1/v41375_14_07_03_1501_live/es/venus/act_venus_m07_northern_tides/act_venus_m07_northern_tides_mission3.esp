# es\venus\act_venus_m07_northern_tides\act_venus_m07_northern_tides_mission3.esp
#
# Mission 3, "ascend the steps": climb the northern tides to the top of the
# stairs. The music's second cue starts with the phase; the hill's Vex are
# enc_north_tides_m07's. The Ghost's line at the top plays as the objective
# clears.

generic_objective pf_ascend_steps
c_nav_point_host ap_northern_tides
c_trigger_volume_slot_host tv_top_stairs
c_player_trigger_sensor_host pt_top_stairs bind(tv_top_stairs)
c_sequence_host venus_m07_music_cue2
c_sequence_host md_vn07_020_100

thread init: pass

thread complete: pass

thread main:
    venus_m07_music_cue2.start()
    venus_m07_music_cue2.set_switch_mask(1)
    pf_ascend_steps.objective_begin(ap_northern_tides)
    sleep_until(pt_top_stairs.is_triggered())
    pf_ascend_steps.objective_end()
    md_vn07_020_100.start()
