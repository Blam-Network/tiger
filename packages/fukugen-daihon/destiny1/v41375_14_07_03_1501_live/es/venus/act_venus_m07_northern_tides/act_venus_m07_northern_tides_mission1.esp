# es\venus\act_venus_m07_northern_tides\act_venus_m07_northern_tides_mission1.esp
#
# Mission 1, the complex: scan the Vex node. The objective comes up once the
# player is in, and its flag is what lets them use the node (the node itself
# is the complex ambient's placement). The Ghost's two lines run while the
# objective is up. When the player uses the node they stop, the third line
# (md_vn07_010_40) plays as the objective's completion sequence and the last
# one follows when the objective clears. One run: unconfirmed, and the scan
# took 62 s there, so a nag for a slow player may exist that we never saw.

countdown_objective pf_vex_node01
sequence md_vn07_010_25
sequence md_vn07_010_30
sequence md_vn07_010_40
sequence md_vn07_010_50

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep(2)
    pf_vex_node01.objective_begin()
    md_vn07_010_25.start()
    md_vn07_010_30.start()
    sleep_until(pf_vex_node01._object.get_active())
    md_vn07_010_25.stop()
    md_vn07_010_30.stop()
    md_vn07_010_40.start()
    pf_vex_node01.complete()
    pf_vex_node01.objective_end()
    md_vn07_010_50.start()
    sleep(5)
