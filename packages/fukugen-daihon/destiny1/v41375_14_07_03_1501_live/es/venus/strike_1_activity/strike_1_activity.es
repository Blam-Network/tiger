# es\venus\strike_1_activity\strike_1_activity.es
#
# Venus strike 1 (the academy strike). The root starts nothing; the phases
# are the missions beside it, run in order.
#
#   venus_strike_1_mission1.esp  clear the engineering floor
#   venus_strike_1_mission2.esp  on to the dig site
#   venus_strike_1_mission3.esp  cross the dig site
#   venus_strike_1_mission4.esp  the ruins and the boss
#   venus_strike_1_mission5.esp  end of the strike

startup thread ss_venus_strike1:
    print("script startup")
