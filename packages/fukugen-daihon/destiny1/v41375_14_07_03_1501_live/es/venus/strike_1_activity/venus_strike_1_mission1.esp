# es\venus\strike_1_activity\venus_strike_1_mission1.esp
#
# Mission 1, engineering: get onto the floor, then kill the servitors the
# Fallen bring in room by room. The last one opens the portal end door
# (a device, not a deleted object) and wakes the top floor's trash.
#
# The rooms come in the alpha's shape (a lead squad, then its servitor a few
# seconds later, then reinforcements), with each squad's task from the run.
# One run: the floor sent the big room then the corner room and three
# servitors ended it, so the small room (formation 1) is kept but not called.
# The run also re-sent fallen07/08 twice more between their spawns, on a
# rule the wire does not show.
#
# Replay against The Nexus#1 stalls in this file, and the cause is the host,
# not the waits: the kill count's squad identifier does not resolve, the
# alive counts of the task-spawned squads read low, so the room waits fire
# early (the big room 11 s early) or never (the corner room's last wait),
# and the servitor kills never reach three. Every later phase (and its
# audio) then goes missing. The waits are the run's, left as they are.

objective obj_engineering_strike_phase
object o_portal_end_door
squad_group gr_floor1
squad sq_floor1_fallen01
squad sq_floor1_fallen02
squad_group gr_floor2
squad sq_floor1_fallen03
squad sq_floor1_fallen04
squad_group gr_floor3
squad sq_floor1_fallen05
squad sq_floor1_fallen06
squad_group gr_floor4
squad sq_floor1_fallen07
squad sq_floor1_fallen08
squad_group gr_obj2
squad sq_floor1_fallen04a
squad_group gr_obj3
squad sq_floor1_fallen06a
squad_group gr_obj4
squad sq_floor1_fallen08a
squad_group gr_obj1
squad sq_objective01
squad sq_objective02
squad sq_objective03
squad sq_objective04
squad sq_objective05
squad sq_objective06
squad sq_objective07
squad sq_objective08
squad_group gr_objective
squad_group gr_all
location engineering
trigger_volume tv_engineering_entrance01
player_trigger pt_engineering_entrance01 bind(tv_engineering_entrance01)
encounter_handle enc_engineering_strike1
bool objective_complete
trigger_bubble_objective engineering_bubble_objective bind(engineering)
kill_squad_objective kill_squad_engineering bind("strike_kill_servitors", 3)

script init():
    o_portal_end_door.create()
    o_portal_end_door.set_device_position(0)

script complete(): pass

script main():
    gr_floor1.add_child(sq_floor1_fallen01)
    gr_floor1.add_child(sq_floor1_fallen02)
    gr_floor2.add_child(sq_floor1_fallen03)
    gr_floor2.add_child(sq_floor1_fallen04)
    gr_floor3.add_child(sq_floor1_fallen05)
    gr_floor3.add_child(sq_floor1_fallen06)
    gr_floor4.add_child(sq_floor1_fallen07)
    gr_floor4.add_child(sq_floor1_fallen08)
    gr_obj2.add_child(sq_floor1_fallen04a)
    gr_obj3.add_child(sq_floor1_fallen06a)
    gr_obj4.add_child(sq_floor1_fallen08a)
    gr_obj1.add_child(sq_objective01)
    gr_obj1.add_child(sq_objective02)
    gr_obj2.add_child(sq_objective03)
    gr_obj2.add_child(sq_objective04)
    gr_obj3.add_child(sq_objective05)
    gr_obj3.add_child(sq_objective06)
    gr_obj4.add_child(sq_objective07)
    gr_obj4.add_child(sq_objective08)
    gr_objective.add_child(gr_obj1)
    gr_objective.add_child(gr_obj2)
    gr_objective.add_child(gr_obj3)
    gr_objective.add_child(gr_obj4)
    gr_all.add_child(gr_floor1)
    gr_all.add_child(gr_floor2)
    gr_all.add_child(gr_floor3)
    gr_all.add_child(gr_floor4)
    for sq in [sq_floor1_fallen01, sq_floor1_fallen02, sq_floor1_fallen03, sq_floor1_fallen04, sq_floor1_fallen04a, sq_floor1_fallen05, sq_floor1_fallen06, sq_floor1_fallen06a, sq_floor1_fallen07, sq_floor1_fallen08, sq_floor1_fallen08a]:
        sq.set_objective(obj_engineering_strike_phase)
    for sq in [sq_objective01, sq_objective02, sq_objective03, sq_objective04, sq_objective05, sq_objective06, sq_objective07, sq_objective08]:
        sq.set_objective(obj_engineering_strike_phase)
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    engineering_bubble_objective.objective_begin()
    sleep_until(engineering_bubble_objective.is_complete())
    engineering_bubble_objective.objective_end_silent()
    kill_squad_engineering.objective_begin()
    sc_encounter_engineering.wake()
    sleep_until(kill_squad_engineering.is_complete())
    kill_squad_engineering.objective_end_silent()
    o_portal_end_door.set_device_position(1)
    enc_engineering_strike1.sc_engineering_trash.wake()

script sc_encounter_engineering():
    floor_encounter()
    formation(3)
    formation(2)
    objective_complete = true

def formation(rand_int):
    if rand_int == 1:
        # never reached in the run: tasks guessed from the other rooms
        print("From the SMALL Room")
        floor_spawn(sq_floor1_fallen03, "0xB9200D24", sq_floor1_fallen04, "0xB9200D24")
        sleep(5)
        floor_spawn(sq_floor1_fallen04a, "objective_2", sq_objective04, "objective_2")
        sleep_until(gr_floor2.alive_count() <= 3)
        if sq_objective04.alive_count() > 0:
            floor_spawn(sq_floor1_fallen03, "0xB9200D24", sq_floor1_fallen04, "0xB9200D24")
        sleep_until(gr_floor2.alive_count() <= 4 and sq_objective04.alive_count() < 1)
    if rand_int == 2:
        print("From the CORNER Room")
        floor_spawn(sq_floor1_fallen05, "0xB9200D24", sq_objective05, "objective05")
        sleep(5)
        floor_spawn(sq_floor1_fallen06a, "0xB9200D24", sq_objective06, "objective06")
        sleep_until(gr_floor3.alive_count() <= 3)
        if sq_objective06.alive_count() > 0 and sq_objective05.alive_count() > 0:
            floor_spawn(sq_floor1_fallen05, "0xB9200D24", sq_floor1_fallen06, "0xB9200D24")
        sleep_until(gr_floor3.alive_count() <= 4 and sq_objective06.alive_count() < 1 and sq_objective05.alive_count() < 1)
    if rand_int == 3:
        print("From the Big Room")
        floor_spawn(sq_floor1_fallen07, "0xB9200D21", sq_floor1_fallen08, "0xB9200D24")
        sleep(5)
        floor_spawn(sq_floor1_fallen08a, "objective_4", sq_objective07, "objective_4")
        sleep_until(gr_floor4.alive_count() <= 3)
        if sq_objective07.alive_count() > 0:
            floor_spawn(sq_floor1_fallen07, "0xB9200D24", sq_floor1_fallen08, "0xB9200D21")
        sleep_until(gr_floor4.alive_count() <= 4 and sq_objective07.alive_count() < 1)

def floor_encounter():
    floor_spawn(sq_floor1_fallen01, "0xB9200D24", sq_floor1_fallen02, "0xB9200D24")
    sleep_until(gr_floor1.alive_count() <= 3)

def floor_spawn(sq1, task1, sq2, task2):
    sq1.set_task(task1)
    sq1.respawn()
    sleep(mathlib.random_int_inclusive(3, 6))
    sq2.set_task(task2)
    sq2.respawn()
