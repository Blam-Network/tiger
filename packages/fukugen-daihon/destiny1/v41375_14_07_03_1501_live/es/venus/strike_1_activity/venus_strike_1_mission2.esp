# es\venus\strike_1_activity\venus_strike_1_mission2.esp
#
# Mission 2: leave engineering for the dig site. The waypoint points at the
# dig site and the objective clears, silently, when a player gets there.

generic_objective obj_generic_engineering
nav_point ap_dig_site
location dig_site
player_monitor pm_bubble_dig_site bind(dig_site)

script init(): pass

script complete(): pass

script main():
    obj_generic_engineering.objective_begin(ap_dig_site)
    sleep_until(pm_bubble_dig_site.get_count() > 0)
    obj_generic_engineering.objective_end_silent()
