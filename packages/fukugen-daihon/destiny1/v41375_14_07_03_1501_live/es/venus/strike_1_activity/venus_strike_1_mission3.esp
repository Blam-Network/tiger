# es\venus\strike_1_activity\venus_strike_1_mission3.esp
#
# Mission 3, the dig site: cross it to the far trigger volume. The dig site
# encounter runs its own Fallen.

trigger_volume_objective trigger_volume_dig_site

script init(): pass

script complete(): pass

script main():
    trigger_volume_dig_site.objective_begin_immediate()
    sleep_until(trigger_volume_dig_site.is_complete())
    trigger_volume_dig_site.objective_end_silent()
