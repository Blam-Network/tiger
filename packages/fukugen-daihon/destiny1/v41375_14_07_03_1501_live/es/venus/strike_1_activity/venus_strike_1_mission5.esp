# es\venus\strike_1_activity\venus_strike_1_mission5.esp
#
# Mission 5, the end: the closing lines play, the music gives way to the
# ascent, the strike completes and the game ends after the results.

c_sequence_host md_s1_m4_d010
c_sequence_host md_s1_m4_d020
c_sequence_host ascent
c_sequence_host music01

thread init: pass

thread complete:
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

thread main:
    sleep(3)
    md_s1_m4_d010.start()
    print("md_s1_m4_d010")
    sleep_until_timeout(md_s1_m4_d010.is_done(), 10)
    md_s1_m4_d020.start()
    print("md_s1_m4_d020")
    ascent.start()
    music01.stop()
    set_activity_complete()
