# es\venus\strike_1_activity\venus_strike_1_mission5.esp
#
# Mission 5, the end: the closing lines play, then the activity ends.

c_sequence_host md_s1_m4_d010  # true name unknown
c_sequence_host md_s1_m4_d020  # true name unknown

thread init: pass

thread complete:
    c_lifetime_script_utilities.get_lifetime_sensor().end_game()

thread main:
    md_s1_m4_d010.start()
    print("md_s1_m4_d010")
    sleep_until_timeout(md_s1_m4_d010.is_done(), 30)
    md_s1_m4_d020.start()
    print("md_s1_m4_d020")
    sleep_until_timeout(md_s1_m4_d020.is_done(), 30)
