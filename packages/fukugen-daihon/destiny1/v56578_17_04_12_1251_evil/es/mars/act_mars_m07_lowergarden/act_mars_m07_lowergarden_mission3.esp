# es\mars\act_mars_m07_lowergarden\act_mars_m07_lowergarden_mission3.esp
#
# Mission 3, the catacombs: find the way through to the upper garden. The
# objective clears when a player reaches the upper garden's bubble. The
# Vex in the halls belong to the catacombs encounter.

location catacombs
trigger_bubble_objective sp_objective_goto bind(catacombs)
sequence seq_dialog_catacombs_wander
sequence seq_dialog_catacombs_statues
sequence seq_dialog_uppergarden_ledge
sequence seq_music_garden
sequence seq_dialog_uppergarden_kill

script init(): pass

script complete(): pass

script main():
    seq_dialog_catacombs_wander.start()
    seq_dialog_catacombs_statues.start()
    seq_dialog_uppergarden_ledge.start()
    sp_objective_goto.objective_begin()
    sleep_until(sp_objective_goto.is_complete())
    seq_music_garden.set_switch_mask(7)
    seq_dialog_uppergarden_kill.start()
    sp_objective_goto.objective_end_silent()
