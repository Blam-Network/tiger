# es\mars\act_mars_m05_warbase\act_mars_m05_warbase_mission8.esp
#
# Mission 8, phase_8_warbase: the spire. The warbase music starts with the
# phase. Button B opens the Minotaur eye's cage: the cage comes up, opens
# and goes away as the eye is taken (the eye, the laser, the Vex pillar and
# the Garden key are unknown_f305afe6's). The boss comes out once the pillar
# has gone; killing it is the next objective. Then button C: the cage comes
# up again as the key is taken, and the mission is complete. The second
# climax trigger group is up for the phase.

@hard_wipe()
trigger_group tg_mars_m5_climax_2_so
interactable_objective pf_objective_button_b bind("0x0882B95D")
interactable_placement pf_placement_button_b bind("0x0882B95D")
object o_minoeye_cage
kill_squad_objective pf_kill_boss bind("0xF6457E44", 1)
squad sq_boss
interactable_objective pf_objective_button_c bind("0x0882B95C")
interactable_placement pf_placement_button_c bind("0x0882B95C")
sequence seq_music_warbase
sequence seq_d_o3_s07
sequence seq_d_o3_s08

script init(): pass

script complete(): pass

script main():
    tg_mars_m5_climax_2_so.activate()
    seq_music_warbase.start()
    seq_music_warbase.set_switch_mask(1)
    sleep(2.2)
    seq_d_o3_s07.start()
    sleep(4)
    pf_objective_button_b.objective_begin()
    sleep_until(pf_objective_button_b.is_complete())
    sleep(1)
    o_minoeye_cage.create()
    seq_music_warbase.set_switch_mask(3)
    sleep(3)
    seq_d_o3_s08.start()
    sleep(1)
    o_minoeye_cage.set_device_position(1)
    sleep(0.9)
    o_minoeye_cage.delete_object()
    sleep(5.8)
    pf_objective_button_b.objective_end_silent()

    # the boss
    sleep_until(sq_boss.alive_count() > 0)
    sleep(1)
    pf_kill_boss.objective_begin()
    sleep_until(pf_kill_boss.is_complete())
    sleep(2)
    pf_kill_boss.objective_end_silent()
    seq_music_warbase.stop()
    seq_music_warbase.set_switch_mask(7)

    # the Garden key
    sleep(3)
    pf_objective_button_c.objective_begin()
    sleep_until(pf_objective_button_c.is_complete())
    sleep(1)
    o_minoeye_cage.create()
    sleep(1)
    o_minoeye_cage.delete_object()
    sleep(5)
    tg_mars_m5_climax_2_so.deactivate()
    sleep(2)
    pf_objective_button_c.objective_end_silent()
