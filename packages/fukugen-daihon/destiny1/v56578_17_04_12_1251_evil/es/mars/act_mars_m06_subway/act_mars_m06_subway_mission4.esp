# es\mars\act_mars_m06_subway\act_mars_m06_subway_mission4.esp
#
# Mission 4, the lobby's south hall. Clears when the player reaches the
# far end of the hall, past the Vex clouds.

trigger_volume_objective pf_objective_lobby_s_trigger

script init(): pass

script complete(): pass

script main():
    pf_objective_lobby_s_trigger.objective_begin()
    sleep_until(pf_objective_lobby_s_trigger.is_complete())
    pf_objective_lobby_s_trigger.objective_end_silent()
