# es\mars\act_mars_m06_subway\act_mars_m06_subway_mission6.esp
#
# Mission 6, "Go to the Subway". Clears when the player is down on the
# tracks at the first warp gate. The subway bubble's monitor is declared
# for its row; the objective's own trigger does the work. The Vex block
# sealing the subway shows up with this phase, shut (device 1); the last
# phase opens it.

c_object_sensor_host o_m06_subway_vexblock_a
c_location_sensor_host subway
c_player_monitor_sensor_host pm_subway_bubble bind(subway)
trigger_volume_objective pf_objective_subway_goto

thread init: pass

thread complete: pass

thread main:
    o_m06_subway_vexblock_a.create()
    o_m06_subway_vexblock_a.set_device_position(1)
    pf_objective_subway_goto.objective_begin()
    sleep_until(pf_objective_subway_goto.is_complete())
    pf_objective_subway_goto.objective_end_silent()
