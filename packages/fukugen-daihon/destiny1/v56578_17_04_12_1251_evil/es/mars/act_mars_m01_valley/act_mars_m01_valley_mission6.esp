# es\mars\act_mars_m01_valley\act_mars_m01_valley_mission6.esp
#
# Mission 6, the valley: reach the overlook and use the Cabal monitor, then
# the outro. The gate and overlook lines are started together and play off
# their own volumes; the valley music comes in near the overlook.
#
# One run, and the capture changed hosts on the way into the valley: no
# trigger or interaction reached the capture there, so the overlook trigger
# and the monitor's completion are the shape of the phase, not wire facts.
# The waits after the monitor are the gaps on the wire.

interactable_objective sp_objective_monitor bind("0xBD366786")
interactable_placement scp_placement_monitor bind("0xBD366786")
trigger_volume tv_overlook_near
player_trigger pt_overlook_near bind(tv_overlook_near)
sequence seq_dialog_checkpoint_loot_complete
sequence seq_dialog_valley_gate_near
sequence seq_dialog_valley_overlook
sequence seq_music_valley
sequence seq_dialog_valley_monitor_complete
sequence seq_music_outro
sequence seq_dialog_valley_outro

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    insertion_point()
    seq_dialog_checkpoint_loot_complete.start()
    seq_dialog_valley_gate_near.start()
    seq_dialog_valley_overlook.start()
    pt_overlook_near.reset()
    sc_overlook_music.wake()
    sp_objective_monitor.objective_begin()
    sleep(75)
    sp_objective_monitor.objective_end_silent()
    seq_dialog_valley_overlook.stop()
    seq_dialog_valley_monitor_complete.start()
    sleep(4)
    seq_dialog_valley_gate_near.stop()
    sleep(1)
    seq_music_valley.stop()
    sleep(10)
    set_activity_complete()
    seq_music_outro.start()
    seq_dialog_valley_outro.start()

script sc_overlook_music():
    sleep_until(pt_overlook_near.is_triggered())
    seq_music_valley.start()
    seq_music_valley.set_switch_mask(1)
