# es\mars\act_mars_m01_valley\act_mars_m01_valley_mission2.esp
#
# Mission 2, the plains: open the vent into the Cabal base, then use the
# garage control. The vent objective comes up once the player is past the
# dunes; the control objective follows the vent at once. The Ghost's lines
# for the objectives play here; the ones on the triggers are in
# unknown_11b7a83e. The base's doors and alarm belong to enc_plains_m01.
#
# One run: the 3 s hold after the control is the gap to the next phase on
# the wire, nothing more. Retail showed the vent objective in a state TU0
# has no verb for (wire 1) from the spawn until the dunes.

c_trigger_volume_slot_host tv_dunes
c_player_trigger_sensor_host pt_dunes bind(tv_dunes)
interactable_objective sp_objective_vent bind("0x5F62CC37")
interactable_objective sp_objective_control bind("0x8ED9F019")
c_sequence_host seq_music_cabal_intro
c_sequence_host seq_dialog_plains_vent_complete
c_sequence_host seq_dialog_plains_control_complete

thread init: pass

thread complete: pass

thread main:
    insertion_point()
    sleep_until(c_player_script_utilities.all_players_are_ready())
    sleep_until(pt_dunes.is_triggered())
    sleep(2)
    sp_objective_vent.objective_begin_immediate()
    sleep(21)
    sp_objective_vent.objective_end_silent()
    seq_music_cabal_intro.set_switch_mask(3)
    seq_dialog_plains_vent_complete.start()
    sp_objective_control.objective_begin()
    sleep(24)
    sp_objective_control.objective_end_silent()
    seq_dialog_plains_control_complete.start()
    sleep(3)
