# es\mars\act_mars_m01_valley\act_mars_m01_valley_mission1.esp
#
# Mission 1, the arrival cinematic. The lifetime holds while it plays; the
# player spawns once the plains encounter lets them.

cinematic_midmission sp_cinematic_bookend

thread init: pass

thread complete: pass

thread main:
    sp_cinematic_bookend.start()
    sleep_until(sp_cinematic_bookend.is_complete())
