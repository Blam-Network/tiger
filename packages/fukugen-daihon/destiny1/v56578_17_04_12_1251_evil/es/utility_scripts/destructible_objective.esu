# es\utility_scripts\destructible_objective.esu
#
# An objective that completes when its object is destroyed (the Cosmodrome's
# Fallen beacon). Ported from the alpha's: TU0's rows are the player objective,
# its sequences, the nav point and the object; the activity flag and the kill
# listener are the script's own. The flag is what lets the placement's object
# be hurt.

c_player_objective_sensor_host _player_objective
c_sequence_host _incoming_sequence
c_sequence_host _completion_sequence
c_nav_point_host _nav_point
c_encounter_binding_host _object
c_activity_flag _activity_flag
c_kill_incident_listener _incident_listener
string_hash _identifier
string_hash _incident_destructible_kill_hash = "destructible_kill"

def import_only_bind(identifier):
    _identifier = identifier
    return _object.import_only_bind_object(identifier) and _activity_flag.import_only_bind(identifier)

def is_complete():
    return _incident_listener.get_count() > 0

def objective_begin():
    _player_objective.set_incoming()
    sleep(2)
    _incoming_sequence.start()
    sleep_until_timeout(_incoming_sequence.is_done(), 10)
    objective_begin_immediate()

def objective_begin_immediate():
    _player_objective.set_active()
    _player_objective.nav_point_activate_with_fallback(_object, _nav_point)
    _player_objective.progress_bind(_object)
    objective_begin_silent()

def objective_begin_silent():
    _incident_listener.reset()
    _incident_listener.bind_object_identifier(_identifier)
    _incident_listener.bind_incident_name_hash(_incident_destructible_kill_hash)
    _activity_flag.activate()

def cleanup():
    _activity_flag.clear()

def objective_end():
    cleanup()
    _player_objective.nav_point_clear()
    _completion_sequence.start()
    sleep_until_timeout(_completion_sequence.is_done(), 10)
    _player_objective.set_complete()
    sleep(2)
    _player_objective.clear()

def objective_end_silent():
    cleanup()
    _player_objective.clear()
