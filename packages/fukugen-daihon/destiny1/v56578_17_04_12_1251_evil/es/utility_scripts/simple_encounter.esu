# es\utility_scripts\simple_encounter.esu
#
# An ambient encounter. Its squads go in under its objective while no player
# is watching, and come back once they have been out of combat for
# respawn_time. A wiped encounter comes back too, once no player is inside
# its volume: retail's Last Array re-served its wiped ambient squads (and
# bumped their objective) only while the player was out of range. Ported
# from the alpha's.

c_trigger_volume_slot_host _trigger_volume
dynamic_array<c_squad_sensor_host> _squad
c_squad_group_sensor_host _squad_group
c_objective_sensor_host _objective
c_common_reference _objective_reference
int respawn_time = 30
c_timer_sensor_host _respawn_timer
c_player_monitor_sensor_host _player_monitor bind(_trigger_volume)
bool bInitialPlacement = true

def import_only_bind(identifier):
    for s in _squad:
        s.import_only_bind(identifier)
    return true

def set_objective(override_objective):
    _objective_reference = override_objective

def activate():
    main.restart()

def deactivate():
    main.kill()
    complete.restart()

startup thread ss_initial_placement:
    sleep(5)
    bInitialPlacement = false

thread init:
    if not _player_monitor.test_any_inside():
        main.restart()

thread main:
    for s in _squad:
        _squad_group.add_child(s)

    if _objective_reference:
        _objective_reference.add_squad(_squad_group)
    else:
        _objective.add_squad(_squad_group)
        _objective.reset()

    if bInitialPlacement:
        _squad_group.place()
    else:
        _squad_group.respawn()

    while true:
        if _squad_group.alive_count() == 0:
            sleep_until(not _player_monitor.test_any_inside())
            _squad_group.respawn()
            _objective.reset()
        if _squad_group.current_in_combat_count() > 0:
            _respawn_timer.reset(respawn_time)
            _respawn_timer.stop()
        else:
            _respawn_timer.start()

        if _respawn_timer.is_expired() and respawn_time > 0:

            _squad_group.respawn()
            _objective.reset()

        sleep(1)

thread complete:
    if _squad_group.alive_count() > 0:
        _squad_group.activate_temperament("temper_despawn")
        sleep(4)
        _squad_group.deactivate_temperament("temper_despawn")
    _squad_group.remove()
