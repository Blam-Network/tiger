# es\hiveship\mission_touchdown\mission_touchdown_mission1.esp
#
# Mission 1, the landing cinematic, played from world entry in the shroud's
# cinematic state; the players spawn in the shroud once it ends. One run.

cinematic_midmission pf_cinematic_bookend

script init(): pass

script complete(): pass

script main():
    pf_cinematic_bookend.start()
    sleep_until(pf_cinematic_bookend.is_complete())
