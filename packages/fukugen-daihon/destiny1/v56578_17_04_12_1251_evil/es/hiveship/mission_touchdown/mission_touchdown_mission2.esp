# es\hiveship\mission_touchdown\mission_touchdown_mission2.esp
#
# Mission 2, "infiltrate the shroud": the lifetime goes active as the
# players spawn, the Ghost's first line plays five seconds on, and the
# objective to the core comes up 19 seconds after the spawn. Five seconds
# after it the shroud's hall fallback opens (unknown_9405a5b0); once a
# player is through it the platform triggers arm and the Ghost talks
# about the way on. The phase ends as a player reaches the core.
#
# One run: the 5, 19 and 5 second holds are that run's gaps, nothing on the
# wire explains them. Retail showed the objective in state 1 two seconds
# before it went active; no verb sends state 1, so it goes straight to
# active. Retail moved on to the core phase 2.5 s before the core trigger's
# incident reached the host; the phase waits for the trigger.

trigger_volume_objective goto_core
player_trigger objective_fallback_trigger
player_trigger ghost_prompt_trigger
encounter_handle unknown_9405a5b0
encounter_handle unknown_5476e5b1

script init(): pass

script complete(): pass

script main():
    insertion_point()
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep(5)
    unknown_5476e5b1.tch0010_ghost_dialogue.start()
    sleep(14)
    goto_core.objective_begin_immediate()
    sleep(5)
    unknown_9405a5b0.hall_fallback_trigger.reset()
    sleep_until(unknown_9405a5b0.hall_fallback_trigger.is_triggered())
    sleep(1)
    objective_fallback_trigger.reset()
    sleep(1)
    ghost_prompt_trigger.reset()
    unknown_5476e5b1.tch0023_ghost_dialogue.start()
    sleep(1)
    unknown_5476e5b1.tch0030_ghost_dialogue.start()
    sleep_until(goto_core.is_complete())
    goto_core.objective_end_silent()
