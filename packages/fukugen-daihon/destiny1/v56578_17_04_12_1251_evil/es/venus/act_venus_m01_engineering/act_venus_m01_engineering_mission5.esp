# es\venus\act_venus_m01_engineering\act_venus_m01_engineering_mission5.esp
#
# Mission 5, hold the entrance: three defensive waves out of the Vex clouds, a
# ledge sniper between them. Clears when the entrance is quiet; the music steps
# up on the last wave and again at the end, then the Ghost sends the player on.

generic_objective pf_resist_vex
c_trigger_volume_slot_host tv_resist_vex
c_nav_point_host ap_resist_vex
c_encounter_handle enc_entrance_m01
c_sequence_host venus_m01_music_cue1
c_sequence_host md_vn01_020_100

thread init: pass

thread complete: pass

thread main:
    pf_resist_vex.objective_begin_immediate(ap_resist_vex)
    enc_entrance_m01.sc_resist.wake()
    sc_last_wave_music.wake()
    sleep_until(enc_entrance_m01.entrance_clear == true)
    sleep(1)
    pf_resist_vex.objective_end_silent()
    sleep(1)
    venus_m01_music_cue1.set_switch_mask(31)
    sleep(5)
    venus_m01_020_d100.wake()
    sleep_until(md_vn01_020_100.is_done())

thread sc_last_wave_music:
    sleep_until(enc_entrance_m01.i_resist_wave >= 3)
    venus_m01_music_cue1.set_switch_mask(15)

thread venus_m01_020_d100:
    md_vn01_020_100.start()
    print("md_vn01_020_100")
