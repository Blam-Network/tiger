# es\venus\mission_pursuit\mission_pursuit_mission5.esp
#
# Mission 5, the outro. Five seconds after the pit is clear the Ghost's last
# line and the outro music start and the activity completes; the results
# come up 30 seconds on. One run: unconfirmed.

sequence mission_complete_dialog
sequence music_outro

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    sleep(5)
    mission_complete_dialog.start()
    music_outro.start()
    set_activity_complete()
