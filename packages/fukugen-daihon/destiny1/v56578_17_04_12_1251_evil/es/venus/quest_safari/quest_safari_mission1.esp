# es\venus\quest_safari\quest_safari_mission1.esp
#
# Mission 1, the headlands: nothing to do but wait for the players. The
# lifetime goes active as they are all in and the next phase starts in the
# same frame. One run.

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
