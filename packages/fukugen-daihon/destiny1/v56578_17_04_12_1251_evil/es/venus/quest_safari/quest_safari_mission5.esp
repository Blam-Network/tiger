# es\venus\quest_safari\quest_safari_mission5.esp
#
# Mission 5, the outro: the cue stops as the phase starts, the outro music
# and the Ghost's last line come two seconds later with the activity's
# completion, and the results 30 seconds on. One run.

encounter_handle quest_safari

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    quest_safari.music_cue1.stop()
    sleep(2)
    quest_safari.music_outro.start()
    quest_safari.mission_done_dialog.start()
    set_activity_complete()
