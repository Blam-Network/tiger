# es\venus\mission_traitor\mission_traitor_mission4.esp
#
# Mission 4, "find the boss": the objective and the Ghost's line about the
# clouds come up as the phase starts and clear at the boss's platform. The
# Fallen the clouds drop on the way are the tower's (unknown_8a595800). One
# run: unconfirmed.

@hard_wipe()
trigger_volume_objective pf_find_boss
encounter_handle mission_traitor

script init(): pass

script complete(): pass

script main():
    mission_traitor.clouds_dialog.start()
    pf_find_boss.objective_begin()
    sleep_until(pf_find_boss.is_complete())
    pf_find_boss.objective_end()
