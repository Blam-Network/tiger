# es\moon\act_moon_m3_lowercitadel\act_moon_m3_lowercitadel_mission1.esp
#
# Mission 1, the wisdom hall: the activity goes live once the players are in,
# and the objective is to reach the Lower Citadel. It clears on entering the
# bubble.

c_location_sensor_host lowercitadel
trigger_bubble_objective pf_objective_goto bind(lowercitadel)
c_sequence_host seq_d_o1_s03
c_sequence_host seq_d_o1_s031

thread init: pass

thread complete: pass

thread main:
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep(2)
    pf_objective_goto.objective_begin()
    sleep_until(pf_objective_goto.is_complete())
    pf_objective_goto.objective_end_silent()
    # the wisdom hall's lines stop with the objective
    seq_d_o1_s03.stop()
    seq_d_o1_s031.stop()
