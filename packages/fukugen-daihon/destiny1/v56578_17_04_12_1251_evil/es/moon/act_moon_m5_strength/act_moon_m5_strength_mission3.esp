# es\moon\act_moon_m5_strength\act_moon_m5_strength_mission3.esp
#
# Mission 3, the launch tubes: get to the cinematic's trigger volume. The
# objective went up three seconds into the phase in the one run (the launch
# tubes' own Hive belong to the area's ambient bundle).

trigger_volume_objective pf_obj_cine_trigger

script init(): pass

script complete(): pass

script main():
    sleep(3)
    pf_obj_cine_trigger.objective_begin()
    sleep_until(pf_obj_cine_trigger.is_complete())
    pf_obj_cine_trigger.objective_end_silent()
