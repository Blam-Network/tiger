# es\moon\act_moon_m5_strength\act_moon_m5_strength_mission5.esp
#
# Mission 5, on to the Chamber of Night. The players respawn after the
# cinematic; the objective goes up once they are in, and clears when a
# player reaches the chamber's bubble.

location strength
trigger_bubble_objective pf_objective_goto bind(strength)

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    pf_objective_goto.objective_begin()
    sleep_until(pf_objective_goto.is_complete())
    pf_objective_goto.objective_end_silent()
