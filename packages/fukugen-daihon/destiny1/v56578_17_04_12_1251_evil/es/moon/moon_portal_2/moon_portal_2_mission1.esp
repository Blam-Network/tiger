# es\moon\moon_portal_2\moon_portal_2_mission1.esp
#
# Mission 1, the upper citadel: reach the citadel, then the hall, then use
# the Hive door panel. The panel lights up as its objective goes active; the
# objective listens for the interaction with it.

c_encounter_handle enc_uppercitadel_portal2
trigger_volume_objective pf_tv_uppercitadel_entrance
trigger_volume_objective pf_tv_objective_entrance
interactable_objective pf_i_door bind("0x80296306")

thread init: pass

thread complete: pass

thread main:
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    pf_tv_uppercitadel_entrance.objective_begin()
    sleep_until(pf_tv_uppercitadel_entrance.is_complete())
    pf_tv_uppercitadel_entrance.objective_end_silent()
    sleep(2)
    pf_tv_objective_entrance.objective_begin()
    sleep_until(pf_tv_objective_entrance.is_complete())
    pf_tv_objective_entrance.objective_end_silent()
    sleep(2)
    pf_i_door.objective_begin()
    enc_uppercitadel_portal2.pf_i_door_placement._object.set_device_position(0.1)
    sleep_until(pf_i_door.is_complete())
    pf_i_door.objective_end_silent()
