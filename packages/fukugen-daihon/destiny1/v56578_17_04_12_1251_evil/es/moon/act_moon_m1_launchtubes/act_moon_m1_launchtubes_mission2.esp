# es\moon\act_moon_m1_launchtubes\act_moon_m1_launchtubes_mission2.esp
#
# Mission 2, the accelerator. Explore, then hit the button: it false-starts
# and the Fallen come in by dropship (the accelerator encounter runs that).
# The defend objective holds until the last of them is dead. One run: the
# explore line showed an earlier state (1) at the bubble entry that nothing
# here writes.

generic_objective pf_gen_obj_explore
nav_point ap_obj_1
player_trigger pt_accel_obj
player_trigger pt_accel_enter
interactable_objective pf_objective_button_a bind("0x0F93E94C")
interactable_placement pf_placement_button_a bind("0x0F93E94C")
generic_objective pf_gen_obj_defend
nav_point ap_obj_2
trigger_group tg_m1_accel_combat
squad sq_dropship_west
squad sq_interior_back
squad sq_interior_melee
squad sq_interior_front
squad sq_drop_initial
squad sq_drop_a
squad sq_drop_c
squad sq_drop_d

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    sleep_until(pt_accel_obj.is_triggered())
    sleep(2)
    pf_gen_obj_explore.objective_begin_immediate(ap_obj_1)
    sleep_until(pt_accel_enter.is_triggered())
    sleep(1)
    pf_gen_obj_explore.objective_end_silent()
    pf_objective_button_a.objective_begin()
    sleep_until(pf_objective_button_a.is_complete())
    sleep_until(sq_dropship_west.alive_count() > 0)
    sleep(2)
    pf_objective_button_a.objective_end_silent()
    pf_gen_obj_defend.objective_begin(ap_obj_2)
    tg_m1_accel_combat.activate()
    sleep_until(sq_drop_d.alive_count() > 0)
    sleep_until(accelerator_alive_count() == 0)
    sleep(2)
    tg_m1_accel_combat.deactivate()
    sleep(2)
    pf_gen_obj_defend.objective_end_silent()
    sleep(7)

def accelerator_alive_count():
    return sq_interior_back.alive_count() + sq_interior_melee.alive_count() + sq_interior_front.alive_count() + sq_drop_initial.alive_count() + sq_drop_a.alive_count() + sq_drop_c.alive_count() + sq_drop_d.alive_count()
