# es\moon\act_moon_m1_launchtubes\act_moon_m1_launchtubes_mission7.esp
#
# Mission 7, the gate: kill the Hive at the door. The launch tubes encounter
# brings them in once the player is back from the cinematic; the objective
# clears when a player pushes on into the court. One run: the waits at the
# top are timed from the cinematic's end.

trigger_group tg_moon_m1_door_so
sequence seq_wave_announce
generic_objective pf_gen_obj_kill_all
player_trigger pt_spawn_court_interior

script init(): pass

script complete(): pass

script main():
    sleep(4)
    tg_moon_m1_door_so.activate()
    seq_wave_announce.start()
    sleep(3)
    pf_gen_obj_kill_all.objective_begin()
    sleep_until(pt_spawn_court_interior.is_triggered())
    sleep(2)
    pf_gen_obj_kill_all.objective_end_silent()
    tg_moon_m1_door_so.deactivate()
