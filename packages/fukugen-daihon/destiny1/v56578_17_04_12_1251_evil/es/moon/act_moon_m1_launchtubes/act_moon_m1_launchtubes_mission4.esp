# es\moon\act_moon_m1_launchtubes\act_moon_m1_launchtubes_mission4.esp
#
# Mission 4, "Go to the Launch Tubes". Clears when a player enters the launch
# tubes bubble.

c_location_sensor_host launchtubes
trigger_bubble_objective pf_objective_goto bind(launchtubes)
c_sequence_host seq_d_o2_s06
c_sequence_host seq_d_o2_s07

thread init: pass

thread complete: pass

thread main:
    pf_objective_goto.objective_begin()
    seq_d_o2_s06.start()
    seq_d_o2_s07.start()
    sleep_until(pf_objective_goto.is_complete())
    pf_objective_goto.objective_end_silent()
