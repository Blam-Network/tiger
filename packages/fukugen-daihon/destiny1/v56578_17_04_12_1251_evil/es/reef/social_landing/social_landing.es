# es\reef\social_landing\social_landing.es
#
# The Vestian Outpost, the Reef's social space. Its own bundle has no rows,
# so the root only says where the activity starts; the vendors, Petra's
# people and the patrolling Awoken are unknown_e525f723's.

# The 2.3.1 captures (seven visits) start it in bubble 0, its only state, at
# the default spawn point.
@activity("social_landing")
@start_slice("hangar")
