# es\cosmo\act_cosmo_m0_highway\act_cosmo_m0_highway_mission7.esp
#
# Mission 7, the outro: the ship leaves. The cinematic plays, then the
# activity ends.

cinematic_midmission pf_105_cto

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game()

script main():
    sleep(7)
    set_activity_complete()
    pf_105_cto.start()
    sleep_until(pf_105_cto.is_complete())
