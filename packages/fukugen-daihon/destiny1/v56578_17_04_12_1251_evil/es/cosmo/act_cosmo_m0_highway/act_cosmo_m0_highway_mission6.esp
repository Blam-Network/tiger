# es\cosmo\act_cosmo_m0_highway\act_cosmo_m0_highway_mission6.esp
#
# Mission 6, the hangar: "Find the Ship", then "Clear Out the Fallen".
# The objective clears a few seconds after the last Fallen dies.

c_sequence_host seq_d_o5_10  # true name unknown
trigger_volume_objective obj_m0_m04a
generic_objective obj_m0_m04b
c_nav_point_host ap_obj_m0_m04b  # true name unknown
c_player_trigger_sensor_host pt_fallen_backup  # true name unknown
c_squad_sensor_host sq_m0_fallen_gating
c_squad_sensor_host sq_ch1_fallen_on_playership_1
c_squad_sensor_host sq_ch1_fallen_on_playership_2
c_squad_sensor_host sq_ch1_fallen_on_playership_3
c_squad_sensor_host sq_m0_fallen_1
c_squad_sensor_host sq_m0_fallen_2

thread init: pass

thread complete: pass

thread main:
    seq_d_o5_10.start()
    sleep(3)
    obj_m0_m04a.objective_begin()
    sleep_until(obj_m0_m04a.is_complete())
    obj_m0_m04a.objective_end_silent()
    obj_m0_m04b.objective_begin(ap_obj_m0_m04b)
    sleep_until(pt_fallen_backup.is_triggered())
    sleep_until(hangar_alive_count() == 0)
    sleep(6)
    obj_m0_m04b.objective_end_silent()

def hangar_alive_count():
    return sq_m0_fallen_gating.alive_count() + sq_ch1_fallen_on_playership_1.alive_count() + sq_ch1_fallen_on_playership_2.alive_count() + sq_ch1_fallen_on_playership_3.alive_count() + sq_m0_fallen_1.alive_count() + sq_m0_fallen_2.alive_count()
