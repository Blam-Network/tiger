# es\cosmo\act_cosmo_m0_highway\act_cosmo_m0_highway_mission2.esp
#
# Mission 2, "Enter the Wall". The objective comes up shortly after the
# player first stands on the highway, and clears at the wall.

c_trigger_volume_slot_host tv_first_obj
c_player_trigger_sensor_host pt_first_obj bind(tv_first_obj)  # true name unknown
trigger_volume_objective obj_m0_phase00_m1

thread init: pass

thread complete: pass

thread main:
    sleep_until(pt_first_obj.is_triggered())
    sleep(4)
    obj_m0_phase00_m1.objective_begin()
    sleep_until(obj_m0_phase00_m1.is_complete())
    obj_m0_phase00_m1.objective_end_silent()
