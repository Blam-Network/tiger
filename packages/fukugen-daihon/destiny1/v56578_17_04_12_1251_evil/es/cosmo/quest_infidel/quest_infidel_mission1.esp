# es\cosmo\quest_infidel\quest_infidel_mission1.esp
#
# Mission 1, the landing in the graveyard: once the player is in, the
# activity goes live and the landing lines and the intro music start, the
# music on its first switch. The phase ends there. From one retail capture.

sequence landing_dialog
sequence graveyard_exit_dialog
sequence music_intro
sequence music_cue1

script init(): pass

script complete(): pass

script main():
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    landing_dialog.start()
    graveyard_exit_dialog.start()
    music_intro.start()
    music_cue1.start()
    music_cue1.set_switch_mask(1)
