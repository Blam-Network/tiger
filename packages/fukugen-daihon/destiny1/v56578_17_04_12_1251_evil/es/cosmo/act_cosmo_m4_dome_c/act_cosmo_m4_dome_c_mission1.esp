# es\cosmo\act_cosmo_m4_dome_c\act_cosmo_m4_dome_c_mission1.esp
#
# Mission 1, the Array: get there, then take the codes from the Fallen
# captain. The Array is a public bubble; its Fallen belong to enc_array_amb1.

c_location_sensor_host array
trigger_bubble_objective obj_m4_o1a bind(array)
collect_loot_objective obj_m4_o1b bind("0xDA728072", 3)
c_sequence_host seq_d_o1_s03
c_sequence_host seq_d_o1_s04
c_sequence_host seq_d_o1_s045
c_sequence_host seq_d_o1_s047
c_sequence_host seq_d_o1_s05

thread init: pass

thread complete: pass

thread main:
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    obj_m4_o1a.objective_begin()
    sleep_until(obj_m4_o1a.is_complete())
    obj_m4_o1a.objective_end_silent()
    obj_m4_o1b.objective_begin()
    # the Ghost has a line for each of the first two codes picked up
    sleep_until(obj_m4_o1b.get_count() >= 1)
    seq_d_o1_s045.start()
    sleep_until(obj_m4_o1b.get_count() >= 2)
    seq_d_o1_s047.start()
    sleep_until(obj_m4_o1b.is_complete())
    seq_d_o1_s03.stop()
    seq_d_o1_s04.stop()
    seq_d_o1_s05.start()
    obj_m4_o1b.objective_end_silent()
    # the Ghost's line about the codes before the next phase (one run)
    sleep(3)
