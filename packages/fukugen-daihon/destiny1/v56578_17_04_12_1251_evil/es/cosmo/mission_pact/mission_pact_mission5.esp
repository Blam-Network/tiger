# es\cosmo\mission_pact\mission_pact_mission5.esp
#
# Mission 5, the end: the lines still playing stop, the Ghost's last line and
# the outro music start, and the activity is complete. From two retail
# captures.

@hard_wipe()
sequence refinery_exit_dialog
sequence rocketyard_exit_dialog
sequence command_enter_dialog
sequence mission_done_dialog
sequence seq_m_cue3
sequence seq_m_outro

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    refinery_exit_dialog.stop()
    rocketyard_exit_dialog.stop()
    command_enter_dialog.stop()
    seq_m_cue3.stop()
    mission_done_dialog.start()
    seq_m_outro.start()
    set_activity_complete()
