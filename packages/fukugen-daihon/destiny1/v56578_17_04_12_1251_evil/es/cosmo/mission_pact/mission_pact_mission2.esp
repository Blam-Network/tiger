# es\cosmo\mission_pact\mission_pact_mission2.esp
#
# Mission 2, the refinery: finish off the grotto's Fallen and Hive, then cross
# the refinery and kill its Servitor (unknown_61b048de's). The refinery lines
# and the second music cue start with the phase. From one retail capture.

generic_objective obj_m7_o2a
generic_objective obj_m7_o2b
sequence refinery_enter_dialog
sequence refinery_mid_dialog
sequence servitor_b_approach_dialog
sequence seq_m_cue2
encounter_handle unknown_99f4fbfa
encounter_handle unknown_61b048de

script init(): pass

script complete(): pass

script main():
    refinery_enter_dialog.start()
    refinery_mid_dialog.start()
    servitor_b_approach_dialog.start()
    seq_m_cue2.start()
    seq_m_cue2.set_switch_mask(3)
    obj_m7_o2a.objective_begin()
    sleep_until(unknown_99f4fbfa.grotto_is_clear())
    obj_m7_o2a.objective_end_silent()
    obj_m7_o2b.objective_begin()
    sleep_until(unknown_61b048de.servitor_is_dead())
    obj_m7_o2b.objective_end_silent()
