# es\cosmo\act_cosmo_m0_5_hangar\act_cosmo_m0_5_hangar_mission3.esp
#
# Mission 3, clear out the Vandals: the objective clears when the last of
# them is down, the music cue stops with the phase, and the activity ends a
# couple of seconds later with the ascent. From one retail capture.

generic_objective obj_m0_5_generic
squad sq_amb_fallen_vandal_1
squad sq_amb_fallen_vandal_2
squad sq_amb_fallen_vandal_3
sequence seq_m_cue1
sequence seq_m_ascent
sequence seq_d_o4_s01
sequence seq_d_o4_s02
sequence seq_d_o4_s05

script init(): pass

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game(30)

script main():
    seq_m_cue1.stop()
    obj_m0_5_generic.objective_begin(nil)
    sleep_until(vandals_alive_count() == 0)
    obj_m0_5_generic.objective_end_silent()
    seq_d_o4_s01.stop()
    seq_d_o4_s02.stop()
    sleep(2.1)
    set_activity_complete()
    seq_m_ascent.start()
    sleep(1.6)
    seq_d_o4_s05.start()

def vandals_alive_count():
    return sq_amb_fallen_vandal_1.alive_count() + sq_amb_fallen_vandal_2.alive_count() + sq_amb_fallen_vandal_3.alive_count()
