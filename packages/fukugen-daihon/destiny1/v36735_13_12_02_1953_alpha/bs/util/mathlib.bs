    static def random_int_never_highest_value(lower_bound, upper_bound):
        return lower_bound + mathlib.random_int(upper_bound - lower_bound)


    static def random_int_inclusive(lower_bound, upper_bound):
        return lower_bound + mathlib.random_int(1 + (upper_bound - lower_bound))

    static def nondeterministic_random_int_inclusive(lower_bound, upper_bound):
