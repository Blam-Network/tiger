    static def pow_simple(base, exponent):
        value = 1
        exponent = mathlib.abs(exponent)
        for index in range(1, exponent):
            value = value * base
        return value

    static def lerp(t, min, max):

        if t < 0:
            return min
        if t > 1:
            return max
        return min + (max - min) * t

