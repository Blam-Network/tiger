    static def scalify(t, min, max):

        mini = min
        maxi = max
        ti = t
        if maxi < mini:
            ti = maxi + mini - t
            old_maxi = maxi
            maxi = mini
            mini = old_maxi
        if ti < mini:
            return 0
        if maxi < ti:
            return 1
        return (ti - mini) / (maxi - mini)


    static def get_t_from_extents(value, min, max):
        return scalify(value, min, max)



    static def reflect3(vector, normal):
        projection = mathlib.dot3(vector, normal)
        return vector - 2 * projection * normal

