        import_accuracy_stats(6, 1.2)




        for index in range(stability.maximum_count()):
            stability.new()

        import_stability_stats(0, 2, 0, 0.4)
        import_stability_stats(1, 1.966, 0, 0.367)
        import_stability_stats(2, 1.934, 0, 0.333)
        import_stability_stats(3, 1.9, 0, 0.3)
        import_stability_stats(4, 1.866, 0, 0.267)
        import_stability_stats(5, 1.834, 0, 0.233)
        import_stability_stats(6, 1.8, 0, 0.2)




        for index in range(range.maximum_count()):
            range.new()

        import_range_stats(0, 0.8)
        import_range_stats(1, 0.85)
        import_range_stats(2, 0.9)
        import_range_stats(3, 0.95)
        import_range_stats(4, 1)
        import_range_stats(5, 1.05)
        import_range_stats(6, 1.1)




        for index in range(base_damage.maximum_count()):
            base_damage.new()

        import_base_damage_stats(0, 216)
        import_base_damage_stats(1, 216)
        import_base_damage_stats(2, 216)
        import_base_damage_stats(3, 216)
        import_base_damage_stats(4, 216)
