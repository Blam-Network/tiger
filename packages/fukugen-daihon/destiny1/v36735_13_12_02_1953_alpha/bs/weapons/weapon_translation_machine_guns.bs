        return true










    def translate_machine_gun_stats(mg):

        mg.trigger_behavior = e_trigger_behavior._weapon_trigger_behavior_spew

        mg.rate_of_fire = rate_of_fire[investment_rate_of_fire].machine_gun_rate_of_fire
        mg.shots_per_fire = rate_of_fire[investment_rate_of_fire].machine_gun_shots_per_fire
        local magazine_size = self.magazine_size[investment_magazine_size].machine_gun_magazine_size
        mg.reload_full_time = handling[investment_handling].machine_gun_reload_full_time
        mg.reload_empty_time = handling[investment_handling].machine_gun_reload_empty_time
        mg.ready_time = handling[investment_handling].machine_gun_ready_time
        mg.put_away_duration = handling[investment_handling].machine_gun_put_away_duration
        mg.ads_time = handling[investment_handling].machine_gun_ads_time
        mg.zoom_amount = optics[investment_optics].machine_gun_zoom_amount

        ads_accuracy_scale = 1 / mg.zoom_amount
        initial_error = accuracy[investment_accuracy].machine_gun_initial_error
        final_error = stability[investment_stability].machine_gun_final_error
        mg.ads_movement_penality_scale = stability[investment_stability].machine_gun_ads_move_penality_scale
        mg.recoil_scale = stability[investment_stability].machine_gun_recoil_scale
        range_scale = range[investment_range].machine_gun_range_scale
        base_dps = base_damage[investment_base_damage].machine_gun_base_dps
        mg.sustain_damage_scale = sustain_damage[investment_sustain_damage].machine_gun_sustain_damage_scale
        mg.precision_body_damage_scale = precision_damage[investment_precision_damage].machine_gun_precision_body_damage_scale
        mg.precision_shield_damage_scale = precision_damage[investment_precision_damage].machine_gun_precision_shield_damage_scale

        mg.rounds_fired_per_second = weapon_utils.get_frame_bound_rounds_per_second(mg.rate_of_fire, mg.shots_per_fire)
        mg.fire_recovery_time = weapon_utils.get_fire_recovery_time(0, mg.rate_of_fire, mg.shots_per_fire)
        mg.soft_recovery_fraction = weapon_utils.get_soft_recovery_fraction(mg.trigger_behavior, mg.fire_recovery_time)
        mg.rounds_reloaded = weapon_utils.get_rounds_reloaded(rate_of_fire[0].machine_gun_rate_of_fire, mg.rate_of_fire, magazine_size, mg.shots_per_fire)
        mg.rounds_total_initial = mg.rounds_reloaded * initial_ammo_scale
        mg.rounds_total_max = mg.rounds_reloaded * total_ammo_scale
        mg.minimum_respawn_rounds = mg.rounds_reloaded * minimum_respawn_clips
        mg.autoaim_angle = 6 * nativemathlib.degrees_to_radians
        mg.magnetism_angle = 12 * nativemathlib.degrees_to_radians
        mg.autoaim_falloff_distance = 30 * range_scale
        mg.autoaim_distance = 60 * range_scale
        mg.magnetism_falloff_distance = 30 * range_scale
        mg.magnetism_distance = 60 * range_scale
        mg.error_angle_low = initial_error * nativemathlib.degrees_to_radians
        mg.error_angle_high = final_error * nativemathlib.degrees_to_radians
        mg.zoomed_error_scale_low = ads_accuracy_scale
        mg.zoomed_error_scale_high = weapon_utils.get_zoomed_error_scale_high(ads_accuracy_scale, mg.error_angle_low, mg.error_angle_high)
        mg.accuracy_offset = weapon_utils.get_accuracy_curve_offset(accuracy_scalar, mg.rate_of_fire)
        mg.error_per_recovery = weapon_utils.get_error_per_recovery(error_deceleration_time, mg.fire_recovery_time, mg.shots_per_fire)
        mg.recoil_offset = weapon_utils.get_recoil_curve_offset(recoil_scalar, mg.rate_of_fire)
        mg.impact_damage_scale = weapon_utils.get_scaled_impact_damage(highest_rounds_per_second, lowest_rounds_per_second, max_rof_impact_damage_scale, base_dps, mg.rate_of_fire, mg.shots_per_fire)
        mg.sustain_acquisition_rate = weapon_utils.get_sustain_acquisition_rate(sustain_damage_acquire_time_scale, mg.rate_of_fire, mg.shots_per_fire, magazine_size)
        mg.sustain_grace_time = weapon_utils.get_sustain_grace_time(sustain_damage_grace_time_scale, magazine_size)
        mg.sustain_decay_time = weapon_utils.get_sustain_decay_time(sustain_damage_decay_time_scale, magazine_size)




    def apply_stats(mg):

        set_trigger_behavior(mg.trigger_behavior)

        set_barrel_stat(e_weapon_barrel_stat.normal_initial_rate_of_fire, mg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_final_rate_of_fire, mg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_initial_rate_of_fire, mg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_final_rate_of_fire, mg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_minimum, mg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_maximum, mg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, mg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_maximum, mg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_fire_recovery_time, mg.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_fire_recovery_time, mg.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.normal_soft_recovery_fraction, mg.soft_recovery_fraction)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_soft_recovery_fraction, mg.soft_recovery_fraction)

        set_magazn_stat(e_weapon_magazine_stat.rounds_reloaded, mg.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.rounds_loaded_max, mg.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.minimum_respawn_rounds, mg.minimum_respawn_rounds)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_initial, mg.rounds_total_initial)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_max, mg.rounds_total_max)
        set_reload_stat(e_weapon_reload_stat.reload_duration, mg.reload_full_time)
        set_reload_stat(e_weapon_reload_stat.reload_empty_duration, mg.reload_empty_time)
        set_weapon_stat(e_weapon_stat.ready_duration, mg.ready_time)
        set_weapon_stat(e_weapon_stat.put_away_duration, mg.put_away_duration)
        set_weapon_stat(e_weapon_stat.aim_down_sights_time, mg.ads_time)

        set_weapon_stat(e_weapon_stat.forward_movement_penalty, movement_penality_scale)
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty, movement_penality_scale)
        set_weapon_stat(e_weapon_stat.forward_movement_penalty_zoomed, weapon_utils.get_movement_penality(mg.zoom_amount, 0.25))
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty_zoomed, weapon_utils.get_movement_penality(mg.zoom_amount, 0.25))
        set_weapon_stat(e_weapon_stat.pitch_speed_penalty_zoomed, 0)
        set_weapon_stat(e_weapon_stat.yaw_speed_penalty_zoomed, 0)

        set_weapon_stat(e_weapon_stat.zoom_level_count, zoom_level_count)
        set_weapon_stat(e_weapon_stat.zoom_magnification_minimum, mg.zoom_amount)
        set_weapon_stat(e_weapon_stat.zoom_magnification_maximum, mg.zoom_amount)
        weapon_utils.set_channel_to_scale(channel_manager, zoom_amount_channel, mg.zoom_amount)

        set_weapon_stat(e_weapon_stat.autoaim_angle, mg.autoaim_angle)
        set_weapon_stat(e_weapon_stat.magnetism_angle, mg.magnetism_angle)
        set_weapon_stat(e_weapon_stat.autoaim_distance, mg.autoaim_distance)
        set_weapon_stat(e_weapon_stat.autoaim_falloff_distance, mg.autoaim_falloff_distance)
        set_weapon_stat(e_weapon_stat.magnetism_distance, mg.magnetism_distance)
        set_weapon_stat(e_weapon_stat.magnetism_falloff_distance, mg.magnetism_falloff_distance)

        set_barrel_stat(e_weapon_barrel_stat.error_deceleration_time, error_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_low, mg.error_angle_low)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_high, mg.error_angle_high)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_low, mg.zoomed_error_scale_low)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_high, mg.zoomed_error_scale_high)
        set_barrel_stat(e_weapon_barrel_stat.firing_accuracy, mg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_crouched_accuracy, mg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_accuracy, mg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_crouched_accuracy, mg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.error_per_recovery, mg.error_per_recovery)

        set_barrel_stat(e_weapon_barrel_stat.recoil_deceleration_time, recoil_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_speed, mathlib.max(mg.rounds_fired_per_second * 2, 15) * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_return_speed, 7.5 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_max_angle, 1 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_yaw_angle, 0 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_yaw_angle, 0 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_pitch_angle, -0.7 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_pitch_angle, -0.7 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, 0.5 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, 1 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, 0.5 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle, 1 * mg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.firing_recoil, mg.recoil_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_crouched_recoil, mg.recoil_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_recoil, mg.recoil_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_crouched_recoil, mg.recoil_offset)
