        import_precision_damage_stats(2, 1.5, 1.5)
        import_precision_damage_stats(3, 1.5, 1.5)
        import_precision_damage_stats(4, 1.5, 1.5)
        import_precision_damage_stats(5, 1.5, 1.5)
        import_precision_damage_stats(6, 1.5, 1.5)

        return true










    def translate_hand_cannon_stats(hc):

        hc.trigger_behavior = e_trigger_behavior._weapon_trigger_behavior_latch

        hc.rate_of_fire = rate_of_fire[investment_rate_of_fire].hand_cannon_rate_of_fire
        hc.shots_per_fire = rate_of_fire[investment_rate_of_fire].hand_cannon_shots_per_fire
        local magazine_size = self.magazine_size[investment_magazine_size].hand_cannon_magazine_size
        hc.reload_full_time = reload[investment_reload].hand_cannon_reload_full_time
        hc.reload_empty_time = reload[investment_reload].hand_cannon_reload_empty_time
        hc.ready_time = handling[investment_handling].hand_cannon_ready_time
        hc.put_away_duration = handling[investment_handling].hand_cannon_put_away_duration
        hc.ads_time = handling[investment_handling].hand_cannon_ads_time
        hc.zoom_amount = optics[investment_optics].hand_cannon_zoom_amount

        ads_accuracy_scale = optics[investment_optics].hand_cannon_ads_accuracy_scaling
        initial_error = accuracy[investment_accuracy].hand_cannon_initial_error
        final_error = stability[investment_stability].hand_cannon_final_error
        hc.ads_movement_penality_scale = stability[investment_stability].hand_cannon_ads_move_penality_scale
        hc.recoil_scale = stability[investment_stability].hand_cannon_recoil_scale
        range_scale = range[investment_range].hand_cannon_range_scale
        base_dps = base_damage[investment_base_damage].hand_cannon_base_dps
        hc.sustain_damage_scale = sustain_damage[investment_sustain_damage].hand_cannon_sustain_damage_scale
        hc.precision_body_damage_scale = precision_damage[investment_precision_damage].hand_cannon_precision_body_damage_scale
        hc.precision_shield_damage_scale = precision_damage[investment_precision_damage].hand_cannon_precision_shield_damage_scale

        hc.rounds_fired_per_second = weapon_utils.get_frame_bound_rounds_per_second(hc.rate_of_fire, hc.shots_per_fire)
        hc.fire_recovery_time = weapon_utils.get_fire_recovery_time(0, hc.rate_of_fire, hc.shots_per_fire)
        hc.soft_recovery_fraction = weapon_utils.get_soft_recovery_fraction(hc.trigger_behavior, hc.fire_recovery_time)
        hc.rounds_reloaded = weapon_utils.get_rounds_reloaded(rate_of_fire[0].hand_cannon_rate_of_fire, hc.rate_of_fire, magazine_size, hc.shots_per_fire)
        hc.rounds_total_initial = hc.rounds_reloaded * initial_ammo_scale
        hc.rounds_total_max = hc.rounds_reloaded * total_ammo_scale
        hc.minimum_respawn_rounds = self.magazine_size[0].hand_cannon_magazine_size
        hc.autoaim_angle = 2.25 * nativemathlib.degrees_to_radians
        hc.magnetism_angle = 5 * nativemathlib.degrees_to_radians
        hc.autoaim_falloff_distance = 20 * range_scale
        hc.autoaim_distance = 40 * range_scale
        hc.magnetism_falloff_distance = 20 * range_scale
        hc.magnetism_distance = 40 * range_scale
        hc.error_angle_low = initial_error * nativemathlib.degrees_to_radians
        hc.error_angle_high = final_error * nativemathlib.degrees_to_radians
        hc.zoomed_error_scale_low = ads_accuracy_scale
        hc.zoomed_error_scale_high = weapon_utils.get_zoomed_error_scale_high(ads_accuracy_scale, hc.error_angle_low, hc.error_angle_high)
        hc.accuracy_offset = weapon_utils.get_accuracy_curve_offset(accuracy_scalar, hc.rate_of_fire)
        hc.error_per_recovery = weapon_utils.get_error_per_recovery(error_deceleration_time, hc.fire_recovery_time, hc.shots_per_fire)
        hc.recoil_offset = weapon_utils.get_recoil_curve_offset(recoil_scalar, hc.rate_of_fire)
        hc.impact_damage_scale = weapon_utils.get_scaled_impact_damage(highest_rounds_per_second, lowest_rounds_per_second, max_rof_impact_damage_scale, base_dps, hc.rate_of_fire, hc.shots_per_fire)
        hc.sustain_acquisition_rate = weapon_utils.get_sustain_acquisition_rate(sustain_damage_acquire_time_scale, hc.rate_of_fire, hc.shots_per_fire, magazine_size)
        hc.sustain_grace_time = weapon_utils.get_sustain_grace_time(sustain_damage_grace_time_scale, magazine_size)
        hc.sustain_decay_time = weapon_utils.get_sustain_decay_time(sustain_damage_decay_time_scale, magazine_size)
        weapon_input = weapon_input_interface.get_weapon_input()
        weapon_input.set_primary_trigger_initial_threshold(0.45)
        weapon_input.set_primary_trigger_press_threshold(0.1)
        weapon_input.set_primary_trigger_release_threshold(0.01)




    def apply_stats(hc):

        set_trigger_behavior(hc.trigger_behavior)

        set_barrel_stat(e_weapon_barrel_stat.normal_initial_rate_of_fire, hc.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_final_rate_of_fire, hc.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_initial_rate_of_fire, hc.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_final_rate_of_fire, hc.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_minimum, hc.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_maximum, hc.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, hc.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_maximum, hc.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_fire_recovery_time, hc.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_fire_recovery_time, hc.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.normal_soft_recovery_fraction, hc.soft_recovery_fraction)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_soft_recovery_fraction, hc.soft_recovery_fraction)

        set_magazn_stat(e_weapon_magazine_stat.rounds_reloaded, hc.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.rounds_loaded_max, hc.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.minimum_respawn_rounds, hc.minimum_respawn_rounds)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_initial, hc.rounds_total_initial)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_max, hc.rounds_total_max)
        set_reload_stat(e_weapon_reload_stat.reload_duration, hc.reload_full_time)
        set_reload_stat(e_weapon_reload_stat.reload_empty_duration, hc.reload_empty_time)
        set_weapon_stat(e_weapon_stat.ready_duration, hc.ready_time)
        set_weapon_stat(e_weapon_stat.put_away_duration, hc.put_away_duration)
        set_weapon_stat(e_weapon_stat.aim_down_sights_time, hc.ads_time)

        set_weapon_stat(e_weapon_stat.forward_movement_penalty, movement_penality_scale)
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty, movement_penality_scale)
        set_weapon_stat(e_weapon_stat.forward_movement_penalty_zoomed, weapon_utils.get_movement_penality(hc.zoom_amount, 0.25))
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty_zoomed, weapon_utils.get_movement_penality(hc.zoom_amount, 0.25))
        set_weapon_stat(e_weapon_stat.pitch_speed_penalty_zoomed, 0)
        set_weapon_stat(e_weapon_stat.yaw_speed_penalty_zoomed, 0)

        set_weapon_stat(e_weapon_stat.zoom_level_count, zoom_level_count)
        set_weapon_stat(e_weapon_stat.zoom_magnification_minimum, hc.zoom_amount)
        set_weapon_stat(e_weapon_stat.zoom_magnification_maximum, hc.zoom_amount)
        weapon_utils.set_channel_to_scale(channel_manager, zoom_amount_channel, hc.zoom_amount)

        set_weapon_stat(e_weapon_stat.autoaim_angle, hc.autoaim_angle)
        set_weapon_stat(e_weapon_stat.magnetism_angle, hc.magnetism_angle)
        set_weapon_stat(e_weapon_stat.autoaim_distance, hc.autoaim_distance)
        set_weapon_stat(e_weapon_stat.autoaim_falloff_distance, hc.autoaim_falloff_distance)
        set_weapon_stat(e_weapon_stat.magnetism_distance, hc.magnetism_distance)
        set_weapon_stat(e_weapon_stat.magnetism_falloff_distance, hc.magnetism_falloff_distance)

        set_barrel_stat(e_weapon_barrel_stat.error_deceleration_time, error_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_low, hc.error_angle_low)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_high, hc.error_angle_high)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_low, hc.zoomed_error_scale_low)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_high, hc.zoomed_error_scale_high)
        set_barrel_stat(e_weapon_barrel_stat.firing_accuracy, hc.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_crouched_accuracy, hc.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_accuracy, hc.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_crouched_accuracy, hc.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.error_per_recovery, hc.error_per_recovery)

        set_barrel_stat(e_weapon_barrel_stat.recoil_deceleration_time, recoil_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_speed, mathlib.max(hc.rounds_fired_per_second * 2, 15) * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_return_speed, 2 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_max_angle, 0.5 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_yaw_angle, 0 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_yaw_angle, 0 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_pitch_angle, -0.1 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_pitch_angle, -20 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, 0 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, 7.5 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, 0 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle, 0 * hc.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.firing_recoil, hc.recoil_offset)
