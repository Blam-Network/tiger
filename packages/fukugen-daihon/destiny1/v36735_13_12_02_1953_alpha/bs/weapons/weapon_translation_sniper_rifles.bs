    real sniper_rifle_reload_empty_time
    real sniper_rifle_ready_time
    real sniper_rifle_put_away_duration
    real sniper_rifle_ads_time

struct s_magazine_size_stats:
    real sniper_rifle_magazine_size

struct s_accuracy_stats:
    real sniper_rifle_initial_error

struct s_stability_stats:
    real sniper_rifle_final_error
    real sniper_rifle_ads_move_penality_scale
    real sniper_rifle_recoil_scale

struct s_range_stats:
    real sniper_rifle_range_scale

struct s_base_damage_stats:
    real sniper_rifle_base_dps

struct s_sustain_damage_stats:
    real sniper_rifle_sustain_damage_scale

struct s_precision_damage_stats:
    real sniper_rifle_precision_body_damage_scale
    real sniper_rifle_precision_shield_damage_scale

class c_weapon_translation_sniper_rifles : c_weapon_translation_base:
    static s_sniper_rifle_constants constants
    static static_stack<s_rate_of_fire_stats, 7> rate_of_fire
    static static_stack<s_optics_stats, 7> optics
    static static_stack<s_reload_stats, 7> reload
    static static_stack<s_handling_stats, 7> handling
    static static_stack<s_magazine_size_stats, 7> magazine_size
    static static_stack<s_accuracy_stats, 7> accuracy
    static static_stack<s_stability_stats, 7> stability
    static static_stack<s_range_stats, 7> range
    static static_stack<s_base_damage_stats, 7> base_damage
    static static_stack<s_sustain_damage_stats, 7> sustain_damage
    static static_stack<s_precision_damage_stats, 7> precision_damage
    static real sustain_damage_acquire_time_scale = 0.5
    static real sustain_damage_grace_time_scale = 0.25
    static real sustain_damage_decay_time_scale = 0.5
    static real max_rof_impact_damage_scale = 1
    static real pulse_fire_recovery_time = 0.25
    static real recoil_deceleration_time = 0.65
    static real error_deceleration_time = 0.5
    static real movement_penality_scale
    static real minimum_respawn_clips
    static real initial_ammo_scale = 1
    static real total_ammo_scale = 3
    static real accuracy_scalar = 0.25
    static real recoil_scalar = 0.25
    static int zoom_level_count = 1
    static string_hash recoil_stability_channel = "recoil_stability"
    static string_hash zoom_amount_channel = "zoom_amount"
    implements i_weapon_stats weapon_stats_interface  # true name unknown
    c_interface_reference weapon_interface  # true name unknown
    c_interface_reference weapon_barrel_interface  # true name unknown
    c_interface_reference weapon_magazine_interface  # true name unknown
    c_interface_reference weapon_reload_interface  # true name unknown
    c_interface_reference weapon_trigger_interface  # true name unknown
    c_interface_reference weapon_input_interface  # true name unknown
    c_interface_reference channel_manager  # true name unknown
    s_sniper_rifle sr
    int investment_rate_of_fire
    int investment_optics
    int investment_reload
    int investment_handling
    int investment_magazine_size
    int investment_accuracy
    int investment_stability
    int investment_range
    int investment_base_damage
    int investment_sustain_damage
    int investment_precision_damage
    real highest_rounds_per_second
    real lowest_rounds_per_second














    static def recoil_kick_speed_calculation(kick_speed):
        return mathlib.max(kick_speed * 2, 15) * nativemathlib.degrees_to_radians

    static def initialize_constants():
        set_group_count(e_sniper_rifle_type.count)
        add_group("sniper_rifle", e_trigger_behavior._weapon_trigger_behavior_latch, e_trigger_behavior._weapon_trigger_behavior_latch)

        constants.initial_rate_of_fire = 1
        constants.minimum_respawn_rounds = 0
        constants.autoaim_angle = 0.8 * nativemathlib.degrees_to_radians
        constants.magnetism_angle = 1.6 * nativemathlib.degrees_to_radians
        constants.autoaim_falloff_distance = 20
        constants.autoaim_distance = 50
        constants.magnetism_falloff_distance = 20
        constants.magnetism_distance = 50
        constants.recoil_return_speed = 2 * nativemathlib.degrees_to_radians
        constants.recoil_max_angle = 0.5 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_yaw_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_yaw_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_pitch_angle = -0.1 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_pitch_angle = 20 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_radial_yaw_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_radial_yaw_angle = 7.5 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        constants.lowest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(1, 0)
        constants.highest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(2, 0)
        constants.base_damage = 117
        constants.sustain_damage = 2
        constants.precision_damage = 2

    static def build_import_tables():
        initialize_constants()





        set_translation_copy(0, e_weapon_stat.pitch_speed_penalty_zoomed, 0)
        set_translation_copy(0, e_weapon_stat.yaw_speed_penalty_zoomed, 0)
        set_translation_copy(0, e_weapon_barrel_stat.recoil_return_speed, constants.recoil_return_speed)
        set_translation_copy(0, e_weapon_barrel_stat.recoil_max_angle, constants.recoil_max_angle)
        set_translation_copy(0, e_weapon_stat.zoom_level_count, zoom_level_count)
        set_translation_copy(0, e_weapon_stat.autoaim_angle, constants.autoaim_angle)
        set_translation_copy(0, e_weapon_stat.magnetism_angle, constants.magnetism_angle)
        set_translation_copy(0, e_weapon_stat.autoaim_distance, constants.autoaim_distance)
        set_translation_copy(0, e_weapon_stat.autoaim_falloff_distance, constants.autoaim_falloff_distance)
        set_translation_copy(0, e_weapon_stat.magnetism_distance, constants.magnetism_distance)
        set_translation_copy(0, e_weapon_stat.magnetism_falloff_distance, constants.magnetism_falloff_distance)
        set_translation_copy(0, e_weapon_barrel_stat.error_deceleration_time, error_deceleration_time)
        set_translation_copy(0, e_weapon_barrel_stat.recoil_deceleration_time, recoil_deceleration_time)
        set_translation_copy(0, e_weapon_stat.forward_movement_penalty, movement_penality_scale)
        set_translation_copy(0, e_weapon_stat.sideways_movement_penalty, movement_penality_scale)





        rate_of_fire_table = add_weapon_stats_table(e_investment_weapon_stats.rate_of_fire, 0, 6)
        rate_of_fire_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_initial_rate_of_fire, e_weapon_barrel_stat.normal_final_rate_of_fire, e_weapon_barrel_stat.zoomed_initial_rate_of_fire, e_weapon_barrel_stat.zoomed_final_rate_of_fire)
        shots_fired_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_shots_per_fire_minimum, e_weapon_barrel_stat.normal_shots_per_fire_maximum, e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, e_weapon_barrel_stat.zoomed_shots_per_fire_maximum)


        set_translation_row(rate_of_fire_table, 0, 1, 0)
        set_translation_row(rate_of_fire_table, 1, 1, 0)
        set_translation_row(rate_of_fire_table, 2, 1.333, 0)
        set_translation_row(rate_of_fire_table, 3, 1.333, 0)
        set_translation_row(rate_of_fire_table, 4, 1.5, 0)
        set_translation_row(rate_of_fire_table, 5, 1.5, 0)
        set_translation_row(rate_of_fire_table, 6, 2, 0)

        fire_recovery_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_fire_recovery_time, e_weapon_barrel_stat.zoomed_fire_recovery_time)
        set_translation_column(fire_recovery_column, weapon_utils.get_fire_recovery_time, 0, rate_of_fire_column, shots_fired_column)

        soft_recovery_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_soft_recovery_fraction, e_weapon_barrel_stat.zoomed_soft_recovery_fraction)
        set_translation_column(soft_recovery_column, weapon_utils.copy_value, 0.334)

        accuracy_offset_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.firing_accuracy, e_weapon_barrel_stat.firing_crouched_accuracy, e_weapon_barrel_stat.firing_zoomed_accuracy, e_weapon_barrel_stat.firing_zoomed_crouched_accuracy)
        set_translation_column(accuracy_offset_column, weapon_utils.get_accuracy_curve_offset, accuracy_scalar, rate_of_fire_column)

        recoil_offset_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.firing_recoil, e_weapon_barrel_stat.firing_crouched_recoil, e_weapon_barrel_stat.firing_zoomed_recoil, e_weapon_barrel_stat.firing_zoomed_crouched_recoil)
        set_translation_column(recoil_offset_column, weapon_utils.get_recoil_curve_offset, recoil_scalar, rate_of_fire_column)

        recoil_kick_speed_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.recoil_kick_speed)
        set_translation_column(recoil_kick_speed_column, weapon_utils.get_frame_bound_rounds_per_second, rate_of_fire_column, shots_fired_column)
        set_translation_column(recoil_kick_speed_column, recoil_kick_speed_calculation, recoil_kick_speed_column)

        error_per_recovery_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.error_per_recovery)
        set_translation_column(error_per_recovery_column, weapon_utils.get_error_per_recovery, error_deceleration_time, fire_recovery_column, shots_fired_column)





        magazine_size_table = add_weapon_stats_table(e_investment_weapon_stats.clip_size, 0, 6)
        magazine_size_column = add_column_to_table(magazine_size_table)


        set_translation_row(magazine_size_column, 0, 1)
        set_translation_row(magazine_size_column, 1, 2)
        set_translation_row(magazine_size_column, 2, 3)
        set_translation_row(magazine_size_column, 3, 4)
        set_translation_row(magazine_size_column, 4, 5)
        set_translation_row(magazine_size_column, 5, 6)
        set_translation_row(magazine_size_column, 6, 7)

        set_translation_divide(0, e_weapon_magazine_stat.rounds_reloaded, e_weapon_barrel_stat.normal_initial_rate_of_fire, constants.initial_rate_of_fire)
        set_translation_multiply(0, e_weapon_magazine_stat.rounds_reloaded, e_weapon_magazine_stat.rounds_reloaded, magazine_size_column)
        set_translation_round(0, e_weapon_magazine_stat.rounds_reloaded, e_weapon_magazine_stat.rounds_reloaded)
        set_translation_copy(0, e_weapon_magazine_stat.rounds_loaded_max, e_weapon_magazine_stat.rounds_reloaded)

        set_translation_multiply(0, e_weapon_magazine_stat.rounds_total_initial, e_weapon_magazine_stat.rounds_reloaded, initial_ammo_scale)
        set_translation_multiply(0, e_weapon_magazine_stat.rounds_total_max, e_weapon_magazine_stat.rounds_reloaded, total_ammo_scale)
        set_translation_multiply(0, e_weapon_magazine_stat.minimum_respawn_rounds, e_weapon_magazine_stat.rounds_reloaded, constants.minimum_respawn_rounds)

        sustained_grace_column = add_column_to_table(magazine_size_table, e_weapon_barrel_stat.sustained_grace_time)
        set_translation_column(sustained_grace_column, weapon_utils.get_sustain_grace_time, sustain_damage_grace_time_scale, magazine_size_column)

        sustained_decay_column = add_column_to_table(magazine_size_table, e_weapon_barrel_stat.sustained_decay_time)
        set_translation_column(sustained_decay_column, weapon_utils.get_sustain_decay_time, sustain_damage_decay_time_scale, magazine_size_column)





        agility_table = add_weapon_stats_table(e_investment_weapon_stats.weapon_agility, 0, 6)
        reload_full_column = add_column_to_table(agility_table, e_weapon_reload_stat.reload_duration)
        reload_empty_column = add_column_to_table(agility_table, e_weapon_reload_stat.reload_empty_duration)
        ready_column = add_column_to_table(agility_table, e_weapon_stat.ready_duration)
        put_away_time_column = add_column_to_table(agility_table, e_weapon_stat.put_away_duration)
        ads_time_column = add_column_to_table(agility_table, e_weapon_stat.aim_down_sights_time)


        set_translation_row(agility_table, 0, 3.943, 3.943, 1.2, 0.433, 0.6)
        set_translation_row(agility_table, 1, 3.64, 3.64, 1.1, 0.4, 0.566)
        set_translation_row(agility_table, 2, 3.336, 3.336, 1, 0.367, 0.533)
        set_translation_row(agility_table, 3, 3.033, 3.033, 0.9, 0.333, 0.5)
        set_translation_row(agility_table, 4, 2.73, 2.73, 0.8, 0.3, 0.466)
        set_translation_row(agility_table, 5, 2.426, 2.426, 0.7, 0.267, 0.433)
        set_translation_row(agility_table, 6, 2.123, 2.123, 0.6, 0.233, 0.4)





        optics_table = add_weapon_stats_table(e_investment_weapon_stats.optics, 0, 6)
        zoom_amount_column = add_column_to_table(optics_table, e_weapon_stat.zoom_magnification_minimum, e_weapon_stat.zoom_magnification_maximum)
        accuracy_scale_column = add_column_to_table(optics_table, e_weapon_barrel_stat.zoomed_error_scale_low)


        set_translation_row(optics_table, 0, 4.5, 0.1)
        set_translation_row(optics_table, 1, 5, 0.083)
        set_translation_row(optics_table, 2, 5.5, 0.067)
        set_translation_row(optics_table, 3, 6, 0.05)
        set_translation_row(optics_table, 4, 6.5, 0.033)
        set_translation_row(optics_table, 5, 7, 0.017)
        set_translation_row(optics_table, 6, 7.5, 0)

        movement_penalty_zoomed_column = add_column_to_table(optics_table, e_weapon_stat.forward_movement_penalty_zoomed, e_weapon_stat.sideways_movement_penalty_zoomed)
        set_translation_column(movement_penalty_zoomed_column, weapon_utils.get_movement_penality, zoom_amount_column, 0.25)





        accuracy_table = add_weapon_stats_table(e_investment_weapon_stats.initial_accuracy, 0, 6)
        initial_error_column = add_column_to_table(accuracy_table, e_weapon_barrel_stat.error_angle_low, e_weapon_barrel_stat.error_angle_high)


        set_translation_row(accuracy_table, 0, 5)
        set_translation_row(accuracy_table, 1, 4.5)
        set_translation_row(accuracy_table, 2, 4)
        set_translation_row(accuracy_table, 3, 3.5)
        set_translation_row(accuracy_table, 4, 3)
        set_translation_row(accuracy_table, 5, 2.5)
        set_translation_row(accuracy_table, 6, 2)

        set_translation_column(initial_error_column, weapon_utils.multiply_values, initial_error_column, nativemathlib.degrees_to_radians)





        stability_table = add_weapon_stats_table(e_investment_weapon_stats.stability, 0, 6)
        final_error_column = add_column_to_table(stability_table)
        not_used_column = add_column_to_table(stability_table)
        recoil_scale_column = add_column_to_table(stability_table, e_weapon_barrel_stat.recoil_kick_min_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_pitch_angle, e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle)


        set_translation_row(stability_table, 0, 0, 0, 1)
        set_translation_row(stability_table, 1, 0, 0, 0.88)
        set_translation_row(stability_table, 2, 0, 0, 0.76)
        set_translation_row(stability_table, 3, 0, 0, 0.64)
        set_translation_row(stability_table, 4, 0, 0, 0.52)
        set_translation_row(stability_table, 5, 0, 0, 0.4)
        set_translation_row(stability_table, 6, 0, 0, 0.28)

        set_translation_column(final_error_column, weapon_utils.copy_value, initial_error_column)

        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_yaw_angle, constants.recoil_kick_min_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_yaw_angle, constants.recoil_kick_max_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_pitch_angle, e_weapon_barrel_stat.recoil_kick_min_pitch_angle, constants.recoil_kick_min_pitch_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_pitch_angle, constants.recoil_kick_max_pitch_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, constants.recoil_kick_min_radial_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, constants.recoil_kick_max_radial_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, constants.recoil_kick_min_radial_pitch_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle, constants.recoil_kick_max_radial_pitch_angle)

        set_translation_divide(0, e_weapon_barrel_stat.zoomed_error_scale_high, initial_error_column, final_error_column)
        set_translation_multiply(0, e_weapon_barrel_stat.zoomed_error_scale_high, e_weapon_barrel_stat.zoomed_error_scale_high, accuracy_scale_column)







        set_translation_divide(0, e_weapon_barrel_stat.impact_damage_multiplier, 1, rate_of_fire_column)
        set_translation_divide(0, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.impact_damage_multiplier, weapon_utils.global_time_per_frame)
        set_translation_ceiling(0, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.impact_damage_multiplier)
        set_translation_multiply(0, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.impact_damage_multiplier, weapon_utils.global_time_per_frame)
        set_translation_divide(0, e_weapon_barrel_stat.impact_damage_multiplier, 1, e_weapon_barrel_stat.impact_damage_multiplier)
        set_translation_copy(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.impact_damage_multiplier)
        set_translation_copy(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.impact_damage_multiplier)


        set_translation_subtract(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, constants.lowest_rounds_per_second)
        set_translation_divide(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, constants.highest_rounds_per_second - constants.lowest_rounds_per_second)
        set_translation_multiply(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, max_rof_impact_damage_scale - 1)
        set_translation_add(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, 1)
        set_translation_divide(0, e_weapon_barrel_stat.impact_damage_multiplier, constants.base_damage, e_weapon_barrel_stat.impact_damage_multiplier)
        set_translation_multiply(0, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.sustained_max_multiplier)




        set_translation_copy(0, e_weapon_barrel_stat.sustained_max_multiplier, constants.sustain_damage)

        set_translation_multiply(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.sustained_acquire_rate, sustain_damage_acquire_time_scale)
        set_translation_multiply(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.sustained_acquire_rate, magazine_size_column)
        set_translation_divide(0, e_weapon_barrel_stat.sustained_acquire_rate, 1, e_weapon_barrel_stat.sustained_acquire_rate)




        set_translation_copy(0, e_weapon_barrel_stat.precision_damage_fraction, constants.precision_damage - 1)























    def set_stat_indexes(weapon_sheet):
        investment_rate_of_fire = get_stat_index(weapon_sheet, e_investment_weapon_stats.rate_of_fire)
        investment_optics = get_stat_index(weapon_sheet, e_investment_weapon_stats.optics)
        investment_reload = get_stat_index(weapon_sheet, e_investment_weapon_stats.reload)
        investment_handling = get_stat_index(weapon_sheet, e_investment_weapon_stats.weapon_agility)
        investment_magazine_size = get_stat_index(weapon_sheet, e_investment_weapon_stats.clip_size)
        investment_accuracy = get_stat_index(weapon_sheet, e_investment_weapon_stats.initial_accuracy)
        investment_stability = get_stat_index(weapon_sheet, e_investment_weapon_stats.stability)
        investment_range = get_stat_index(weapon_sheet, e_investment_weapon_stats.projectile_range)
        investment_base_damage = 0
        investment_sustain_damage = 0
        investment_precision_damage = 0




    def set_weapon_stat(stat, value):
        weapon_interface.get_stat(stat).set_base_value(value)

    def get_weapon_stat(stat):
        return weapon_interface.get_stat(stat).get_base_value()




    def set_barrel_stat(stat, value):
        weapon_barrel_interface.get_stat(stat).set_base_value(value)

    def get_barrel_stat(stat):
        return weapon_barrel_interface.get_stat(stat).get_base_value()




    def set_magazn_stat(stat, value):
        weapon_magazine_interface.get_stat(stat).set_base_value(value)

    def get_magazn_stat(stat):
        return weapon_magazine_interface.get_stat(stat).get_base_value()




    def set_reload_stat(stat, value):
        weapon_reload_interface.get_stat(stat).set_base_value(value)

    def get_reload_stat(stat):
        return weapon_reload_interface.get_stat(stat).get_base_value()




    def set_trigger_behavior(value):
        weapon_trigger_interface.set_normal_trigger_behavior(value)
        weapon_trigger_interface.set_zoomed_trigger_behavior(value)

    def get_trigger_behavior():
        return weapon_trigger_interface.get_normal_trigger_behavior()




    def import_rate_of_fire_stats(index, sniper_rifle_rate_of_fire, sniper_rifle_shots_per_fire):
        rate_of_fire[index].sniper_rifle_rate_of_fire = sniper_rifle_rate_of_fire
        rate_of_fire[index].sniper_rifle_shots_per_fire = sniper_rifle_shots_per_fire

    def import_optics_stats(index, sniper_rifle_zoom_amount, sniper_rifle_ads_accuracy_scaling):
        optics[index].sniper_rifle_zoom_amount = sniper_rifle_zoom_amount
        optics[index].sniper_rifle_ads_accuracy_scaling = sniper_rifle_ads_accuracy_scaling

    def import_reload_stats(index, sniper_rifle_reload_full_time, sniper_rifle_reload_empty_time):
        reload[index].sniper_rifle_reload_full_time = sniper_rifle_reload_full_time
        reload[index].sniper_rifle_reload_empty_time = sniper_rifle_reload_empty_time

    def import_handling_stats(index, sniper_rifle_reload_full_time, sniper_rifle_reload_empty_time, sniper_rifle_ready_time, sniper_rifle_put_away_duration, sniper_rifle_ads_time):
        handling[index].sniper_rifle_reload_full_time = sniper_rifle_reload_full_time
        handling[index].sniper_rifle_reload_empty_time = sniper_rifle_reload_empty_time
        handling[index].sniper_rifle_ready_time = sniper_rifle_ready_time
        handling[index].sniper_rifle_put_away_duration = sniper_rifle_put_away_duration
        handling[index].sniper_rifle_ads_time = sniper_rifle_ads_time

    def import_magazine_size_stats(index, sniper_rifle_magazine_size):
        magazine_size[index].sniper_rifle_magazine_size = sniper_rifle_magazine_size

    def import_accuracy_stats(index, sniper_rifle_initial_error):
        accuracy[index].sniper_rifle_initial_error = sniper_rifle_initial_error

    def import_stability_stats(index, sniper_rifle_final_error, sniper_rifle_ads_move_penality_scale, sniper_rifle_recoil_scale):
        stability[index].sniper_rifle_final_error = sniper_rifle_final_error
        stability[index].sniper_rifle_ads_move_penality_scale = sniper_rifle_ads_move_penality_scale
        stability[index].sniper_rifle_recoil_scale = sniper_rifle_recoil_scale

    def import_range_stats(index, sniper_rifle_range_scale):
        range[index].sniper_rifle_range_scale = sniper_rifle_range_scale

    def import_base_damage_stats(index, sniper_rifle_base_dps):
        base_damage[index].sniper_rifle_base_dps = sniper_rifle_base_dps

    def import_sustain_damage_stats(index, sniper_rifle_sustain_damage_scale):
        sustain_damage[index].sniper_rifle_sustain_damage_scale = sniper_rifle_sustain_damage_scale

    def import_precision_damage_stats(index, sniper_rifle_precision_body_damage_scale, sniper_rifle_precision_shield_damage_scale):
        precision_damage[index].sniper_rifle_precision_body_damage_scale = sniper_rifle_precision_body_damage_scale
        precision_damage[index].sniper_rifle_precision_shield_damage_scale = sniper_rifle_precision_shield_damage_scale






    def weapon_stats_interface.translate_stats(weapon_sheet):
        finalize_interfaces()

        set_stat_indexes(weapon_sheet)

        lowest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(rate_of_fire[0].sniper_rifle_rate_of_fire, rate_of_fire[0].sniper_rifle_shots_per_fire)
        highest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(rate_of_fire[6].sniper_rifle_rate_of_fire, rate_of_fire[6].sniper_rifle_shots_per_fire)

        group_id = get_group_index(weapon_sheet)
        if group_id == enum_to_int(e_sniper_rifle_type.sniper_rifle):
            translate_sniper_rifle_stats(sr)

        apply_stats(sr)


    def finalize_interfaces():
        weapon_interface = get_object().find_interface(i_weapon)
        weapon_barrel_interface = get_object().find_interface(i_weapon_barrel)
        weapon_magazine_interface = get_object().find_interface(i_weapon_magazine)
        weapon_reload_interface = get_object().find_interface(i_weapon_reload)
        weapon_trigger_interface = get_object().find_interface(i_weapon_trigger)
        weapon_input_interface = find_interface(i_weapon_input)
        channel_manager = find_interface(i_channel_manager)




    def import():
        build_import_tables()




        for index in range(rate_of_fire.maximum_count()):
            rate_of_fire.new()

        import_rate_of_fire_stats(0, 1, 0)
        import_rate_of_fire_stats(1, 1, 0)
        import_rate_of_fire_stats(2, 1.333, 0)
        import_rate_of_fire_stats(3, 1.333, 0)
        import_rate_of_fire_stats(4, 1.5, 0)
        import_rate_of_fire_stats(5, 1.5, 0)
        import_rate_of_fire_stats(6, 2, 0)




        for index in range(optics.maximum_count()):
            optics.new()

        import_optics_stats(0, 5, 0.1)
        import_optics_stats(1, 5, 0.083)
        import_optics_stats(2, 5, 0.067)
        import_optics_stats(3, 5, 0.05)
        import_optics_stats(4, 5, 0.033)
        import_optics_stats(5, 5, 0.017)
        import_optics_stats(6, 5, 0)




        for index in range(reload.maximum_count()):
            reload.new()

        import_reload_stats(0, 3.943, 3.943)
