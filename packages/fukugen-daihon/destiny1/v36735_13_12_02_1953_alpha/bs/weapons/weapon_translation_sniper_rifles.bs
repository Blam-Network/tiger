        import_magazine_size_stats(6, 7)




        for index in range(accuracy.maximum_count()):
            accuracy.new()

        import_accuracy_stats(0, 3.5)
        import_accuracy_stats(1, 3.5)
        import_accuracy_stats(2, 3.5)
        import_accuracy_stats(3, 3.5)
        import_accuracy_stats(4, 3.5)
        import_accuracy_stats(5, 3.5)
        import_accuracy_stats(6, 3.5)




        for index in range(stability.maximum_count()):
            stability.new()

        import_stability_stats(0, 0, 0, 1)
        import_stability_stats(1, 0, 0, 0.88)
        import_stability_stats(2, 0, 0, 0.76)
        import_stability_stats(3, 0, 0, 0.64)
        import_stability_stats(4, 0, 0, 0.52)
        import_stability_stats(5, 0, 0, 0.4)
        import_stability_stats(6, 0, 0, 0.28)




        for index in range(range.maximum_count()):
            range.new()

        import_range_stats(0, 1)
        import_range_stats(1, 1)
        import_range_stats(2, 1)
        import_range_stats(3, 1)
        import_range_stats(4, 1)
        import_range_stats(5, 1)
        import_range_stats(6, 1)




        for index in range(base_damage.maximum_count()):
            base_damage.new()

        import_base_damage_stats(0, 117)
        import_base_damage_stats(1, 117)
        import_base_damage_stats(2, 117)
        import_base_damage_stats(3, 117)
        import_base_damage_stats(4, 117)
        import_base_damage_stats(5, 117)
