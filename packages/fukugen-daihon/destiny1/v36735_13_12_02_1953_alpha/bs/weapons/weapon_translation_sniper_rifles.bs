        import_reload_stats(2, 3.336, 3.336)
        import_reload_stats(3, 3.033, 3.033)
        import_reload_stats(4, 2.73, 2.73)
        import_reload_stats(5, 2.426, 2.426)
        import_reload_stats(6, 2.123, 2.123)




        for index in range(handling.maximum_count()):
            handling.new()

        import_handling_stats(0, 3.943, 3.943, 1.2, 0.433, 0.6)
        import_handling_stats(1, 3.64, 3.64, 1.1, 0.4, 0.566)
        import_handling_stats(2, 3.336, 3.336, 1, 0.367, 0.533)
        import_handling_stats(3, 3.033, 3.033, 0.9, 0.333, 0.5)
        import_handling_stats(4, 2.73, 2.73, 0.8, 0.3, 0.466)
        import_handling_stats(5, 2.426, 2.426, 0.7, 0.267, 0.433)
        import_handling_stats(6, 2.123, 2.123, 0.6, 0.233, 0.4)




        for index in range(magazine_size.maximum_count()):
            magazine_size.new()

        import_magazine_size_stats(0, 1)
