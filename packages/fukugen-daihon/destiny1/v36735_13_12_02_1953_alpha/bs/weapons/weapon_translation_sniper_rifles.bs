        return true










    def translate_sniper_rifle_stats(sr):

        sr.trigger_behavior = e_trigger_behavior._weapon_trigger_behavior_latch

        sr.rate_of_fire = rate_of_fire[investment_rate_of_fire].sniper_rifle_rate_of_fire
        sr.shots_per_fire = rate_of_fire[investment_rate_of_fire].sniper_rifle_shots_per_fire
        local magazine_size = self.magazine_size[investment_magazine_size].sniper_rifle_magazine_size
        sr.reload_full_time = handling[investment_handling].sniper_rifle_reload_full_time
        sr.reload_empty_time = handling[investment_handling].sniper_rifle_reload_empty_time
        sr.ready_time = handling[investment_handling].sniper_rifle_ready_time
        sr.put_away_duration = handling[investment_handling].sniper_rifle_put_away_duration
        sr.ads_time = handling[investment_handling].sniper_rifle_ads_time
        sr.zoom_amount = optics[investment_optics].sniper_rifle_zoom_amount
        ads_accuracy_scale = optics[investment_optics].sniper_rifle_ads_accuracy_scaling
        initial_error = accuracy[investment_accuracy].sniper_rifle_initial_error
        final_error = stability[investment_stability].sniper_rifle_final_error
        sr.ads_movement_penality_scale = stability[investment_stability].sniper_rifle_ads_move_penality_scale
        sr.recoil_scale = stability[investment_stability].sniper_rifle_recoil_scale
        range_scale = range[investment_range].sniper_rifle_range_scale
        base_dps = base_damage[investment_base_damage].sniper_rifle_base_dps
        sr.sustain_damage_scale = sustain_damage[investment_sustain_damage].sniper_rifle_sustain_damage_scale
        sr.precision_body_damage_scale = precision_damage[investment_precision_damage].sniper_rifle_precision_body_damage_scale
        sr.precision_shield_damage_scale = precision_damage[investment_precision_damage].sniper_rifle_precision_shield_damage_scale

        sr.rounds_fired_per_second = weapon_utils.get_frame_bound_rounds_per_second(sr.rate_of_fire, sr.shots_per_fire)
        sr.fire_recovery_time = weapon_utils.get_fire_recovery_time(0, sr.rate_of_fire, sr.shots_per_fire)
        sr.soft_recovery_fraction = 0.2
        sr.rounds_reloaded = weapon_utils.get_rounds_reloaded(rate_of_fire[0].sniper_rifle_rate_of_fire, sr.rate_of_fire, magazine_size, sr.shots_per_fire)
        sr.rounds_total_initial = sr.rounds_reloaded * initial_ammo_scale
        sr.rounds_total_max = sr.rounds_reloaded * total_ammo_scale
        sr.minimum_respawn_rounds = sr.rounds_reloaded * minimum_respawn_clips
        sr.autoaim_angle = 0.8 * nativemathlib.degrees_to_radians
        sr.magnetism_angle = 1.6 * nativemathlib.degrees_to_radians
        sr.autoaim_falloff_distance = 20 * range_scale
        sr.autoaim_distance = 50 * range_scale
        sr.magnetism_falloff_distance = 20 * range_scale
        sr.magnetism_distance = 50 * range_scale
        sr.error_angle_low = initial_error * nativemathlib.degrees_to_radians
        sr.error_angle_high = initial_error * nativemathlib.degrees_to_radians
        sr.zoomed_error_scale_low = ads_accuracy_scale
        sr.zoomed_error_scale_high = weapon_utils.get_zoomed_error_scale_high(ads_accuracy_scale, sr.error_angle_low, sr.error_angle_high)
        sr.accuracy_offset = weapon_utils.get_accuracy_curve_offset(accuracy_scalar, sr.rate_of_fire)
        sr.error_per_recovery = weapon_utils.get_error_per_recovery(error_deceleration_time, sr.fire_recovery_time, sr.shots_per_fire)
        sr.recoil_offset = 0
        sr.impact_damage_scale = weapon_utils.get_scaled_impact_damage(highest_rounds_per_second, lowest_rounds_per_second, max_rof_impact_damage_scale, base_dps, sr.rate_of_fire, sr.shots_per_fire)
        sr.sustain_acquisition_rate = weapon_utils.get_sustain_acquisition_rate(sustain_damage_acquire_time_scale, sr.rate_of_fire, sr.shots_per_fire, magazine_size)
        sr.sustain_grace_time = weapon_utils.get_sustain_grace_time(sustain_damage_grace_time_scale, magazine_size)
        sr.sustain_decay_time = weapon_utils.get_sustain_decay_time(sustain_damage_decay_time_scale, magazine_size)
        weapon_input = weapon_input_interface.get_weapon_input()
        weapon_input.set_primary_trigger_initial_threshold(0.45)
        weapon_input.set_primary_trigger_press_threshold(0.1)
        weapon_input.set_primary_trigger_release_threshold(0.01)




    def apply_stats(sr):

        set_trigger_behavior(sr.trigger_behavior)

        set_barrel_stat(e_weapon_barrel_stat.normal_initial_rate_of_fire, sr.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_final_rate_of_fire, sr.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_initial_rate_of_fire, sr.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_final_rate_of_fire, sr.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_minimum, sr.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_maximum, sr.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, sr.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_maximum, sr.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_fire_recovery_time, sr.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_fire_recovery_time, sr.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.normal_soft_recovery_fraction, sr.soft_recovery_fraction)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_soft_recovery_fraction, sr.soft_recovery_fraction)

        set_magazn_stat(e_weapon_magazine_stat.rounds_reloaded, sr.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.rounds_loaded_max, sr.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.minimum_respawn_rounds, sr.minimum_respawn_rounds)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_initial, sr.rounds_total_initial)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_max, sr.rounds_total_max)
        set_reload_stat(e_weapon_reload_stat.reload_duration, sr.reload_full_time)
        set_reload_stat(e_weapon_reload_stat.reload_empty_duration, sr.reload_empty_time)
        set_weapon_stat(e_weapon_stat.ready_duration, sr.ready_time)
        set_weapon_stat(e_weapon_stat.put_away_duration, sr.put_away_duration)
        set_weapon_stat(e_weapon_stat.aim_down_sights_time, sr.ads_time)

        set_weapon_stat(e_weapon_stat.forward_movement_penalty, 0)
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty, 0)
        set_weapon_stat(e_weapon_stat.forward_movement_penalty_zoomed, 0)
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty_zoomed, 0)
        set_weapon_stat(e_weapon_stat.pitch_speed_penalty_zoomed, 0)
        set_weapon_stat(e_weapon_stat.yaw_speed_penalty_zoomed, 0)

        set_weapon_stat(e_weapon_stat.zoom_level_count, zoom_level_count)
        set_weapon_stat(e_weapon_stat.zoom_magnification_minimum, sr.zoom_amount)
        set_weapon_stat(e_weapon_stat.zoom_magnification_maximum, sr.zoom_amount)
        weapon_utils.set_channel_to_scale(channel_manager, zoom_amount_channel, sr.zoom_amount)

        set_weapon_stat(e_weapon_stat.autoaim_angle, sr.autoaim_angle)
        set_weapon_stat(e_weapon_stat.magnetism_angle, sr.magnetism_angle)
        set_weapon_stat(e_weapon_stat.autoaim_distance, sr.autoaim_distance)
        set_weapon_stat(e_weapon_stat.autoaim_falloff_distance, sr.autoaim_falloff_distance)
        set_weapon_stat(e_weapon_stat.magnetism_distance, sr.magnetism_distance)
        set_weapon_stat(e_weapon_stat.magnetism_falloff_distance, sr.magnetism_falloff_distance)

        set_barrel_stat(e_weapon_barrel_stat.error_deceleration_time, error_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_low, sr.error_angle_low)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_high, sr.error_angle_high)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_low, sr.zoomed_error_scale_low)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_high, sr.zoomed_error_scale_high)
        set_barrel_stat(e_weapon_barrel_stat.firing_accuracy, sr.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_crouched_accuracy, sr.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_accuracy, sr.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_crouched_accuracy, sr.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.error_per_recovery, sr.error_per_recovery)

        set_barrel_stat(e_weapon_barrel_stat.recoil_deceleration_time, recoil_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_speed, mathlib.max(sr.rounds_fired_per_second * 2, 15) * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_return_speed, 2 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_max_angle, 0.5 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_yaw_angle, 0 * sr.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_yaw_angle, 0 * sr.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_pitch_angle, -0.1 * sr.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_pitch_angle, 20 * sr.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, 0 * sr.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, 7.5 * sr.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, 0 * sr.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle, 0 * sr.recoil_scale * nativemathlib.degrees_to_radians)
