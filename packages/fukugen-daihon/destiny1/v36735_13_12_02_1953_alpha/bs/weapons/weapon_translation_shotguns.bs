        sg.rounds_total_initial = sg.rounds_reloaded * initial_ammo_scale
        sg.rounds_total_max = weapon_utils.get_rounds_reloaded(sg.rate_of_fire, sg.rate_of_fire, backpack_size, sg.shots_per_fire)
