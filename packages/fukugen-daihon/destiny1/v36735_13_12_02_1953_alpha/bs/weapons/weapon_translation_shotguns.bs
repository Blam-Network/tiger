enum e_shotgun_type:
    shotgun
    count

struct s_shotgun : s_shotgun_constants:
    e_trigger_behavior trigger_behavior
    real rate_of_fire
    real shots_per_fire
    real rounds_fired_per_second
    real minimum_respawn_rounds
    real reload_enter_time
    real reload_continue_time
    real chamber_time
    real ready_time
    real put_away_duration
    real ads_time
    real outer_cone_degrees
    real distribution_exponent
    real yaw_count
    real pitch_count
    real ads_movement_penality_scale
    real recoil_scale
    real precision_damage_scale
    real fire_recovery_time
    real soft_recovery_fraction
    real rounds_reloaded
    real rounds_total_initial
    real rounds_total_max
    real recoil_offset
    real impact_damage_scale
    real primary_trigger_initial_threshold
    real primary_trigger_press_threshold
    real primary_trigger_release_threshold

struct s_shotgun_constants:
    real initial_rate_of_fire
    real autoaim_angle
    real magnetism_angle
    real autoaim_falloff_distance
    real autoaim_distance
    real magnetism_falloff_distance
    real magnetism_distance
    real recoil_kick_speed
    real recoil_return_speed
    real recoil_max_angle
    real recoil_kick_min_yaw_angle
    real recoil_kick_max_yaw_angle
    real recoil_kick_min_pitch_angle
    real recoil_kick_max_pitch_angle
    real recoil_kick_min_radial_yaw_angle
    real recoil_kick_max_radial_yaw_angle
    real recoil_kick_min_radial_pitch_angle
    real recoil_kick_max_radial_pitch_angle
    real lowest_rounds_per_second
    real highest_rounds_per_second
    real base_damage
    real sustain_damage
    real precision_damage
    real spread_distribution
    real spread_yaw_count
    real spread_pitch_count

struct s_reload_stats:
    real shotgun_reload_enter_time
    real shotgun_reload_continue_time
    real shotgun_chamber_time

struct s_handling_stats:
    real shotgun_ready_time
    real shotgun_put_away_duration
    real shotgun_ads_time
    real shotgun_ads_move_penality_scale

struct s_ammo_stats:
    real shotgun_magazine_size
    real shotgun_backpack_size

struct s_recoil_stats:
    real shotgun_recoil_scale

class c_weapon_translation_shotguns : c_weapon_translation_base:
    static s_shotgun_constants constants
    static static_stack<s_reload_stats, 7> reload
    static static_stack<s_handling_stats, 7> handling
    static static_stack<s_ammo_stats, 7> ammo
    static static_stack<s_recoil_stats, 7> recoil
    static real max_sc_impact_damage_scale = 1.5
    static real max_rof_impact_damage_scale = 1
    static int sc_impact_damage_scale_exponent = 2
    static real sustain_damage_acquire_time_scale = 0.5
    static real sustain_damage_grace_time_scale = 0.25
    static real sustain_damage_decay_time_scale = 0.5
    static real recoil_deceleration_time = 0.65
    static real minimum_respawn_clips
    static real initial_ammo_scale = 1
    static real total_ammo_scale = 3
    static real movement_penality_scale
    static real zoom_level_count = 1
    static real zoom_amount = 1.1
    static real recoil_scalar = 0.25
    static int simultaneous_rounds_reloaded = 1
    static string_hash recoil_stability_channel = "recoil_stability"
    static string_hash zoom_amount_channel = "zoom_amount"
    implements i_weapon_stats weapon_stats_interface  # true name unknown
    c_interface_reference weapon_interface  # true name unknown
    c_interface_reference weapon_barrel_interface  # true name unknown
    c_interface_reference weapon_magazine_interface  # true name unknown
    c_interface_reference weapon_reload_interface  # true name unknown
    c_interface_reference weapon_trigger_interface  # true name unknown
    c_interface_reference weapon_input_interface  # true name unknown
    c_interface_reference channel_manager  # true name unknown
    s_shotgun sg
    int investment_reload
    int investment_handling
    int investment_ammo
    int investment_recoil

























    static def recoil_kick_speed_calculation(kick_speed):
        return mathlib.max(kick_speed * 2, 15) * nativemathlib.degrees_to_radians

    static def initialize_constants():
        set_group_count(e_shotgun_type.count)
        add_group("shotgun", e_trigger_behavior._weapon_trigger_behavior_latch, e_trigger_behavior._weapon_trigger_behavior_latch)

        constants.initial_rate_of_fire = 0.72
        constants.autoaim_angle = 6 * nativemathlib.degrees_to_radians
        constants.magnetism_angle = 12 * nativemathlib.degrees_to_radians
        constants.autoaim_falloff_distance = 6
        constants.autoaim_distance = constants.autoaim_falloff_distance
        constants.magnetism_falloff_distance = constants.autoaim_falloff_distance
        constants.magnetism_distance = constants.autoaim_falloff_distance * 2.333
        constants.recoil_return_speed = 2 * nativemathlib.degrees_to_radians
        constants.recoil_max_angle = 0.5 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_yaw_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_yaw_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_pitch_angle = -0.1 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_pitch_angle = -20 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_radial_yaw_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_radial_yaw_angle = 7.5 * nativemathlib.degrees_to_radians
        constants.recoil_kick_min_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        constants.recoil_kick_max_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        constants.lowest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(0.72, 1)
        constants.highest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(1.32, 1)
        constants.base_damage = 180
        constants.sustain_damage = 1
        constants.precision_damage = 1.4
        constants.spread_distribution = 0.5
        constants.spread_yaw_count = 5
        constants.spread_pitch_count = 3

    static def build_import_tables():
        initialize_constants()





        set_translation_copy(0, e_weapon_stat.pitch_speed_penalty_zoomed, 0)
        set_translation_copy(0, e_weapon_stat.yaw_speed_penalty_zoomed, 0)
        set_translation_copy(0, e_weapon_barrel_stat.recoil_return_speed, constants.recoil_return_speed)
        set_translation_copy(0, e_weapon_barrel_stat.recoil_max_angle, constants.recoil_max_angle)
        set_translation_copy(0, e_weapon_stat.zoom_level_count, zoom_level_count)
        set_translation_copy(0, e_weapon_stat.autoaim_angle, constants.autoaim_angle)
        set_translation_copy(0, e_weapon_stat.magnetism_angle, constants.magnetism_angle)
        set_translation_copy(0, e_weapon_stat.autoaim_falloff_distance, constants.autoaim_falloff_distance)
        set_translation_copy(0, e_weapon_stat.magnetism_distance, constants.magnetism_distance)
        set_translation_copy(0, e_weapon_stat.magnetism_falloff_distance, constants.magnetism_falloff_distance)
        set_translation_copy(0, e_weapon_barrel_stat.recoil_deceleration_time, recoil_deceleration_time)
        set_translation_copy(0, e_weapon_stat.forward_movement_penalty, movement_penality_scale)
        set_translation_copy(0, e_weapon_stat.sideways_movement_penalty, movement_penality_scale)
        set_translation_copy(0, e_weapon_magazine_stat.minimum_respawn_rounds, 4)
        set_translation_copy(0, e_weapon_stat.zoom_magnification_minimum, zoom_amount)
        set_translation_copy(0, e_weapon_stat.zoom_magnification_maximum, zoom_amount)





        rate_of_fire_table = add_weapon_stats_table(e_investment_weapon_stats.rate_of_fire, 0, 6)
        rate_of_fire_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_initial_rate_of_fire, e_weapon_barrel_stat.normal_final_rate_of_fire, e_weapon_barrel_stat.zoomed_initial_rate_of_fire, e_weapon_barrel_stat.zoomed_final_rate_of_fire)
        shots_fired_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_shots_per_fire_minimum, e_weapon_barrel_stat.normal_shots_per_fire_maximum, e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, e_weapon_barrel_stat.zoomed_shots_per_fire_maximum)


        set_translation_row(rate_of_fire_table, 0, 0.72, 1)
        set_translation_row(rate_of_fire_table, 1, 0.82, 1)
        set_translation_row(rate_of_fire_table, 2, 0.92, 1)
        set_translation_row(rate_of_fire_table, 3, 1, 1)
        set_translation_row(rate_of_fire_table, 4, 1.12, 1)
        set_translation_row(rate_of_fire_table, 5, 1.22, 1)
        set_translation_row(rate_of_fire_table, 6, 1.32, 1)

        fire_recovery_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_fire_recovery_time, e_weapon_barrel_stat.zoomed_fire_recovery_time)
        set_translation_column(fire_recovery_column, weapon_utils.get_fire_recovery_time, 0, rate_of_fire_column, shots_fired_column)

        soft_recovery_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.normal_soft_recovery_fraction, e_weapon_barrel_stat.zoomed_soft_recovery_fraction)
        set_translation_column(soft_recovery_column, weapon_utils.get_latched_soft_recovery_fraction, fire_recovery_column)

        recoil_offset_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.firing_recoil, e_weapon_barrel_stat.firing_crouched_recoil, e_weapon_barrel_stat.firing_zoomed_recoil, e_weapon_barrel_stat.firing_zoomed_crouched_recoil)
        set_translation_column(recoil_offset_column, weapon_utils.get_recoil_curve_offset, recoil_scalar, rate_of_fire_column)

        recoil_kick_speed_column = add_column_to_table(rate_of_fire_table, e_weapon_barrel_stat.recoil_kick_speed)
        set_translation_column(recoil_kick_speed_column, weapon_utils.get_frame_bound_rounds_per_second, rate_of_fire_column, shots_fired_column)
        set_translation_column(recoil_kick_speed_column, recoil_kick_speed_calculation, recoil_kick_speed_column)





        magazine_size_table = add_weapon_stats_table(e_investment_weapon_stats.clip_size, 0, 6)
        magazine_size_column = add_column_to_table(magazine_size_table)


        set_translation_row(magazine_size_column, 0, 4)
        set_translation_row(magazine_size_column, 1, 5)
        set_translation_row(magazine_size_column, 2, 6)
        set_translation_row(magazine_size_column, 3, 7)
        set_translation_row(magazine_size_column, 4, 8)
        set_translation_row(magazine_size_column, 5, 9)
        set_translation_row(magazine_size_column, 6, 10)

        set_translation_copy(0, e_weapon_magazine_stat.rounds_reloaded, simultaneous_rounds_reloaded)

        set_translation_divide(0, e_weapon_magazine_stat.rounds_loaded_max, e_weapon_barrel_stat.normal_initial_rate_of_fire, constants.initial_rate_of_fire)
        set_translation_multiply(0, e_weapon_magazine_stat.rounds_loaded_max, e_weapon_magazine_stat.rounds_loaded_max, magazine_size_column)
        set_translation_round(0, e_weapon_magazine_stat.rounds_loaded_max, e_weapon_magazine_stat.rounds_loaded_max)

        set_translation_multiply(0, e_weapon_magazine_stat.rounds_total_initial, e_weapon_magazine_stat.rounds_loaded_max, initial_ammo_scale)
        set_translation_multiply(0, e_weapon_magazine_stat.rounds_total_max, e_weapon_magazine_stat.rounds_loaded_max, total_ammo_scale)

        sustained_grace_column = add_column_to_table(magazine_size_table, e_weapon_barrel_stat.sustained_grace_time)
        set_translation_column(sustained_grace_column, weapon_utils.get_sustain_grace_time, sustain_damage_grace_time_scale, magazine_size_column)

        sustained_decay_column = add_column_to_table(magazine_size_table, e_weapon_barrel_stat.sustained_decay_time)
        set_translation_column(sustained_decay_column, weapon_utils.get_sustain_decay_time, sustain_damage_decay_time_scale, magazine_size_column)





        handling_table = add_weapon_stats_table(e_investment_weapon_stats.weapon_agility, 0, 6)
        reload_full_column = add_column_to_table(handling_table, e_weapon_reload_stat.reload_duration)
        reload_empty_column = add_column_to_table(handling_table, e_weapon_reload_stat.reload_empty_duration)
        chamber_column = add_column_to_table(handling_table, e_weapon_reload_stat.chamber_duration)
        ready_column = add_column_to_table(handling_table, e_weapon_stat.ready_duration)
        put_away_time_column = add_column_to_table(handling_table, e_weapon_stat.put_away_duration)
        ads_time_column = add_column_to_table(handling_table, e_weapon_stat.aim_down_sights_time)


        set_translation_row(handling_table, 0, 0.693, 0.867, 1.571, 1.2, 0.433, 0.333)
        set_translation_row(handling_table, 1, 0.64, 0.8, 1.4, 1.1, 0.4, 0.3)
        set_translation_row(handling_table, 2, 0.586, 0.734, 1.284, 1, 0.367, 0.266)
        set_translation_row(handling_table, 3, 0.533, 0.667, 1.167, 0.9, 0.333, 0.233)
        set_translation_row(handling_table, 4, 0.48, 0.6, 1.05, 0.8, 0.3, 0.2)
        set_translation_row(handling_table, 5, 0.426, 0.534, 0.934, 0.7, 0.267, 0.166)
        set_translation_row(handling_table, 6, 0.373, 0.467, 0.817, 0.6, 0.233, 0.133)





        range_table = add_weapon_stats_table(e_investment_weapon_stats.projectile_range, 0, 6)
        spread_angle_column = add_column_to_table(range_table, e_weapon_barrel_stat.spread_angle_scale)
        targeting_distance_column = add_column_to_table(range_table, e_weapon_stat.autoaim_distance)


        set_translation_row(range_table, 0, 4, 1.667)
        set_translation_row(range_table, 1, 4, 1.778)
        set_translation_row(range_table, 2, 4, 1.889)
        set_translation_row(range_table, 3, 4, 2)
        set_translation_row(range_table, 4, 4, 2.111)
        set_translation_row(range_table, 5, 4, 2.222)
        set_translation_row(range_table, 6, 4, 2.333)

        movement_penalty_zoomed_column = add_column_to_table(handling_table, e_weapon_stat.forward_movement_penalty_zoomed, e_weapon_stat.sideways_movement_penalty_zoomed)
        set_translation_column(movement_penalty_zoomed_column, weapon_utils.get_movement_penality, zoom_amount, 0.25)

        set_translation_multiply(0, e_weapon_stat.autoaim_distance, constants.autoaim_falloff_distance, targeting_distance_column)





        stability_table = add_weapon_stats_table(e_investment_weapon_stats.stability, 0, 6)
        move_penalty_column = add_column_to_table(stability_table)
        recoil_scale_column = add_column_to_table(stability_table, e_weapon_barrel_stat.recoil_kick_min_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_pitch_angle, e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle)


        set_translation_row(stability_table, 0, 0, 1.5)
        set_translation_row(stability_table, 1, 0, 1.333)
        set_translation_row(stability_table, 2, 0, 1.167)
        set_translation_row(stability_table, 3, 0, 1)
        set_translation_row(stability_table, 4, 0, 0.857)
        set_translation_row(stability_table, 5, 0, 0.75)
        set_translation_row(stability_table, 6, 0, 0.667)

        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_yaw_angle, constants.recoil_kick_min_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_yaw_angle, constants.recoil_kick_max_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_pitch_angle, e_weapon_barrel_stat.recoil_kick_min_pitch_angle, constants.recoil_kick_min_pitch_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_pitch_angle, constants.recoil_kick_max_pitch_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, constants.recoil_kick_min_radial_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, e_weapon_barrel_stat.recoil_kick_max_radial_yaw_angle, constants.recoil_kick_max_radial_yaw_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, e_weapon_barrel_stat.recoil_kick_min_radial_pitch_angle, constants.recoil_kick_min_radial_pitch_angle)
        set_translation_multiply(0, e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle, e_weapon_barrel_stat.recoil_kick_max_radial_pitch_angle, constants.recoil_kick_max_radial_pitch_angle)







        set_translation_divide(0, e_weapon_barrel_stat.sustained_acquire_rate, 1, rate_of_fire_column)
        set_translation_divide(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.sustained_acquire_rate, weapon_utils.global_time_per_frame)
        set_translation_ceiling(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.sustained_acquire_rate)
        set_translation_multiply(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.sustained_acquire_rate, weapon_utils.global_time_per_frame)
        set_translation_divide(0, e_weapon_barrel_stat.sustained_acquire_rate, 1, e_weapon_barrel_stat.sustained_acquire_rate)
        set_translation_copy(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_acquire_rate)
        set_translation_copy(0, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.sustained_acquire_rate)


        set_translation_subtract(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, constants.lowest_rounds_per_second)
        set_translation_divide(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, constants.highest_rounds_per_second - constants.lowest_rounds_per_second)
        set_translation_multiply(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, max_rof_impact_damage_scale - 1)
        set_translation_add(0, e_weapon_barrel_stat.sustained_max_multiplier, e_weapon_barrel_stat.sustained_max_multiplier, 1)
        set_translation_divide(0, e_weapon_barrel_stat.impact_damage_multiplier, constants.base_damage, e_weapon_barrel_stat.impact_damage_multiplier)
        set_translation_multiply(0, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.sustained_max_multiplier)


        set_translation_multiply(0, e_weapon_barrel_stat.sustained_max_multiplier, constants.spread_yaw_count, constants.spread_pitch_count)
        set_translation_divide(0, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.impact_damage_multiplier, e_weapon_barrel_stat.sustained_max_multiplier)




        set_translation_copy(0, e_weapon_barrel_stat.sustained_max_multiplier, constants.sustain_damage)

        set_translation_multiply(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.sustained_acquire_rate, sustain_damage_acquire_time_scale)
        set_translation_multiply(0, e_weapon_barrel_stat.sustained_acquire_rate, e_weapon_barrel_stat.sustained_acquire_rate, magazine_size_column)
        set_translation_divide(0, e_weapon_barrel_stat.sustained_acquire_rate, 1, e_weapon_barrel_stat.sustained_acquire_rate)




        set_translation_copy(0, e_weapon_barrel_stat.precision_damage_fraction, constants.precision_damage - 1)
















    def set_stat_indexes(weapon_sheet):
        investment_reload = get_stat_index(weapon_sheet, e_investment_weapon_stats.reload)
        investment_handling = get_stat_index(weapon_sheet, e_investment_weapon_stats.weapon_agility)
        investment_ammo = get_stat_index(weapon_sheet, e_investment_weapon_stats.clip_size)
        investment_recoil = get_stat_index(weapon_sheet, e_investment_weapon_stats.stability)




    def set_weapon_stat(stat, value):
        weapon_interface.get_stat(stat).set_base_value(value)

    def get_weapon_stat(stat):
        return weapon_interface.get_stat(stat).get_base_value()




    def set_barrel_stat(stat, value):
        weapon_barrel_interface.get_stat(stat).set_base_value(value)

    def get_barrel_stat(stat):
        return weapon_barrel_interface.get_stat(stat).get_base_value()




    def set_magazn_stat(stat, value):
        weapon_magazine_interface.get_stat(stat).set_base_value(value)

    def get_magazn_stat(stat):
        return weapon_magazine_interface.get_stat(stat).get_base_value()




    def set_reload_stat(stat, value):
        weapon_reload_interface.get_stat(stat).set_base_value(value)

    def get_reload_stat(stat):
        return weapon_reload_interface.get_stat(stat).get_base_value()




    def set_iron_sights_render_fov(value):
        weapon_interface.set_iron_sights_render_fov(value)

    def get_iron_sights_render_fov():
        return weapon_interface.get_iron_sights_render_fov()




    def set_trigger_behavior(value):
        weapon_trigger_interface.set_normal_trigger_behavior(value)
        weapon_trigger_interface.set_zoomed_trigger_behavior(value)

    def get_trigger_behavior():
        return weapon_trigger_interface.get_normal_trigger_behavior()




    def import_reload_stats(index, shotgun_reload_enter_time, shotgun_reload_continue_time, shotgun_chamber_time):
        reload[index].shotgun_reload_enter_time = shotgun_reload_enter_time
        reload[index].shotgun_reload_continue_time = shotgun_reload_continue_time
        reload[index].shotgun_chamber_time = shotgun_chamber_time

    def import_handling_stats(index, shotgun_ready_time, shotgun_put_away_duration, shotgun_ads_time, shotgun_ads_move_penality_scale):
        handling[index].shotgun_ready_time = shotgun_ready_time
        handling[index].shotgun_put_away_duration = shotgun_put_away_duration
        handling[index].shotgun_ads_time = shotgun_ads_time
        handling[index].shotgun_ads_move_penality_scale = shotgun_ads_move_penality_scale

    def import_ammo_stats(index, shotgun_magazine_size, shotgun_backpack_size):
        ammo[index].shotgun_magazine_size = shotgun_magazine_size
        ammo[index].shotgun_backpack_size = shotgun_backpack_size

