        return true










    def translate_submachine_gun_stats(smg):

        smg.trigger_behavior = e_trigger_behavior._weapon_trigger_behavior_spew
        smg.fire_mode = 0

        smg.rate_of_fire = rate_of_fire[investment_rate_of_fire].submachine_gun_rate_of_fire
        smg.shots_per_fire = rate_of_fire[investment_rate_of_fire].submachine_gun_shots_per_fire
        local magazine_size = self.magazine_size[investment_magazine_size].submachine_gun_magazine_size
        smg.reload_full_duration = handling[investment_handling].submachine_gun_reload_full_duration
        smg.reload_empty_duration = handling[investment_handling].submachine_gun_reload_empty_duration
        smg.ready_duration = handling[investment_handling].submachine_gun_ready_duration
        smg.put_away_duration = handling[investment_handling].submachine_gun_put_away_duration
        smg.ads_duration = handling[investment_handling].submachine_gun_ads_duration
        smg.zoom_amount = optics[investment_optics].submachine_gun_zoom_amount
        ads_accuracy_scale = optics[investment_optics].submachine_gun_ads_accuracy_scaling
        initial_error = accuracy[investment_accuracy].submachine_gun_initial_error
        final_error = stability[investment_stability].submachine_gun_final_error
        smg.ads_movement_penality_scale = stability[investment_stability].submachine_gun_ads_move_penality_scale
        smg.recoil_scale = stability[investment_stability].submachine_gun_recoil_scale
        range_scale = range[investment_range].submachine_gun_range_scale
        base_dps = base_damage[investment_base_damage].submachine_gun_base_dps
        smg.sustain_damage_scale = sustain_damage[investment_sustain_damage].submachine_gun_sustain_damage_scale
        smg.precision_body_damage_scale = precision_damage[investment_precision_damage].submachine_gun_precision_body_damage_scale
        smg.precision_shield_damage_scale = precision_damage[investment_precision_damage].submachine_gun_precision_shield_damage_scale

        smg.rounds_fired_per_second = weapon_utils.get_frame_bound_rounds_per_second(smg.rate_of_fire, smg.shots_per_fire)
        smg.fire_recovery_time = weapon_utils.get_fire_recovery_time(0, smg.rate_of_fire, smg.shots_per_fire)
        smg.soft_recovery_fraction = weapon_utils.get_soft_recovery_fraction(smg.trigger_behavior, smg.fire_recovery_time)
        smg.rounds_reloaded = weapon_utils.get_rounds_reloaded(rate_of_fire[0].submachine_gun_rate_of_fire, smg.rate_of_fire, magazine_size, smg.shots_per_fire)
        smg.rounds_total_initial = smg.rounds_reloaded * initial_ammo_scale
        smg.rounds_total_max = smg.rounds_reloaded * total_ammo_scale
        smg.minimum_respawn_rounds = smg.rounds_reloaded * minimum_respawn_clips
        smg.autoaim_angle = 5 * nativemathlib.degrees_to_radians
        smg.magnetism_angle = 12 * nativemathlib.degrees_to_radians
        smg.autoaim_falloff_distance = 12 * range_scale
        smg.autoaim_distance = 24 * range_scale
        smg.magnetism_falloff_distance = 12 * range_scale
        smg.magnetism_distance = 24 * range_scale
        smg.error_angle_low = initial_error * nativemathlib.degrees_to_radians
        smg.error_angle_high = final_error * nativemathlib.degrees_to_radians
        smg.zoomed_error_scale_low = ads_accuracy_scale
        smg.zoomed_error_scale_high = weapon_utils.get_zoomed_error_scale_high(ads_accuracy_scale, smg.error_angle_low, smg.error_angle_high)
        smg.accuracy_offset = weapon_utils.get_accuracy_curve_offset(accuracy_scalar, smg.rate_of_fire)
        smg.error_per_recovery = weapon_utils.get_error_per_recovery(error_deceleration_time, smg.fire_recovery_time, smg.shots_per_fire)
        smg.recoil_offset = weapon_utils.get_recoil_curve_offset(recoil_scalar, smg.rate_of_fire)
        smg.impact_damage_scale = weapon_utils.get_scaled_impact_damage(highest_rounds_per_second, lowest_rounds_per_second, max_rof_impact_damage_scale, base_dps, smg.rate_of_fire, smg.shots_per_fire)
        smg.sustain_acquisition_rate = weapon_utils.get_sustain_acquisition_rate(sustain_damage_acquire_time_scale, smg.rate_of_fire, smg.shots_per_fire, magazine_size)
        smg.sustain_grace_time = weapon_utils.get_sustain_grace_time(sustain_damage_grace_time_scale, magazine_size)
        smg.sustain_decay_time = weapon_utils.get_sustain_decay_time(sustain_damage_decay_time_scale, magazine_size)




    def apply_stats(smg):

        set_trigger_behavior(smg.trigger_behavior)

        set_barrel_stat(e_weapon_barrel_stat.normal_initial_rate_of_fire, smg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_final_rate_of_fire, smg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_initial_rate_of_fire, smg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_final_rate_of_fire, smg.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_minimum, smg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_maximum, smg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, smg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_maximum, smg.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_fire_recovery_time, smg.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_fire_recovery_time, smg.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.normal_soft_recovery_fraction, smg.soft_recovery_fraction)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_soft_recovery_fraction, smg.soft_recovery_fraction)

        set_magazn_stat(e_weapon_magazine_stat.rounds_reloaded, smg.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.rounds_loaded_max, smg.rounds_reloaded)
        set_magazn_stat(e_weapon_magazine_stat.minimum_respawn_rounds, smg.minimum_respawn_rounds)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_initial, smg.rounds_total_initial)
        set_magazn_stat(e_weapon_magazine_stat.rounds_total_max, smg.rounds_total_max)
        set_reload_stat(e_weapon_reload_stat.reload_duration, smg.reload_full_duration)
        set_reload_stat(e_weapon_reload_stat.reload_empty_duration, smg.reload_empty_duration)
        set_weapon_stat(e_weapon_stat.ready_duration, smg.ready_duration)
        set_weapon_stat(e_weapon_stat.put_away_duration, smg.put_away_duration)
        set_weapon_stat(e_weapon_stat.aim_down_sights_time, smg.ads_duration)

        set_weapon_stat(e_weapon_stat.forward_movement_penalty, movement_penality_scale)
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty, movement_penality_scale)
        set_weapon_stat(e_weapon_stat.forward_movement_penalty_zoomed, weapon_utils.get_movement_penality(smg.zoom_amount, 0.25))
        set_weapon_stat(e_weapon_stat.sideways_movement_penalty_zoomed, weapon_utils.get_movement_penality(smg.zoom_amount, 0.25))
        set_weapon_stat(e_weapon_stat.pitch_speed_penalty_zoomed, 0)
        set_weapon_stat(e_weapon_stat.yaw_speed_penalty_zoomed, 0)

        set_weapon_stat(e_weapon_stat.zoom_level_count, zoom_level_count)
        set_weapon_stat(e_weapon_stat.zoom_magnification_minimum, smg.zoom_amount)
        set_weapon_stat(e_weapon_stat.zoom_magnification_maximum, smg.zoom_amount)
        weapon_utils.set_channel_to_scale(channel_manager, zoom_amount_channel, smg.zoom_amount)

        set_weapon_stat(e_weapon_stat.autoaim_angle, smg.autoaim_angle)
        set_weapon_stat(e_weapon_stat.magnetism_angle, smg.magnetism_angle)
        set_weapon_stat(e_weapon_stat.autoaim_distance, smg.autoaim_distance)
        set_weapon_stat(e_weapon_stat.autoaim_falloff_distance, smg.autoaim_falloff_distance)
        set_weapon_stat(e_weapon_stat.magnetism_distance, smg.magnetism_distance)
        set_weapon_stat(e_weapon_stat.magnetism_falloff_distance, smg.magnetism_falloff_distance)

        set_barrel_stat(e_weapon_barrel_stat.error_deceleration_time, error_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_low, smg.error_angle_low)
        set_barrel_stat(e_weapon_barrel_stat.error_angle_high, smg.error_angle_high)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_low, smg.zoomed_error_scale_low)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_error_scale_high, smg.zoomed_error_scale_high)
        set_barrel_stat(e_weapon_barrel_stat.firing_accuracy, smg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_crouched_accuracy, smg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_accuracy, smg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.firing_zoomed_crouched_accuracy, smg.accuracy_offset)
        set_barrel_stat(e_weapon_barrel_stat.error_per_recovery, smg.error_per_recovery)

        set_barrel_stat(e_weapon_barrel_stat.recoil_deceleration_time, recoil_deceleration_time)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_speed, mathlib.max(smg.rounds_fired_per_second * 2, 15) * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_return_speed, 15 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_max_angle, 1 * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_yaw_angle, 0 * smg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_yaw_angle, 0 * smg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_pitch_angle, -0.7 * smg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_max_pitch_angle, -0.7 * smg.recoil_scale * nativemathlib.degrees_to_radians)
        set_barrel_stat(e_weapon_barrel_stat.recoil_kick_min_radial_yaw_angle, 0.5 * smg.recoil_scale * nativemathlib.degrees_to_radians)
