        import_accuracy_stats(5, 0.525)
        import_accuracy_stats(6, 0.5)




        for index in range(stability.maximum_count()):
            stability.new()

        import_stability_stats(0, 3.25, 0, 0.4)
        import_stability_stats(1, 3, 0, 0.367)
        import_stability_stats(2, 2.75, 0, 0.333)
        import_stability_stats(3, 2.5, 0, 0.3)
        import_stability_stats(4, 2.25, 0, 0.267)
        import_stability_stats(5, 2, 0, 0.233)
        import_stability_stats(6, 1.75, 0, 0.2)




        for index in range(range.maximum_count()):
            range.new()

        import_range_stats(0, 1)
        import_range_stats(1, 1)
        import_range_stats(2, 1)
        import_range_stats(3, 1)
        import_range_stats(4, 1)
