        lb.shots_per_fire = 6
        bursts_per_second = 1
        magazine_size = 5
        lb.reload_full_duration = 3.333
        lb.reload_empty_duration = 3.333
        lb.zoom_amount = 1.6
        ads_accuracy_scale = 0.85
        initial_error = 2.5
        base_dps = 240
        lb.precision_damage_scale = 1.24
        lb.rounds_fired_per_second = weapon_utils.get_frame_bound_rounds_per_second(lb.rate_of_fire, lb.shots_per_fire)

        lb.fire_recovery_time = weapon_utils.get_fire_recovery_time(burst_rate_of_fire, bursts_per_second, lb.shots_per_fire)

        lb.soft_recovery_fraction = weapon_utils.get_soft_recovery_fraction(lb.trigger_behavior, lb.fire_recovery_time)
        lb.rounds_reloaded = weapon_utils.get_rounds_reloaded(bursts_per_second, bursts_per_second, magazine_size, lb.shots_per_fire)
        lb.rounds_total_initial = lb.rounds_reloaded * initial_ammo_scale
        lb.rounds_total_max = lb.rounds_reloaded * total_ammo_scale
        lb.minimum_respawn_rounds = lb.rounds_reloaded * minimum_respawn_clips
        lb.autoaim_angle = 4 * nativemathlib.degrees_to_radians
        lb.magnetism_angle = 8 * nativemathlib.degrees_to_radians
        lb.autoaim_falloff_distance = 18
        lb.autoaim_distance = 18
        lb.magnetism_falloff_distance = 18
        lb.magnetism_distance = 27
        lb.error_angle_low = initial_error * nativemathlib.degrees_to_radians
        lb.error_angle_high = final_error * nativemathlib.degrees_to_radians
        lb.zoomed_error_scale_low = ads_accuracy_scale
        lb.zoomed_error_scale_high = weapon_utils.get_zoomed_error_scale_high(ads_accuracy_scale, lb.error_angle_low, lb.error_angle_high)
        lb.accuracy_offset = weapon_utils.get_accuracy_curve_offset(accuracy_scalar, lb.rate_of_fire)
        lb.error_per_recovery = weapon_utils.get_error_per_recovery(error_deceleration_time, lb.fire_recovery_time, lb.shots_per_fire)
        lb.recoil_offset = weapon_utils.get_recoil_curve_offset(recoil_scalar, lb.rate_of_fire)
        lb.impact_damage_scale = base_dps / lb.shots_per_fire
        lb.ads_movement_penality_scale = weapon_utils.get_movement_penality(lb.zoom_amount, ads_movement_penality_scale)




