    def translate_laser_blaster_stats(lb):

        lb.charge_time = charge_time[investment_charge_time].laser_blaster_charge_time
        lb.ready_duration = handling[investment_handling].laser_blaster_ready_duration
        lb.put_away_duration = handling[investment_handling].laser_blaster_put_away_duration
