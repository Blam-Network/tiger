    def set_stat_indexes(weapon_sheet):
        investment_rate_of_fire = get_stat_index(weapon_sheet, e_investment_weapon_stats.rate_of_fire)
        investment_optics = get_stat_index(weapon_sheet, e_investment_weapon_stats.optics)
        investment_reload = get_stat_index(weapon_sheet, e_investment_weapon_stats.reload)
        investment_handling = get_stat_index(weapon_sheet, e_investment_weapon_stats.weapon_agility)
        investment_magazine_size = get_stat_index(weapon_sheet, e_investment_weapon_stats.clip_size)
        investment_accuracy = get_stat_index(weapon_sheet, e_investment_weapon_stats.initial_accuracy)
        investment_stability = get_stat_index(weapon_sheet, e_investment_weapon_stats.stability)
        investment_range = get_stat_index(weapon_sheet, e_investment_weapon_stats.projectile_range)
        investment_base_damage = 0
        investment_sustain_damage = 0
        investment_precision_damage = 0
        network_set_dirty()




    def set_weapon_stat(stat, value):
        weapon_interface.get_stat(stat).set_base_value(value)

    def get_weapon_stat(stat):
        return weapon_interface.get_stat(stat).get_base_value()




    def set_barrel_stat(stat, value):
        weapon_barrel_interface.get_stat(stat).set_base_value(value)

    def get_barrel_stat(stat):
        return weapon_barrel_interface.get_stat(stat).get_base_value()




    def set_magazn_stat(stat, value):
        weapon_magazine_interface.get_stat(stat).set_base_value(value)

    def get_magazn_stat(stat):
        return weapon_magazine_interface.get_stat(stat).get_base_value()




    def set_reload_stat(stat, value):
        weapon_reload_interface.get_stat(stat).set_base_value(value)

    def get_reload_stat(stat):
        return weapon_reload_interface.get_stat(stat).get_base_value()




    def set_iron_sights_render_fov(value):
        weapon_interface.set_iron_sights_render_fov(value)

    def get_iron_sights_render_fov():
        return weapon_interface.get_iron_sights_render_fov()




    def set_trigger_behavior(value):
        weapon_trigger_interface.set_normal_trigger_behavior(value)
        weapon_trigger_interface.set_zoomed_trigger_behavior(value)

    def get_trigger_behavior():
        return weapon_trigger_interface.get_normal_trigger_behavior()




    def import_rate_of_fire_stats(index, auto_rate_of_fire, pulse_rate_of_fire, scout_rate_of_fire, auto_shots_per_fire, pulse_shots_per_fire, scout_shots_per_fire):
        rate_of_fire[index].auto_rate_of_fire = auto_rate_of_fire
        rate_of_fire[index].pulse_rate_of_fire = pulse_rate_of_fire
        rate_of_fire[index].scout_rate_of_fire = scout_rate_of_fire
        rate_of_fire[index].auto_shots_per_fire = auto_shots_per_fire
        rate_of_fire[index].pulse_shots_per_fire = pulse_shots_per_fire
        rate_of_fire[index].scout_shots_per_fire = scout_shots_per_fire

    def import_optics_stats(index, auto_zoom_amount, pulse_zoom_amount, scout_zoom_amount, auto_ads_accuracy_scaling, pulse_ads_accuracy_scaling, scout_ads_accuracy_scaling):
        optics[index].auto_zoom_amount = auto_zoom_amount
        optics[index].pulse_zoom_amount = pulse_zoom_amount
        optics[index].scout_zoom_amount = scout_zoom_amount
        optics[index].auto_ads_accuracy_scaling = auto_ads_accuracy_scaling
        optics[index].pulse_ads_accuracy_scaling = pulse_ads_accuracy_scaling
        optics[index].scout_ads_accuracy_scaling = scout_ads_accuracy_scaling

    def import_reload_stats(index, auto_reload_full_duration, pulse_reload_full_duration, scout_reload_full_duration, auto_reload_empty_duration, pulse_reload_empty_duration, scout_reload_empty_duration):
        reload[index].auto_reload_full_duration = auto_reload_full_duration
        reload[index].pulse_reload_full_duration = pulse_reload_full_duration
        reload[index].scout_reload_full_duration = scout_reload_full_duration
        reload[index].auto_reload_empty_duration = auto_reload_empty_duration
        reload[index].pulse_reload_empty_duration = pulse_reload_empty_duration
        reload[index].scout_reload_empty_duration = scout_reload_empty_duration

    def import_handling_stats(index, auto_reload_full_duration, pulse_reload_full_duration, scout_reload_full_duration, auto_reload_empty_duration, pulse_reload_empty_duration, scout_reload_empty_duration, auto_ready_duration, pulse_ready_duration, scout_ready_duration, auto_put_away_duration, pulse_put_away_duration, scout_put_away_duration, auto_ads_duration, pulse_ads_duration, scout_ads_duration):
        handling[index].auto_reload_full_duration = auto_reload_full_duration
        handling[index].pulse_reload_full_duration = pulse_reload_full_duration
        handling[index].scout_reload_full_duration = scout_reload_full_duration
        handling[index].auto_reload_empty_duration = auto_reload_empty_duration
        handling[index].pulse_reload_empty_duration = pulse_reload_empty_duration
        handling[index].scout_reload_empty_duration = scout_reload_empty_duration
        handling[index].auto_ready_duration = auto_ready_duration
        handling[index].pulse_ready_duration = pulse_ready_duration
        handling[index].scout_ready_duration = scout_ready_duration
        handling[index].auto_put_away_duration = auto_put_away_duration
        handling[index].pulse_put_away_duration = pulse_put_away_duration
        handling[index].scout_put_away_duration = scout_put_away_duration
        handling[index].auto_ads_duration = auto_ads_duration
        handling[index].pulse_ads_duration = pulse_ads_duration
        handling[index].scout_ads_duration = scout_ads_duration

