        ar.recoil_kick_max_pitch_angle = -2.5 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_yaw_angle = 0.3 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_yaw_angle = 1.5 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_pitch_angle = 0 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_pitch_angle = 0 * ar.recoil_scale * nativemathlib.degrees_to_radians
