    def weapon_stats_interface.translate_stats(weapon_sheet):
        finalize_interfaces()

        set_stat_indexes(weapon_sheet)

        lowest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(rate_of_fire[0].scout_rate_of_fire, rate_of_fire[0].scout_shots_per_fire)
        highest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(rate_of_fire[6].auto_rate_of_fire, rate_of_fire[6].auto_shots_per_fire)

        group_id = get_group_index(weapon_sheet)
        if group_id == enum_to_int(e_assault_rifle_type.auto):
            translate_auto_stats(ar)

        elif group_id == enum_to_int(e_assault_rifle_type.pulse):
            translate_pulse_stats(ar)

        elif group_id == enum_to_int(e_assault_rifle_type.scout):
            translate_scout_stats(ar)

        apply_stats(ar)


    def finalize_interfaces():
        weapon_interface = get_object().find_interface(i_weapon)
        weapon_barrel_interface = get_object().find_interface(i_weapon_barrel)
        weapon_magazine_interface = get_object().find_interface(i_weapon_magazine)
        weapon_reload_interface = get_object().find_interface(i_weapon_reload)
        weapon_trigger_interface = get_object().find_interface(i_weapon_trigger)
        weapon_input_interface = find_interface(i_weapon_input)
        channel_manager = find_interface(i_channel_manager)




    def import():

        build_import_tables()




        for index in range(rate_of_fire.maximum_count()):
            rate_of_fire.new()

        import_rate_of_fire_stats(0, 6, 2, 3.334, 0, 3, 1)
        import_rate_of_fire_stats(1, 7.5, 2, 3.334, 0, 3, 1)
        import_rate_of_fire_stats(2, 7.5, 2, 3.334, 0, 3, 1)
        import_rate_of_fire_stats(3, 10, 2, 3.334, 0, 3, 1)
