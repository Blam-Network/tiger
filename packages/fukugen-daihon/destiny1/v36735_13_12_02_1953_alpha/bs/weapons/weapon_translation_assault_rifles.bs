    def translate_auto_stats(ar):

        ar.trigger_behavior = e_trigger_behavior._weapon_trigger_behavior_spew
        ar.ar_type = 0

        ar.rate_of_fire = rate_of_fire[investment_rate_of_fire].auto_rate_of_fire
        ar.shots_per_fire = rate_of_fire[investment_rate_of_fire].auto_shots_per_fire
        local magazine_size = self.magazine_size[investment_magazine_size].auto_magazine_size
        ar.reload_full_duration = reload[investment_reload].auto_reload_full_duration
        ar.reload_empty_duration = reload[investment_reload].auto_reload_empty_duration
        ar.ready_duration = handling[investment_handling].auto_ready_duration
        ar.put_away_duration = handling[investment_handling].auto_put_away_duration
        ar.ads_duration = handling[investment_handling].auto_ads_duration
        ar.zoom_amount = optics[investment_optics].auto_zoom_amount
        ads_accuracy_scale = optics[investment_optics].auto_ads_accuracy_scaling
        initial_error = accuracy[investment_accuracy].auto_initial_error
        final_error = stability[investment_stability].auto_final_error
        ar.ads_movement_penality_scale = stability[investment_stability].auto_ads_move_penality_scale
        ar.recoil_scale = stability[investment_stability].auto_recoil_scale
        range_scale = range[investment_range].auto_range_scale
        base_dps = base_damage[investment_base_damage].auto_base_dps
        ar.sustain_damage_scale = sustain_damage[investment_sustain_damage].auto_sustain_damage_scale
        ar.precision_body_damage_scale = precision_damage[investment_precision_damage].auto_precision_body_damage_scale
        ar.precision_shield_damage_scale = precision_damage[investment_precision_damage].auto_precision_shield_damage_scale

        ar.rounds_fired_per_second = weapon_utils.get_frame_bound_rounds_per_second(ar.rate_of_fire, ar.shots_per_fire)
        ar.fire_recovery_time = weapon_utils.get_fire_recovery_time(burst_rate_of_fire, ar.rate_of_fire, ar.shots_per_fire)
        ar.soft_recovery_fraction = weapon_utils.get_soft_recovery_fraction(ar.trigger_behavior, ar.fire_recovery_time)
        ar.initial_ammo_scale = 4
        ar.total_ammo_scale = 8
        ar.minimum_respawn_clips = 4
        ar.rounds_reloaded = weapon_utils.get_rounds_reloaded(rate_of_fire[0].auto_rate_of_fire, ar.rate_of_fire, magazine_size, ar.shots_per_fire)
        ar.rounds_total_initial = ar.rounds_reloaded * ar.initial_ammo_scale
        ar.rounds_total_max = ar.rounds_reloaded * ar.total_ammo_scale
        ar.minimum_respawn_rounds = ar.rounds_reloaded * ar.minimum_respawn_clips
        ar.autoaim_angle = 2.5 * nativemathlib.degrees_to_radians
        ar.magnetism_angle = 10 * nativemathlib.degrees_to_radians
        ar.autoaim_falloff_distance = 20 * range_scale
        ar.autoaim_distance = 40 * range_scale
        ar.magnetism_falloff_distance = 20 * range_scale
        ar.magnetism_distance = 40 * range_scale
        ar.error_angle_low = initial_error * nativemathlib.degrees_to_radians
        ar.error_angle_high = final_error * nativemathlib.degrees_to_radians
        ar.zoomed_error_scale_low = ads_accuracy_scale
        ar.zoomed_error_scale_high = weapon_utils.get_zoomed_error_scale_high(ads_accuracy_scale, ar.error_angle_low, ar.error_angle_high)
        ar.accuracy_offset = weapon_utils.get_accuracy_curve_offset(accuracy_scalar, ar.rate_of_fire)
        ar.error_per_recovery = weapon_utils.get_error_per_recovery(error_deceleration_time, ar.fire_recovery_time, ar.shots_per_fire)
        ar.recoil_deceleration_time = recoil_deceleration_time
        ar.recoil_offset = 0
        ar.recoil_per_recovery = weapon_utils.get_recoil_per_recovery(recoil_scalar, recoil_deceleration_time, ar.rounds_fired_per_second, ar.fire_recovery_time, ar.shots_per_fire)
        ar.impact_damage_scale = weapon_utils.get_scaled_impact_damage(highest_rounds_per_second, lowest_rounds_per_second, max_rof_impact_damage_scale, base_dps, ar.rate_of_fire, ar.shots_per_fire)
        ar.sustain_acquisition_rate = weapon_utils.get_sustain_acquisition_rate(sustain_damage_acquire_time_scale, ar.rate_of_fire, ar.shots_per_fire, magazine_size)
        ar.sustain_grace_time = weapon_utils.get_sustain_grace_time(sustain_damage_grace_time_scale, magazine_size)
        ar.sustain_decay_time = weapon_utils.get_sustain_decay_time(sustain_damage_decay_time_scale, magazine_size)
        ar.recoil_kick_speed = 1
        ar.recoil_return_speed = ar.rate_of_fire * 0.6 * nativemathlib.degrees_to_radians
        ar.recoil_max_angle = 0.9 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_yaw_angle = 0 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_yaw_angle = -0.3 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_pitch_angle = -0.2 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_pitch_angle = -2 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_yaw_angle = 0 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_yaw_angle = 1 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_pitch_angle = 0 * ar.recoil_scale * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_pitch_angle = 0 * ar.recoil_scale * nativemathlib.degrees_to_radians




