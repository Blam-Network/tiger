    def apply_stats(ar):

        weapon_utils.set_channel_to_scale(channel_manager, ar_type_channel, ar.ar_type)
        set_trigger_behavior(ar.trigger_behavior)

        set_barrel_stat(e_weapon_barrel_stat.normal_initial_rate_of_fire, ar.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_final_rate_of_fire, ar.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_initial_rate_of_fire, ar.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_final_rate_of_fire, ar.rate_of_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_minimum, ar.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_shots_per_fire_maximum, ar.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, ar.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_shots_per_fire_maximum, ar.shots_per_fire)
        set_barrel_stat(e_weapon_barrel_stat.normal_fire_recovery_time, ar.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_fire_recovery_time, ar.fire_recovery_time)
        set_barrel_stat(e_weapon_barrel_stat.normal_soft_recovery_fraction, ar.soft_recovery_fraction)
        set_barrel_stat(e_weapon_barrel_stat.zoomed_soft_recovery_fraction, ar.soft_recovery_fraction)

