enum e_assault_rifle_type:
    auto
    pulse
    scout
    count

struct s_assault_rifle : s_assault_rifle_constants:
    unknown_80802AA8 trigger_behavior  # true name unknown
    real rate_of_fire
    real shots_per_fire
    real rounds_fired_per_second
    real fire_recovery_time
    real soft_recovery_fraction
    real rounds_reloaded
    real rounds_total_initial
    real rounds_total_max
    real minimum_respawn_rounds
    real reload_full_duration
    real reload_empty_duration
    real ready_duration
    real put_away_duration
    real ads_duration
    real movement_penality_scale
    real ads_movement_penality_scale
    real zoom_level_count
    real zoom_amount
    real error_deceleration_time
    real error_angle_low
    real error_angle_high
    real zoomed_error_scale_low
    real zoomed_error_scale_high
    real accuracy_offset
    real error_per_recovery
    real recoil_deceleration_time
    real recoil_scale
    real recoil_per_recovery
    real impact_damage_scale
    real sustain_damage_scale
    real sustain_acquisition_rate
    real sustain_grace_time
    real sustain_decay_time
    real precision_body_damage_scale
    real precision_shield_damage_scale

struct s_assault_rifle_constants:
    real ar_type
    real rate_of_fire_low
    real rate_of_fire_high
    real shots_per_fire_low
    real shots_per_fire_high
    real initial_ammo_scale
    real total_ammo_scale
    real minimum_respawn_clips
    real autoaim_angle
    real magnetism_angle
    real autoaim_falloff_distance
    real autoaim_distance
    real magnetism_falloff_distance
    real magnetism_distance
    real recoil_offset
    real recoil_kick_speed
    real recoil_return_speed
    real recoil_max_angle
    real recoil_kick_min_yaw_angle
    real recoil_kick_max_yaw_angle
    real recoil_kick_min_pitch_angle
    real recoil_kick_max_pitch_angle
    real recoil_kick_min_radial_yaw_angle
    real recoil_kick_max_radial_yaw_angle
    real recoil_kick_min_radial_pitch_angle
    real recoil_kick_max_radial_pitch_angle
    real lowest_rounds_per_second
    real highest_rounds_per_second
    real base_damage
    real sustain_damage
    real precision_damage

struct s_rate_of_fire_stats:
    real auto_rate_of_fire
    real pulse_rate_of_fire
    real scout_rate_of_fire
    real auto_shots_per_fire
    real pulse_shots_per_fire
    real scout_shots_per_fire

struct s_optics_stats:
    real auto_zoom_amount
    real pulse_zoom_amount
    real scout_zoom_amount
    real auto_ads_accuracy_scaling
    real pulse_ads_accuracy_scaling
    real scout_ads_accuracy_scaling

struct s_reload_stats:
    real auto_reload_full_duration
    real pulse_reload_full_duration
    real scout_reload_full_duration
    real auto_reload_empty_duration
    real pulse_reload_empty_duration
    real scout_reload_empty_duration

struct s_handling_stats:
    real auto_reload_full_duration
    real pulse_reload_full_duration
    real scout_reload_full_duration
    real auto_reload_empty_duration
    real pulse_reload_empty_duration
    real scout_reload_empty_duration
    real auto_ready_duration
    real pulse_ready_duration
    real scout_ready_duration
    real auto_put_away_duration
    real pulse_put_away_duration
    real scout_put_away_duration
    real auto_ads_duration
    real pulse_ads_duration
    real scout_ads_duration

struct s_magazine_size_stats:
    real auto_magazine_size
    real pulse_magazine_size
    real scout_magazine_size

struct s_accuracy_stats:
    real auto_initial_error
    real pulse_initial_error
    real scout_initial_error

struct s_stability_stats:
    real auto_final_error
    real pulse_final_error
    real scout_final_error
    real auto_ads_move_penality_scale
    real pulse_ads_move_penality_scale
    real scout_ads_move_penality_scale
    real auto_recoil_scale
    real pulse_recoil_scale
    real scout_recoil_scale

struct s_range_stats:
    real auto_range_scale
    real pulse_range_scale
    real scout_range_scale

struct s_base_damage_stats:
    real auto_base_dps
    real pulse_base_dps
    real scout_base_dps

struct s_sustain_damage_stats:
    real auto_sustain_damage_scale
    real pulse_sustain_damage_scale
    real scout_sustain_damage_scale

struct s_precision_damage_stats:
    real auto_precision_body_damage_scale
    real pulse_precision_body_damage_scale
    real scout_precision_body_damage_scale
    real auto_precision_shield_damage_scale
    real pulse_precision_shield_damage_scale
    real scout_precision_shield_damage_scale

class c_weapon_translation_assault_rifles : c_weapon_translation_base:
    static static_stack<s_assault_rifle_constants, 3> constants
    static static_stack<s_rate_of_fire_stats, 7> rate_of_fire
    static static_stack<s_optics_stats, 7> optics
    static static_stack<s_reload_stats, 7> reload
    static static_stack<s_handling_stats, 7> handling
    static static_stack<s_magazine_size_stats, 7> magazine_size
    static static_stack<s_accuracy_stats, 7> accuracy
    static static_stack<s_stability_stats, 7> stability
    static static_stack<s_range_stats, 7> range
    static static_stack<s_base_damage_stats, 7> base_damage
    static static_stack<s_sustain_damage_stats, 7> sustain_damage
    static static_stack<s_precision_damage_stats, 7> precision_damage
    static real sustain_damage_acquire_time_scale = 0.5
    static real sustain_damage_grace_time_scale = 0.25
    static real sustain_damage_decay_time_scale = 0.5
    static real max_rof_impact_damage_scale = 1
    static real burst_rate_of_fire = 15
    static real recoil_deceleration_time = 0.25
    static real error_deceleration_time = 1
    static real movement_penality_scale
    static real accuracy_scalar = 0.5
    static real recoil_scalar = 1
    static int zoom_level_count = 1
    static string_hash ar_type_channel = 0xB59C4DFF  # hash not cracked
    static string_hash recoil_stability_channel = "recoil_stability"
    static string_hash zoom_amount_channel = "zoom_amount"
    static string_hash semi_auto_anim_mod = "semi_auto"
    implements i_weapon_stats weapon_stats_interface  # true name unknown
    c_interface_reference weapon_interface  # true name unknown
    c_interface_reference weapon_barrel_interface  # true name unknown
    c_interface_reference weapon_magazine_interface  # true name unknown
    c_interface_reference weapon_reload_interface  # true name unknown
    c_interface_reference weapon_trigger_interface  # true name unknown
    c_interface_reference weapon_input_interface  # true name unknown
    c_interface_reference channel_manager  # true name unknown
    s_assault_rifle ar
    int investment_rate_of_fire
    int investment_optics
    int investment_reload
    int investment_handling
    int investment_magazine_size
    int investment_accuracy
    int investment_stability
    int investment_range
    int investment_base_damage
    int investment_sustain_damage
    int investment_precision_damage
    real highest_rounds_per_second
    real lowest_rounds_per_second
























    static def initialize_constants():
        set_group_count(e_assault_rifle_type.count)

        add_group("auto", e_trigger_behavior._weapon_trigger_behavior_spew, e_trigger_behavior._weapon_trigger_behavior_spew)
        add_group("pulse", e_trigger_behavior._weapon_trigger_behavior_latch, e_trigger_behavior._weapon_trigger_behavior_latch)
        add_group("scout", e_trigger_behavior._weapon_trigger_behavior_latch, e_trigger_behavior._weapon_trigger_behavior_latch)

        for index in range(get_group_count()):
            constants.new()

        initialize_AR_constants(constants[e_assault_rifle_type.auto])
        initialize_PR_constants(constants[e_assault_rifle_type.pulse])
        initialize_SR_constants(constants[e_assault_rifle_type.scout])

    static def initialize_AR_constants(ar):
        ar.ar_type = 0
        ar.rate_of_fire_low = 6
        ar.rate_of_fire_high = 15
        ar.shots_per_fire_low = 0
        ar.shots_per_fire_high = 0
        ar.initial_ammo_scale = 4
        ar.total_ammo_scale = 8
        ar.minimum_respawn_clips = 2
        ar.autoaim_angle = 2.5 * nativemathlib.degrees_to_radians
        ar.magnetism_angle = 10 * nativemathlib.degrees_to_radians
        ar.autoaim_falloff_distance = 30
        ar.autoaim_distance = 60
        ar.magnetism_falloff_distance = 30
        ar.magnetism_distance = 60
        ar.recoil_offset = 0
        ar.recoil_kick_speed = 1
        ar.recoil_return_speed = 0.5
        ar.recoil_max_angle = 2 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_yaw_angle = -0.05 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_yaw_angle = -0.25 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_pitch_angle = -1.5 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_pitch_angle = -2 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_yaw_angle = 0.1 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_yaw_angle = 0.5 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        ar.lowest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(ar.rate_of_fire_low, ar.shots_per_fire_low)
        ar.highest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(ar.rate_of_fire_high, ar.shots_per_fire_high)
        ar.base_damage = 125
        ar.sustain_damage = 1
        ar.precision_damage = 1.5

    static def initialize_PR_constants(ar):
        ar.ar_type = 0.5
        ar.rate_of_fire_low = 1.875
        ar.rate_of_fire_high = 2.312
        ar.shots_per_fire_low = 3
        ar.shots_per_fire_high = 3
        ar.initial_ammo_scale = 3
        ar.total_ammo_scale = 6
        ar.minimum_respawn_clips = 1
        ar.autoaim_angle = 2.5 * nativemathlib.degrees_to_radians
        ar.magnetism_angle = 6 * nativemathlib.degrees_to_radians
        ar.autoaim_falloff_distance = 30
        ar.autoaim_distance = 60
        ar.magnetism_falloff_distance = 30
        ar.magnetism_distance = 60
        ar.recoil_offset = 0.1
        ar.recoil_kick_speed = 0.2
        ar.recoil_return_speed = 10 * nativemathlib.degrees_to_radians
        ar.recoil_max_angle = 0.5 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_yaw_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_yaw_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_pitch_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_pitch_angle = -0.2 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_yaw_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_yaw_angle = 0.3 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        ar.lowest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(ar.rate_of_fire_low, ar.shots_per_fire_low)
        ar.highest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(ar.rate_of_fire_high, ar.shots_per_fire_high)
        ar.base_damage = 108
        ar.sustain_damage = 1
        ar.precision_damage = 1.5

    static def initialize_SR_constants(ar):
        ar.ar_type = 1
        ar.rate_of_fire_low = 2.5
        ar.rate_of_fire_high = 6
        ar.shots_per_fire_low = 1
        ar.shots_per_fire_high = 1
        ar.initial_ammo_scale = 3
        ar.total_ammo_scale = 6
        ar.minimum_respawn_clips = 1
        ar.autoaim_angle = 2.5 * nativemathlib.degrees_to_radians
        ar.magnetism_angle = 6 * nativemathlib.degrees_to_radians
        ar.autoaim_falloff_distance = 40
        ar.autoaim_distance = 80
        ar.magnetism_falloff_distance = 40
        ar.magnetism_distance = 80
        ar.recoil_offset = 0
        ar.recoil_kick_speed = 1
        ar.recoil_return_speed = 4.5 * nativemathlib.degrees_to_radians
        ar.recoil_max_angle = 1.5 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_yaw_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_yaw_angle = -0.3 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_pitch_angle = -1 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_pitch_angle = -2.5 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_yaw_angle = 0.2 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_yaw_angle = 0.5 * nativemathlib.degrees_to_radians
        ar.recoil_kick_min_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        ar.recoil_kick_max_radial_pitch_angle = 0 * nativemathlib.degrees_to_radians
        ar.lowest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(ar.rate_of_fire_low, ar.shots_per_fire_low)
        ar.highest_rounds_per_second = weapon_utils.get_frame_bound_rounds_per_second(ar.rate_of_fire_high, ar.shots_per_fire_high)
        ar.base_damage = 116
        ar.sustain_damage = 1
        ar.precision_damage = 1.5

    static def build_import_tables():

        initialize_constants()





        for group_index in range(get_group_count()):
            set_translation_copy(group_index, e_weapon_stat.forward_movement_penalty, movement_penality_scale)
            set_translation_copy(group_index, e_weapon_stat.sideways_movement_penalty, movement_penality_scale)
            set_translation_copy(group_index, e_weapon_stat.pitch_speed_penalty_zoomed, 0)
            set_translation_copy(group_index, e_weapon_stat.yaw_speed_penalty_zoomed, 0)
            set_translation_copy(group_index, e_weapon_stat.zoom_level_count, zoom_level_count)

            set_translation_copy(group_index, e_weapon_stat.autoaim_angle, constants[group_index].autoaim_angle)
            set_translation_copy(group_index, e_weapon_stat.magnetism_angle, constants[group_index].magnetism_angle)
            set_translation_copy(group_index, e_weapon_stat.autoaim_distance, constants[group_index].autoaim_distance)
            set_translation_copy(group_index, e_weapon_stat.autoaim_falloff_distance, constants[group_index].autoaim_falloff_distance)
            set_translation_copy(group_index, e_weapon_stat.magnetism_distance, constants[group_index].magnetism_distance)
            set_translation_copy(group_index, e_weapon_stat.magnetism_falloff_distance, constants[group_index].magnetism_falloff_distance)

            set_translation_copy(group_index, e_weapon_barrel_stat.error_deceleration_time, error_deceleration_time)

            set_translation_copy(group_index, e_weapon_barrel_stat.recoil_deceleration_time, recoil_deceleration_time)
            set_translation_copy(group_index, e_weapon_barrel_stat.recoil_kick_speed, constants[group_index].recoil_kick_speed)
            set_translation_copy(group_index, e_weapon_barrel_stat.recoil_return_speed, constants[group_index].recoil_return_speed)
            set_translation_copy(group_index, e_weapon_barrel_stat.recoil_max_angle, constants[group_index].recoil_max_angle)

            set_translation_copy(group_index, e_weapon_barrel_stat.firing_recoil, constants[group_index].recoil_offset)
            set_translation_copy(group_index, e_weapon_barrel_stat.firing_crouched_recoil, constants[group_index].recoil_offset)
            set_translation_copy(group_index, e_weapon_barrel_stat.firing_zoomed_recoil, constants[group_index].recoil_offset)
            set_translation_copy(group_index, e_weapon_barrel_stat.firing_zoomed_crouched_recoil, constants[group_index].recoil_offset)





        rate_of_fire_tables = add_weapon_stats_table(e_investment_weapon_stats.rate_of_fire, 0, 6)
        rate_of_fire_column = add_column_to_table(rate_of_fire_tables, e_weapon_barrel_stat.normal_initial_rate_of_fire, e_weapon_barrel_stat.normal_final_rate_of_fire, e_weapon_barrel_stat.zoomed_initial_rate_of_fire, e_weapon_barrel_stat.zoomed_final_rate_of_fire)
        shots_per_fire_column = add_column_to_table(rate_of_fire_tables, e_weapon_barrel_stat.normal_shots_per_fire_minimum, e_weapon_barrel_stat.normal_shots_per_fire_maximum, e_weapon_barrel_stat.zoomed_shots_per_fire_minimum, e_weapon_barrel_stat.zoomed_shots_per_fire_maximum)


        set_translation_row(rate_of_fire_tables, 0, 6, 1.875, 2.5, 0, 3, 1)
        set_translation_row(rate_of_fire_tables, 1, 7.5, 1.875, 3, 0, 3, 1)
        set_translation_row(rate_of_fire_tables, 2, 7.5, 2, 3, 0, 3, 1)
        set_translation_row(rate_of_fire_tables, 3, 10, 2, 3.75, 0, 3, 1)
        set_translation_row(rate_of_fire_tables, 4, 10, 2.143, 3.75, 0, 3, 1)
        set_translation_row(rate_of_fire_tables, 5, 10, 2.312, 5, 0, 3, 1)
        set_translation_row(rate_of_fire_tables, 6, 15, 2.312, 6, 0, 3, 1)


        fire_recovery_time_column = add_column_to_table(rate_of_fire_tables, e_weapon_barrel_stat.normal_fire_recovery_time, e_weapon_barrel_stat.zoomed_fire_recovery_time)
        set_translation_column(fire_recovery_time_column, weapon_utils.get_fire_recovery_time, burst_rate_of_fire, rate_of_fire_column, shots_per_fire_column)

        soft_recovery_fraction_column = add_column_to_table(rate_of_fire_tables, e_weapon_barrel_stat.normal_soft_recovery_fraction, e_weapon_barrel_stat.zoomed_soft_recovery_fraction)
        set_translation_column(soft_recovery_fraction_column, weapon_utils.get_spew_soft_recovery_fraction, fire_recovery_time_column)
        scout_soft_recovery_fraction_column = get_table_identifier(soft_recovery_fraction_column, e_assault_rifle_type.scout)
        set_translation_column(scout_soft_recovery_fraction_column, weapon_utils.copy_value, 0.2)
        pulse_soft_recovery_fraction_column = get_table_identifier(soft_recovery_fraction_column, e_assault_rifle_type.pulse)
        set_translation_column(pulse_soft_recovery_fraction_column, weapon_utils.get_latched_soft_recovery_fraction, fire_recovery_time_column)

        error_per_recovery_column = add_column_to_table(rate_of_fire_tables, e_weapon_barrel_stat.error_per_recovery)
        set_translation_column(error_per_recovery_column, weapon_utils.get_error_per_recovery, error_deceleration_time, fire_recovery_time_column, shots_per_fire_column)

        firing_accuracy_column = add_column_to_table(rate_of_fire_tables, e_weapon_barrel_stat.firing_accuracy, e_weapon_barrel_stat.firing_crouched_accuracy, e_weapon_barrel_stat.firing_zoomed_accuracy, e_weapon_barrel_stat.firing_zoomed_crouched_accuracy)
        set_translation_column(firing_accuracy_column, weapon_utils.get_accuracy_curve_offset, accuracy_scalar, rate_of_fire_column)
        pulse_firing_accuracy_column = get_table_identifier(firing_accuracy_column, e_assault_rifle_type.pulse)
        set_translation_column(pulse_firing_accuracy_column, weapon_utils.get_accuracy_curve_offset, accuracy_scalar, burst_rate_of_fire)


        recoil_per_recovery_column = add_column_to_table(rate_of_fire_tables, e_weapon_barrel_stat.recoil_per_recovery)
        set_translation_column(recoil_per_recovery_column, weapon_utils.get_frame_bound_rounds_per_second, rate_of_fire_column, shots_per_fire_column)
        set_translation_column(recoil_per_recovery_column, weapon_utils.get_recoil_per_recovery, recoil_scalar, recoil_deceleration_time, recoil_per_recovery_column, fire_recovery_time_column, shots_per_fire_column)
        pulse_recoil_per_recovery_column = get_table_identifier(recoil_per_recovery_column, e_assault_rifle_type.pulse)
        set_translation_column(pulse_recoil_per_recovery_column, weapon_utils.copy_value, 0)
        scout_recoil_per_recovery_column = get_table_identifier(recoil_per_recovery_column, e_assault_rifle_type.scout)
        set_translation_column(scout_recoil_per_recovery_column, weapon_utils.copy_value, 1)


        set_translation_copy(e_assault_rifle_type.scout, e_weapon_barrel_stat.normal_soft_recovery_fraction, 0.2)





        magazine_size_tables = add_weapon_stats_table(e_investment_weapon_stats.clip_size, 0, 6)
        magazine_size_column = add_column_to_table(magazine_size_tables)


        set_translation_row(magazine_size_tables, 0, 18, 7, 8)
        set_translation_row(magazine_size_tables, 1, 22, 8, 9)
        set_translation_row(magazine_size_tables, 2, 26, 9, 10)
        set_translation_row(magazine_size_tables, 3, 30, 10, 11)
        set_translation_row(magazine_size_tables, 4, 34, 11, 12)
        set_translation_row(magazine_size_tables, 5, 38, 12, 13)
        set_translation_row(magazine_size_tables, 6, 42, 13, 14)

        rounds_loaded_column = add_column_to_table(magazine_size_tables, e_weapon_magazine_stat.rounds_reloaded, e_weapon_magazine_stat.rounds_loaded_max)

        for group_index in range(get_group_count()):
            specific_rounds_loaded_column = get_table_identifier(rounds_loaded_column, group_index)
            set_translation_column(specific_rounds_loaded_column, weapon_utils.get_rounds_reloaded, constants[group_index].rate_of_fire_low, rate_of_fire_column, magazine_size_column, shots_per_fire_column)
            set_translation_multiply(group_index, e_weapon_magazine_stat.minimum_respawn_rounds, e_weapon_magazine_stat.rounds_reloaded, constants[group_index].minimum_respawn_clips)
            set_translation_multiply(group_index, e_weapon_magazine_stat.rounds_total_initial, e_weapon_magazine_stat.rounds_reloaded, constants[group_index].initial_ammo_scale)
            set_translation_multiply(group_index, e_weapon_magazine_stat.rounds_total_max, e_weapon_magazine_stat.rounds_reloaded, constants[group_index].total_ammo_scale)

        acquire_rate_column = add_column_to_table(magazine_size_tables, e_weapon_barrel_stat.sustained_acquire_rate)
        set_translation_column(acquire_rate_column, weapon_utils.get_sustain_acquisition_rate, sustain_damage_acquire_time_scale, rate_of_fire_column, shots_per_fire_column, magazine_size_column)

        grace_time_column = add_column_to_table(magazine_size_tables, e_weapon_barrel_stat.sustained_grace_time)
        set_translation_column(grace_time_column, weapon_utils.get_sustain_decay_time, sustain_damage_grace_time_scale, magazine_size_column)

        decay_time_column = add_column_to_table(magazine_size_tables, e_weapon_barrel_stat.sustained_decay_time)
        set_translation_column(decay_time_column, weapon_utils.get_sustain_decay_time, sustain_damage_decay_time_scale, magazine_size_column)





        weapon_handling_tables = add_weapon_stats_table(e_investment_weapon_stats.weapon_agility, 0, 6)
        add_column_to_table(weapon_handling_tables, e_weapon_reload_stat.reload_duration)
        add_column_to_table(weapon_handling_tables, e_weapon_reload_stat.reload_empty_duration)
        add_column_to_table(weapon_handling_tables, e_weapon_stat.ready_duration)
