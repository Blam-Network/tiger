    static def clear_abilities(character_settings):
        for i in range(5):
            character_settings.ability_indices[i] = 0


    static def get_preset_build(preset_index, character_settings):

        if preset_index >= 0 and preset_index <= preset_debug_build_count:
            clear_abilities(character_settings)
            character_settings.clear_all_ability_mods()
            character_settings.clear_all_character_perks()


            character_settings.character_perks[3] = find_character_perk_by_name("player_super_gain_on_kill")
            character_settings.character_perks[4] = find_character_perk_by_name("player_super_gain_on_kill_combatant")
            character_settings.character_perks[5] = find_character_perk_by_name("player_super_gain_on_capture")
            character_settings.character_perks[6] = find_character_perk_by_name("player_super_gain_on_assist")

        fixup_debug_biped_stats(preset_index, character_settings)
        weapon_settings_valid = false
        build_name = ""




        if preset_index == 0:


            build_name = "Titan_Striker_Common_0 (Soldier)"
            character_settings.character_class_index = 1
            character_settings.ability_indices[ability_slot_super] = find_ability_by_name("fist_of_havoc_super")
            character_settings.ability_indices[ability_slot_LB] = find_ability_by_name("pulse_arc")
