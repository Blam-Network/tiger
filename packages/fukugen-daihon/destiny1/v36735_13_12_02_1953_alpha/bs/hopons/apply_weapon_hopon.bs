class c_apply_weapon_hop_on : c_component:  # true name unknown
    c_hop_on_pattern hop_on_pattern  # true name unknown
    static int weapon_slot
    implements i_finalize finalize_interface  # true name unknown
    c_interface_reference inventory  # true name unknown












    def finalize_interface.finalize():
        inventory = get_object().find_interface(i_inventory)
        apply_weapon_hopon()

    def dispose():
        hop_on_pattern.delete_hop_on()

    def apply_weapon_hopon():
        if inventory:
            item = inventory.get_item(weapon_slot)
