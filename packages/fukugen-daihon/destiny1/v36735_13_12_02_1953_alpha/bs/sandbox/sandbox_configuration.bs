class c_sandbox_configuration : c_library:  # true name unknown
    static table<e_abilities, s_ability_configuration> abilities
    static table<e_character_perks, s_perk_configuration> character_perks
    static table<e_weapon_perks, s_perk_configuration> weapon_perks
    static table<e_armor_perks, s_perk_configuration> armor_perks





    static def add_mod(ability, ability_mod_name):
        abilities[ability].ability_mod_names.append(ability_mod_name)

    static def set_ability_name(ability, ability_name):
        abilities[ability].label = ability
        abilities[ability].name = ability_name

    static def set_character_perk_name(perk, perk_name):
        character_perks[perk].label = perk
        character_perks[perk].name = perk_name

    static def set_weapon_perk_name(perk, perk_name):
        weapon_perks[perk].label = perk
        weapon_perks[perk].name = perk_name

    static def set_armor_perk_name(perk, perk_name):
        armor_perks[perk].label = perk
        armor_perks[perk].name = perk_name

    def import():
        abilities.fit()
        character_perks.fit()
        weapon_perks.fit()
        armor_perks.fit()


        set_name = set_ability_name

        set_name(e_abilities.melee_guardian, "Guardian Melee")
