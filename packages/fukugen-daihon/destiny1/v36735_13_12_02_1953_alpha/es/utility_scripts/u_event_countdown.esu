def func_countdown_setup():


    i_event_countdown_setup_timer = roll_countdown_initiate_timer()
    i_event_countdown_main_timer = roll_countdown_event_timer()




    return i_event_countdown_setup_timer, i_event_countdown_main_timer







def func_countdown_event_start(i_setup_timer):
    pt_engagement_volume.reset()
    pt_engagement_volume.set_handler(pf_event_countdown_preset.po_event_countdown.d_handle_engagement_incident)
    event_globals.bind_squad_engagement(sq_event_countdown_wave[0], pf_event_countdown_preset.po_event_countdown)

    pf_event_countdown_preset.po_event_countdown.clear()
    cz_event_countdown.lock()



    sc_cover_creation.restart()

    o_event_countdown_object_spawner.create()
    dev_event_countdown_object.set_device_position(0)

    pf_event_countdown_preset.po_event_countdown.set_incoming()


    o_event_countdown_beacon.create()

    sleep(2)

    pf_event_countdown_preset.po_event_countdown.nav_point_activate(o_event_countdown_beacon)
    pf_event_countdown_preset.po_event_countdown.timer_activate(i_setup_timer)
    pf_event_countdown_preset.po_event_countdown.timer_start()
    int_event_countdown_object.enable_all_players()

    sc_seq_warsat_engage1.restart()

thread sc_cover_creation:
    for i in range(len(o_warsat_cover)):
        o_warsat_cover[i].create()
        dev_warsat_cover[i].set_device_position(0)






def func_test_countdown_engaged(i_main_timer):

    print("func_test_countdown_engaged")
    cz_event_countdown.reset()

    while not int_event_countdown_object.get_active() and not pf_event_countdown_preset.po_event_countdown.timer_is_complete():
        sleep(1)

    if pf_event_countdown_preset.po_event_countdown.timer_is_complete():
        return false

    print("INTERACTION DETECTED!")

    dev_event_countdown_object.set_device_position(0.2)

    b_event_initiated = true

    sc_ghost_scan_start.restart()
    sc_ghost_scan_start.restart()

    sc_seq_warsat_start.restart()

    sleep(1)

    pt_engagement_volume.reset()
    pf_event_countdown_preset.po_event_countdown.set_active()
    pf_event_countdown_preset.po_event_countdown.progress_bind(o_event_countdown_object_spawner)
    cz_event_countdown.unlock()
    sleep(1)

    pf_event_countdown_preset.po_event_countdown.timer_activate(i_main_timer)
    pf_event_countdown_preset.po_event_countdown.timer_start()



    return true







def func_countdown_enemy_waves():

    i = 1
    sq_current_countdown_wave_iterator = sq_event_countdown_wave[0]
    sudden_death_mode = true


    while not func_get_timer_complete() or func_in_zone():

        print("Wave: " + i)
        sq_current_countdown_wave_iterator = sq_event_countdown_wave[i]
        sq_event_countdown_wave[i].place()
        sg_countdown_total.add_child(sq_event_countdown_wave[i])
        g_i_wave_iterator = i


        obj_event_enemy_enter.add_squad(sq_current_countdown_wave_iterator)

        b_zone_enemy_max_timeout = false
        b_zone_enemy_timeout = false

        sc_zone_enemy_timeout.kill()
        sc_zone_enemy_max_timeout.kill()

        sc_zone_enemy_timeout.restart()
        sc_zone_enemy_max_timeout.restart()








        sleep_until(sg_countdown_total.alive_count() <= 0 or cz_event_countdown.is_captured() or func_get_timer_complete() and not func_in_zone() or sg_countdown_total.alive_count() <= 2 and b_zone_enemy_timeout == true or b_zone_enemy_max_timeout == true)

        if cz_event_countdown.is_captured() or func_get_timer_complete() and not func_in_zone():
            return sq_current_countdown_wave_iterator

        if i == 0 or b_zone_enemy_max_timeout == true:
            i = 0
            for i in range(len(sq_event_countdown_wave)):
                sq_event_countdown_wave[i].activate_temperament("temper_despawn")
                obj_event_enemy_exit.add_squad(sq_event_countdown_wave[i])
        else:
            i = i + 1


        if len(sq_event_countdown_wave) <= i:
            if i > 3:
                i = i - 3
                print("wave resetting")
            else:
                i = 1
                print("wave resetting to 1")
    return sq_current_countdown_wave_iterator

thread sc_zone_enemy_timeout:
    i_enemy_timeout = 30

    if g_i_wave_iterator == 1 or g_i_wave_iterator == 2:
        i_enemy_timeout = 30
    elif g_i_wave_iterator == 3:
        i_enemy_timeout = 35
    elif g_i_wave_iterator >= 4:
        i_enemy_timeout = 45

    sleep_until_timeout(1 == 0, i_enemy_timeout)
    b_zone_enemy_timeout = true

thread sc_zone_enemy_max_timeout:
    print("########## BOSS WAVE TIMEOUT")
    sleep_until_timeout(1 == 0, 90)
    b_zone_enemy_max_timeout = true
    print("########## BOSS WAVE HIT")

thread pm_working:
    while true:
        print("pm working: ", func_in_zone())
        sleep(1)

def func_in_zone():
    return pm_event_countdown_sudden_death.test_any_inside()

def func_get_timer_complete():
    return pf_event_countdown_preset.po_event_countdown.timer_is_complete()






def func_countdown_cleanup():

    o_event_countdown_beacon.delete_object()

    for i in range(len(sq_event_countdown_wave)):
        sq_event_countdown_wave[i].activate_temperament("temper_despawn")
        obj_event_enemy_exit.add_squad(sq_event_countdown_wave[i])









    pf_event_countdown_preset.po_event_countdown.clear()
    cz_event_countdown.lock()
    pt_engagement_volume.disable()
    int_event_countdown_object.clear()

    sleep_until_timeout(sg_countdown_total.count_at_firing_area() >= sg_countdown_total.alive_count(), 8)

    for i in range(len(sq_event_countdown_wave)):
        sq_event_countdown_wave[i].deactivate_temperament("temper_despawn")
        sq_event_countdown_wave[i].remove()
    sc_ghost_scan_start.sleep_forever()








thread complete:

    func_countdown_cleanup()






