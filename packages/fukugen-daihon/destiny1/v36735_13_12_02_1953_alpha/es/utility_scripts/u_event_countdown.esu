        sleep(1)
        cz_event_countdown.lock()


        dev_event_countdown_object.set_device_position(0.3)
        o_event_countdown_object_spawner.delete_object()

        for i in range(len(o_warsat_cover)):
            dev_warsat_cover[i].set_device_position(0.3)
            o_warsat_cover[i].delete_object()

