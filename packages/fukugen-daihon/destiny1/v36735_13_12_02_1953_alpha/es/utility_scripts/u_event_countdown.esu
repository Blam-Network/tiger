            elif cz_event_countdown.get_capture_progress() >= 0.33 and cz_event_countdown.get_capture_progress() < 0.66:
                pf_event_countdown_preset.po_event_countdown.set_public_event_tier(1)
                pf_event_countdown_preset.po_event_countdown.set_complete()
            elif cz_event_countdown.get_capture_progress() >= 0.66 and cz_event_countdown.get_capture_progress() < 1:
                pf_event_countdown_preset.po_event_countdown.set_public_event_tier(2)
                pf_event_countdown_preset.po_event_countdown.set_complete()

