def kill_accum_combatant_bubble(combatant_name, bubble_name, pobj, min, max):
    print("kill_accum_combatant_bubble is deprecated because it takes raw strings. Use kill_accum_combatant_bubble_hash instead.")

    pobj.progress_activate(min, max)

    kill_listener.reset()
    kill_listener.bind_audience("participant_fireteam")
    kill_listener.bind_dead_combatant_name(combatant_name)
    kill_listener.bind_bubble_name(bubble_name)

    while pobj.progress_get_current() < max:
        pobj.progress_update(kill_listener.get_count())


        sleep(1)
    pobj.progress_update(max)


















