def user_import():
    for i, obj in o_vex_cov:
        dev_vex_cov[i].import_only_bind(o_vex_cov[i])

def func_event_setup(event_po):
    o_vex_block.create()

    for i in range(len(o_vex_cov)):
        o_vex_cov[i].create()
    for i in range(len(dev_vex_cov)):
        dev_vex_cov[i].set_device_position(1)






    d_vex_block.set_device_position(1)


    il_block_kills.reset()
    il_block_kills.bind_hash(sacrifice_incident, all_players)


    kil_player_kills.reset()
    kil_player_kills.bind_audience_hash(all_players)
    kil_player_kills.bind_squad_identifier(event_squad_id)


    event_po.nav_point_activate(o_vex_block)


    create_vex_cloud_init()


    func_event_engagement_setup()


    ho_vex_death.set_filter(of_vex_death)



def func_event_start(event_po):
    event_po.set_incoming()
    event_po.timer_activate(i_setup_timer)
    event_po.timer_start()
    print("event timer started!")





def func_pre_engagement():

    print("checking for engagement")
    spawn_pre_engage_waves.restart()
    sleep_until(func_event_timer_complete() or kil_player_kills.get_count() > 0)
    spawn_pre_engage_waves.kill()
    sq_vex_cloud_init__pilot.abort_command_script()
    sq_vex_cloud_init.remove()




def func_event_engaged(event_po):




    sc_seq_vex_block_start.restart()

    pt_engagement.reset()


    event_po.timer_pause()
    event_po.timer_activate(i_event_timer)
    event_po.timer_start()
    event_po.set_active()


    event_po.progress_activate(i_dead_max, i_dead_max)


    print("sleeping for the timer...is it active? ", func_event_timer_complete())
    sleep(1)


    count_block_kills.restart()
    spawn_waves.restart()






def func_event_success(event_po):

    sc_seq_vex_block_end_gold.wake()
    if i_dead_count == 0:
        event_po.set_public_event_tier(3)
        print("Public Event Tier Gold")
        print("dead count: ", i_dead_count, i_dead_max)

    elif i_dead_count >= i_dead_max:
        event_po.set_public_event_tier(0)
        print("Public Event Tier Ribbon")
        print("dead count: ", i_dead_count, i_dead_max)

    elif i_dead_count <= i_dead_max * 0.5:
        event_po.set_public_event_tier(2)
        print("Public Event Tier Silver")
        print("dead count: ", i_dead_count, i_dead_max)

    elif i_dead_count >= i_dead_max * 0.5:
        event_po.set_public_event_tier(1)
        print("Public Event Tier Bronze")
        print("dead count: ", i_dead_count, i_dead_max)





    event_po.set_complete()

def func_event_failure(event_po):
    event_po.set_failed()
    sc_seq_vex_block_end_bronze.wake()
    sleep(3)

def func_event_cleanup(event_po):
    sleep(2)
    event_po.clear()

    ho_overshield.clear_filter()
    of_overshield.clear()
    of_vex_death.clear()

    func_remove_all_squads()
    for i in range(len(o_vex_cov)):
        o_vex_cov[i].delete_object()
    o_vex_block.delete_object()






def func_event_engagement_setup():





    event_globals.bind_squad_engagement(sq_initialize, pf_event_vex_block_preset.po_event_vex_block)


    pt_engagement.set_handler(pf_event_vex_block_preset.po_event_vex_block.d_handle_engagement_incident)
    pt_engagement.disable()






def func_set_temperament(_sq):
    _sq.activate_temperament("temper_always_walk")
    _sq.activate_temperament("temper_combat_no_self_preserve")

def func_event_timer_complete():

    return pf_event_vex_block_preset.po_event_vex_block.timer_is_complete()

def func_event_count_complete():

    return pf_event_vex_block_preset.po_event_vex_block.progress_is_complete()

def func_event_get_timer():
    return pf_event_vex_block_preset.po_event_vex_block.timer_get_current()

def func_event_get_progress_count():
    return pf_event_vex_block_preset.po_event_vex_block.progress_get_current()

def func_event_running():
    return func_event_timer_complete() == false and func_event_get_progress_count() > 0

def activate_hopon(_hopon, _of):
    _hopon.set_filter(_of)


def add_to_hopon(_of, _object):
    _of.add(_object)

def remove_from_hopon(_of, _object):
    _of.remove(_object)

def create_vex_cloud_init():
    if not sq_vex_cloud_init__pilot.is_bound():
        sq_vex_cloud_init__pilot.place()
    sleep(10)









def func_remove_all_squads():
    sq_vex_cloud_init.remove()
    sq_initialize.remove()

    for i in range(len(pf_event_vex_cloud_point)):
        pf_event_vex_cloud_point[i].sq_vex_cloud.remove()

    for i in range(len(pf_event_vex_block_wave)):
        pf_event_vex_block_wave[i].remove_squads()


script watch_for_block_death(): pass





script spawn_pre_engage_waves():

    sq_vex_cloud_init__pilot.abort_command_script()


    obj_vex_block_initial.add_squad(sq_initialize)
    set_temperaments_base(sq_initialize)

    while not func_event_timer_complete() and kil_player_kills.get_count() == 0:

        sq_vex_cloud_init__pilot.drop_squad(sq_initialize); sleep_until(not sq_vex_cloud_init__pilot.is_dropping())

        sleep_until(sq_initialize.count_at_firing_area() > 0, 0.5)

        if sq_initialize.alive_count() > 0:
            run_seize(sq_initialize)
        if sq_initialize.alive_count() == 0:
            print("a PLAYER killed it!")
        else:
            print("the block killed it!")
            vex_death(sq_initialize)

        sq_initialize.deactivate_temperament("temper_freeze")
        sq_initialize.deactivate_temperament("temper_vex_seize")
        sq_vex_cloud_init__pilot.abort_command_script()

def vex_death(sq):
    of_vex_death.add(sq)
    sleep(1)
    of_vex_death.clear()
    sq.kill()

def set_temperaments_base(sq):
    sq.activate_temperament("temper_always_walk")
    sq.activate_temperament("temper_combat_no_self_preserve")
    sq.activate_temperament("temper_combat_no_teleport_path")

def run_seize(sq):

    sleep(1)
    print("seize")
    sq.activate_temperament("temper_vex_seize")
    sq.activate_temperament("temper_freeze")
    sleep(2.5)

script spawn_waves():
    print("start waves thread")
    while func_event_running():
        print("running")

        time = func_event_get_timer()
        if time > 195 and get_wave_alive_count(0) < 2:

            drop_wave_0.restart()
            print("dropped wave[0]")
            sleep(10)
        elif time < 195 and time > 120 and get_wave_alive_count(1) + get_wave_alive_count(2) < 2:
            drop_wave_1.restart()
            sleep(1)
            drop_wave_2.restart()
            print("dropped wave[1], wave[2]")
            sleep(10)
        elif time < 120 and time > 80 and get_wave_alive_count(3) + get_wave_alive_count(4) + get_wave_alive_count(5) < 2:
            drop_wave_3.restart()
            sleep(1)
            drop_wave_4.restart()
            sleep(1)
            drop_wave_5.restart()
            print("dropped wave[3], wave[4], wave[5]")
            sleep(10)
        elif time < 80 and time > 45 and get_wave_alive_count(3) + get_wave_alive_count(4) < 2:
            drop_wave_3.restart()
            sleep(1)
            pf_event_vex_block_wave[4].assign_hopon_all(of_overshield)
            drop_wave_4.restart()
            print("dropped wave[3], wave[4]")
            sleep(10)
        elif time < 45 and get_wave_alive_count(6) + get_wave_alive_count(7) < 1:
            drop_wave_6.restart()
            sleep(1)
            drop_wave_7.restart()
            print("dropped wave[6], wave[7]")
            sleep(10)
        sleep(1)
    print("waves NOT running")

