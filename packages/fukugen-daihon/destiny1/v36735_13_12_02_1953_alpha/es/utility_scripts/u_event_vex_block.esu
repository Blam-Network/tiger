script count_block_kills():
    print("start kill thread")
    il_block_kills.reset()

    while func_event_running():
        i_dead_count = il_block_kills.get_count()

        pf_event_vex_block_preset.po_event_vex_block.progress_update(i_dead_max - i_dead_count)
        sleep(1)







