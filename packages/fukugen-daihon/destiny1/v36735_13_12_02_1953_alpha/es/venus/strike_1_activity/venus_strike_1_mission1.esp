script sc_encounter_engineering():

    floor_encounter()
    formation(3)


    formation(1)


    formation(2)
    objective_complete = true

def formation(rand_int):
    if rand_int == 1:
        print("From the SMALL Room")
        floor_spawn(sq_floor1_fallen03, sq_floor1_fallen04)
        sleep(5)
        floor_spawn(sq_floor1_fallen04a, sq_objective04)
        sleep_until(gr_floor2.alive_count() <= 3)
        if sq_objective04.alive_count() > 0:
            floor_spawn(sq_floor1_fallen03, sq_floor1_fallen04)
        sleep_until(gr_floor2.alive_count() <= 4 and sq_objective04.alive_count() < 1)

    if rand_int == 2:
        print("From the CORNER Room")
        floor_spawn(sq_floor1_fallen05, sq_objective05)
        sleep(5)
        floor_spawn(sq_floor1_fallen06a, sq_objective06)
        sleep_until(gr_floor3.alive_count() <= 3)
        if sq_objective06.alive_count() > 0 and sq_objective05.alive_count() > 0:
            floor_spawn(sq_floor1_fallen05, sq_floor1_fallen06)
        sleep_until(gr_floor3.alive_count() <= 4 and sq_objective06.alive_count() < 1 and sq_objective05.alive_count() < 1)

    if rand_int == 3:
        print("From the Big Room")
        floor_spawn(sq_floor1_fallen07, sq_floor1_fallen08)
        sleep(5)
        floor_spawn(sq_floor1_fallen08a, sq_objective07)
        sleep_until(gr_floor4.alive_count() <= 3)
        if sq_objective07.alive_count() > 0:
            floor_spawn(sq_floor1_fallen07, sq_floor1_fallen08)
        sleep_until(gr_floor4.alive_count() <= 4 and sq_objective07.alive_count() < 1)


def floor_encounter():
    floor_spawn(sq_floor1_fallen01, sq_floor1_fallen02)
    sleep_until(gr_floor1.alive_count() <= 3)


def floor_spawn(sq1, sq2):
    sq1.respawn()
    sleep(mathlib.random_int_inclusive(3, 6))
    sq2.respawn()

