script init():
    sc_heavy_ammo_recycle.wake()

script complete():
    c_lifetime_script_utilities.get_lifetime_sensor().end_game()

script main():
    sgq_strike_minions.add_child(sq_strike01_4)
    sgq_strike_minions.add_child(sq_strike01_6)
    sgq_strike_minions.add_child(sq_strike01_8)
    sgq_strike_minions.add_child(sq_strike02_4)
    sgq_strike_minions.add_child(sq_strike02_6)
    sgq_strike_minions.add_child(sq_strike02_8)
    sgq_strike_minions.add_child(sq_strike03_4)
    sgq_strike_minions.add_child(sq_strike03_6)
    sgq_strike_minions.add_child(sq_strike03_8)
    sgq_strike_guards.add_child(sq_boss_guard01)
    sgq_strike_guards.add_child(sq_boss_guard02)
    sgq_strike_guards.add_child(sq_boss_guard03)
    sgq_strike_guards.add_child(sq_boss_guard04)
    sgq_strike_guards.add_child(sq_boss_guard05)
    sgq_strike_guards.add_child(sq_boss_guard06)
    hydra_health.bind_combatant(sq_boss__ultra_hydra)
    print("Vex Ruins Strike")
    md_s1_m3_d010_trigger.enable()
    sc_mission_logic.wake()
    sleep_until(md_s1_m3_d010_trigger._dialog_sequence.is_done())
    kill_squad_ruins.objective_begin_immediate()
    sleep_until(kill_squad_ruins.is_complete())
    sgq_strike_minions.remove()
    venus_s1_m03_d40.wake()
    sleep_until(md_s1_m3_d040.is_done())
    kill_squad_ruins.objective_end()
    sleep(3)

script sc_heavy_ammo_recycle():
    while true:
        pvp_heavy_cache_respawn_1.create()
        pvp_heavy_cache_respawn_2.create()
        pvp_heavy_cache_respawn_3.create()
        sleep(30)
        pvp_heavy_cache_respawn_1.delete_object()
        pvp_heavy_cache_respawn_2.delete_object()
        pvp_heavy_cache_respawn_3.delete_object()


script sc_mission_logic():

    print("place guards")
    sq_boss_guard01.place()
    sq_boss_guard02.place()
    sq_boss_guard03.place()
    sq_boss_guard04.place()
    sq_boss_guard05.place()
    sq_boss_guard06.place()
    sleep_until(sgq_strike_guards.alive_count() > 5)
    sleep_until(sgq_strike_guards.alive_count() < 5)
    sleep_until_timeout(sgq_strike_guards.alive_count() < 1, 120)
    sq_boss.place()
    sleep(1)
    sleep_until(hydra_health.is_ready(), 0.5)
    print("start encounter")
    sleep_until(hydra_health.get_health_fraction() < 0.75)
    print("hydra health < 75%")
    g_wave_num = 1
    strike_player_direction()
    strike_warpstorm_direction()
    sleep_until(hydra_health.get_health_fraction() < 0.50)
    print("hydra health < 50%")
    g_wave_num = 2
    strike_player_direction()
    strike_warpstorm_direction()
    sleep_until(hydra_health.get_health_fraction() < 0.25)
    print("hydra health < 25%")
    g_wave_num = 3
    strike_player_direction()
    strike_warpstorm_direction()

def strike_warpstorm_direction():
    if g_wave_num == 1:
        if g_spawn_direction == 1:
            strike_warpgate(warpstorm01__storm, sq_strike01_4)
            strike_warpgate(warpstorm02__storm, sq_strike02_4)

        elif g_spawn_direction == 2:
            strike_warpgate(warpstorm02__storm, sq_strike02_4)
            strike_warpgate(warpstorm03__storm, sq_strike03_4)

        elif g_spawn_direction == 3:
            strike_warpgate(warpstorm03__storm, sq_strike03_4)
            strike_warpgate(warpstorm01__storm, sq_strike01_4)

    if g_wave_num == 2:
        if g_spawn_direction == 1:
            strike_warpgate(warpstorm01__storm, sq_strike01_6)
            strike_warpgate(warpstorm02__storm, sq_strike02_6)
            strike_warpgate(warpstorm03__storm, sq_strike03_4)

        elif g_spawn_direction == 2:
            strike_warpgate(warpstorm02__storm, sq_strike02_6)
            strike_warpgate(warpstorm03__storm, sq_strike03_6)
            strike_warpgate(warpstorm01__storm, sq_strike01_4)

        elif g_spawn_direction == 3:
            strike_warpgate(warpstorm03__storm, sq_strike03_6)
            strike_warpgate(warpstorm01__storm, sq_strike01_6)
            strike_warpgate(warpstorm02__storm, sq_strike02_4)

    if g_wave_num == 3:
        if g_spawn_direction == 1:
            strike_warpgate(warpstorm01__storm, sq_strike01_8)
            strike_warpgate(warpstorm02__storm, sq_strike02_8)
            strike_warpgate(warpstorm03__storm, sq_strike03_6)

        elif g_spawn_direction == 2:
            strike_warpgate(warpstorm02__storm, sq_strike02_8)
            strike_warpgate(warpstorm03__storm, sq_strike03_8)
            strike_warpgate(warpstorm01__storm, sq_strike01_6)

        elif g_spawn_direction == 3:
            strike_warpgate(warpstorm03__storm, sq_strike03_8)
            strike_warpgate(warpstorm01__storm, sq_strike01_8)
            strike_warpgate(warpstorm02__storm, sq_strike02_6)

def strike_warpgate(cloud, sq):
    sleep_until(sgq_strike_minions.alive_count() < 12)
    if kill_squad_ruins.is_complete() == false:
        cloud.place()
    if kill_squad_ruins.is_complete() == false:
        cloud.drop_squad(sq); sleep_until(not cloud.is_dropping())
    cloud.remove()


def strike_player_direction():



    if pm_2_vol.get_count() >= pm_1_vol.get_count() and pm_2_vol.get_count() >= pm_3_vol.get_count():
        g_spawn_direction = 2
    elif pm_1_vol.get_count() >= pm_2_vol.get_count() and pm_1_vol.get_count() >= pm_3_vol.get_count():
        g_spawn_direction = 1
    elif pm_3_vol.get_count() >= pm_2_vol.get_count() and pm_3_vol.get_count() >= pm_1_vol.get_count():
        g_spawn_direction = 3
    else:
        d_rand_num = mathlib.random_int_inclusive(1, 3)
        if d_rand_num == 1:
            g_spawn_direction = 1
        if d_rand_num == 2:
            g_spawn_direction = 2
        if d_rand_num == 3:
            g_spawn_direction = 3
    print("!!!!!!!!!!!!!!!!!!g_spawn_direction!!!!!!!!!!!!!!!!!!!!!!! : " + g_spawn_direction)


