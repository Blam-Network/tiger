    sq_vex_warpgate_single_large_d.remove()
    sq_vex_warpgate_single_large_e.remove()
    sq_vex_warpgate_single_large_f.remove()
    sq_vex_warpgate_large__gate.set_channel_scalar("power", 0)
    d_device_warpgate.set_device_position(1)

