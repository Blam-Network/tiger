thread sc_gate00:
    sleep_until(pt_spawn_boss.is_triggered())
    vex_warp_gate00.power_up()
    sleep_until(vex_warp_gate00.drop_cue == true)
    vex_warp_gate00.drop_begin(sq_vex_reinf00)
    sleep(mathlib.random_int_inclusive(3, 6))
    vex_warp_gate00.drop_begin(sq_vex_reinf00a)
    sleep(mathlib.random_int_inclusive(4, 7))
    vex_warp_gate00.drop_begin(sq_vex_reinf00b)
    sleep_until(sqg_vex_reinf00.alive_count() < 4)
    vex_warp_gate00.reinforce(sq_vex_reinf00c)

thread sc_gate01:
    sleep_until(pt_spawn_boss.is_triggered())
    vex_warp_gate01.power_up()
    sleep_until(vex_warp_gate01.drop_cue == true)
    vex_warp_gate01.drop_begin(sq_vex_reinf01)
    sleep(mathlib.random_int_inclusive(3, 6))
    vex_warp_gate01.drop_begin(sq_vex_reinf01a)
    sleep(mathlib.random_int_inclusive(4, 7))
    vex_warp_gate01.drop_begin(sq_vex_reinf01b)
    sleep_until(sqg_vex_reinf01.alive_count() < 2)
    vex_warp_gate01.reinforce(sq_vex_reinf01c)

thread sc_spawn_boss:
    minions_spawn = true
    sc_minion_spawner.wake()
    sleep_until(gatekeeper_spawn == true)
    print("**** 0.4 Miniboss Prespawn")
    sq_vex_warpgate_large__gate.set_channel_scalar("boss_power_up", 1)
    sleep(4)
    print("**** 0.5 Miniboss Spawn")
    func_vex_warpgate(sq_vex_warpgate_large__gate, sq_miniboss)
    sq_vex_warpgate_large__gate.set_channel_scalar("boss_power_up", 0)
    print("SPAWNING STRIKERS")
    sleep_until_timeout(sq_miniboss.alive_count() >= 1, 15)
    sc_boss_health.wake()
    sc_strikers.wake()
    sleep_until(ch2m4_kill_boss.is_complete())
    gatekeeper_dead = true
    sg_strikers.kill()
    sq_boss_minions01.kill()
    sq_boss_minions02.kill()

thread sc_gate_channel:

    print("**** 0.2 Powered Idle")
    sleep(2)

    sleep_until(minions_spawn == true)
    print("**** 0.3 Fodder Spawn")

    gatekeeper_spawn = true

    print("**** 0.6 Miniboss Fight")
    sleep_until(gatekeeper_dead == true)

    print("**** 0.7 Miniboss Death")
    sleep(4)

    print("**** 0.8 Warpgate dies")
    sq_vex_warpgate_large__gate.set_channel_scalar("power", 0)
    d_device_warpgate.set_device_position(1)
    sleep_until(d_device_warpgate.get_device_position() >= 1)
    sleep(5)
    gate_destroyed = true

thread sc_boss_health:
    sleep_until(boss_health.is_ready(), 0.5)
    gatekeeper_alive = true
    sleep_until(boss_health.get_health_fraction() < 0.80)
    print("hydra health < 80%")
    strikers_spawn = true
    sleep_until(boss_health.get_health_fraction() < 0.60)
    print("hydra health < 60%")
    strikers_spawn = true
    sleep_until(boss_health.get_health_fraction() < 0.40)
    print("hydra health < 40%")
    strikers_spawn = true
    sleep_until(boss_health.get_health_fraction() < 0.20)
    print("hydra health < 20%")
    strikers_spawn = true

thread sc_strikers:
    while gatekeeper_dead == false:
        sleep_until(strikers_spawn == true)
        strikers_spawn = false
        minotaur_roar.start()
        sq_vex_warpgate_large__gate.set_channel_scalar("mini_spawn", 1)
        for sq in pick_random_count(6, sq_boss_striker01, sq_boss_striker02, sq_boss_striker03, sq_boss_striker04, sq_boss_striker05, sq_boss_striker06):
            func_spawn_stagger(sq)
        sleep(7)
    sq_vex_warpgate_large__gate.set_channel_scalar("mini_spawn", 0)

thread sc_minion_spawner:
    sq_vex_warpgate_large__gate.set_channel_scalar("mini_spawn", 1)
    func_vex_warpgate(sq_vex_warpgate_single_large_e__gate, sq_boss_minions01)
    func_vex_warpgate(sq_vex_warpgate_single_large_f__gate, sq_boss_minions02)
    sq_vex_warpgate_large__gate.set_channel_scalar("mini_spawn", 0)






def func_spawn(sq):
    sq.respawn()

def func_spawn_stagger(sq):
    if sq.alive_count() <= 0:
        sleep(mathlib.random_int_inclusive(0.5, 1.5))
        for gate in pick_random_count(1, sq_vex_warpgate_single_large_a__gate, sq_vex_warpgate_single_large_b__gate, sq_vex_warpgate_single_large_c__gate, sq_vex_warpgate_single_large_d__gate):
            func_vex_warpgate(gate, sq)

def func_vex_warpgate(warpgate, sq):
    if gatekeeper_dead == false:
        warpgate.drop_squad(sq); sleep_until(not warpgate.is_dropping())

def reset_trigger_in_bubble(trig, zone):
    if not zone.test_any_inside():
        print("resetting trigger")
        trig.reset()

