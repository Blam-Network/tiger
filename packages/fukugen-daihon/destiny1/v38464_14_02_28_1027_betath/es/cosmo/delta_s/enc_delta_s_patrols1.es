# es\cosmo\delta_s\enc_delta_s_patrols1.es
#
# The patrol beacons of the delta south (the steppes): three hotspots a
# player uses to take a patrol mission, which cosmo_patrols_1 hands out.
# They are up from the bundle's load and stay up; the controller takes each
# use and the beacon is ready again.
#
# Retail 2.3.1's delta south beacons (bundle 639C0B08, three) came up with
# the bubble and gave the scan and both collect missions.

@activity_bundle("enc_delta_s_patrols1")

patrol_terminal patrol_terminal
patrol_terminal patrol_terminal_1
patrol_terminal patrol_terminal_2
