# es\utility_scripts\patrol_kill_combatant.esu
#
# A patrol mission: kill a number of one kind of enemy (dregs, vandals,
# shanks, servitors, troopers) anywhere in the destination. This build's
# kill missions are per kind; the ff build and retail have one kind-blind
# patrol_kill_enemy instead.
#
# Run as retail 2.3.1's kill missions (cosmo patrol capture): the objective
# goes straight to active with a bar of 0 to the count, steps by one per
# kill, completes a couple of seconds after the bar fills and is cleared
# 5 s later. No waypoint. The kind filter is the dead combatant's name.

player_objective _player_objective
kill_incident_listener _incident_listener
string_hash _participant_fireteam_hash = "participant_fireteam"
string_hash _combatant_name
int _count

def import_only_bind(combatant_name, count):
    _combatant_name = combatant_name
    _count = count
    return true

def is_active():
    return _player_objective.is_active()

def is_complete():
    return _incident_listener.get_count() >= _count

def objective_begin():
    _incident_listener.reset()
    _incident_listener.bind_audience_hash(_participant_fireteam_hash)
    _incident_listener.bind_dead_combatant_name_hash(_combatant_name)
    _player_objective.set_active()
    _player_objective.progress_activate(0, _count)
    progress_watcher.restart()

script progress_watcher():
    while _player_objective.is_active() and not _player_objective.progress_is_complete():
        _player_objective.progress_update(_incident_listener.get_count())
        sleep(1)

def objective_end():
    _player_objective.progress_update(_count)
    sleep(1.5)
    _player_objective.set_complete()
    sleep(5)
    _player_objective.clear()

def objective_end_silent():
    _player_objective.clear()
