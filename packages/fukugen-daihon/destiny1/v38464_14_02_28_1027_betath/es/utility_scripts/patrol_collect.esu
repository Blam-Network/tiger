# es\utility_scripts\patrol_collect.esu
#
# A patrol mission: pick up a number of drops from the destination's
# enemies. Each loot row is one kind of drop the mission counts (two a
# mission in this build). Named after the Alpha Trial-era ff build's
# missions, whose player objectives carry the import name "patrol_collect".
#
# Retail 2.3.1's (cosmo patrol capture, two collect missions): every loot
# row is enabled as the objective goes active, with a bar of 0 to the count
# (7 for multi_armor, 10 for all_armor_a); the bar steps with each pickup.
# The loot is disabled and reset a second after the bar fills, the
# objective completes 1.5 s after that and is cleared 5 s later.

player_objective _player_objective
dynamic_array<loot> _loot
int _count

def import_only_bind(count):
    _count = count
    return true

def get_count():
    total = 0
    for drop in _loot:
        total = total + drop.get_count()
    return total

def is_active():
    return _player_objective.is_active()

def is_complete():
    return get_count() >= _count

def objective_begin():
    for drop in _loot:
        drop.enable()
    _player_objective.set_active()
    _player_objective.progress_activate(0, _count)
    progress_watcher.restart()

script progress_watcher():
    while _player_objective.is_active() and not _player_objective.progress_is_complete():
        _player_objective.progress_update(get_count())
        sleep(1)

def cleanup():
    for drop in _loot:
        drop.disable()
        drop.reset()

def objective_end():
    _player_objective.progress_update(_count)
    cleanup()
    sleep(1.5)
    _player_objective.set_complete()
    sleep(5)
    _player_objective.clear()

def objective_end_silent():
    cleanup()
    _player_objective.clear()
