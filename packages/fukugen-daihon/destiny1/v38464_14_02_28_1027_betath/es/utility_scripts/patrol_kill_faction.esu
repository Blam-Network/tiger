# es\utility_scripts\patrol_kill_faction.esu
#
# A patrol mission: kill a number of one faction's enemies (the Fallen,
# the Hive) anywhere in the destination. The rows give each one a _faction
# instance with nothing under it, so what picks the faction is not in the
# packages; the kill count here takes every kill the fireteam makes, as the
# ff build's patrol_kill_enemy (which dropped the faction) does.
#
# Run as retail 2.3.1's kill missions (cosmo patrol capture, counts 18 and
# 17): the objective goes straight to active with a bar of 0 to the count,
# steps by one per kill, completes a couple of seconds after the bar fills
# and is cleared 5 s later. No waypoint.

player_objective _player_objective
patrol_faction _faction
kill_incident_listener _incident_listener
string_hash _participant_fireteam_hash = "participant_fireteam"
int _count

def import_only_bind(count):
    _count = count
    return true

def is_active():
    return _player_objective.is_active()

def is_complete():
    return _incident_listener.get_count() >= _count

def objective_begin():
    _incident_listener.reset()
    _incident_listener.bind_audience_hash(_participant_fireteam_hash)
    _player_objective.set_active()
    _player_objective.progress_activate(0, _count)
    progress_watcher.restart()

script progress_watcher():
    while _player_objective.is_active() and not _player_objective.progress_is_complete():
        _player_objective.progress_update(_incident_listener.get_count())
        sleep(1)

def objective_end():
    _player_objective.progress_update(_count)
    sleep(1.5)
    _player_objective.set_complete()
    sleep(5)
    _player_objective.clear()

def objective_end_silent():
    _player_objective.clear()
