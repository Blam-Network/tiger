# es\utility_scripts\u_event_tank_drop_preset.esu
#
# The Walker drop's presentation (pf_event_tank_drop's pf_preset): the public
# event objective, the engagement hop-on, the pre-engage volume, and the lines
# and music the event plays. Bound as the alpha's other presets are: the lines
# are skipped and the music postponed while the objective is suppressed.

player_objective po_event_tank
hop_on ho_engagement
trigger_volume tv_drill_pre_engage
player_trigger pt_drill_pre_engage bind(tv_drill_pre_engage)
sequence seq_intro_behavior
sequence seq_tank_warmup
sequence seq_tank_start bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_engage
sequence seq_tank_attack bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - no run showed what cues it
sequence seq_tank_time75 bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_time50 bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_time25 bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_health75 bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - no native reads the Walker's health
sequence seq_tank_health50 bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - no native reads the Walker's health
sequence seq_tank_health25 bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - no native reads the Walker's health
sequence seq_tank_vital_first bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - a line per Walker leg broken; no incident for it is known
sequence seq_tank_vital_second bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - a line per Walker leg broken; no incident for it is known
sequence seq_tank_vital_third bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - a line per Walker leg broken; no incident for it is known
sequence seq_tank_vital_last bind(po_event_tank, e_sequence_suppression_behavior.skip)  # WARNING: unused - a line per Walker leg broken; no incident for it is known
sequence seq_tank_end_gold bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_end_silver bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_end_bronze bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_end_part bind(po_event_tank, e_sequence_suppression_behavior.skip)
sequence seq_tank_music1 bind(po_event_tank, e_sequence_suppression_behavior.postpone)
