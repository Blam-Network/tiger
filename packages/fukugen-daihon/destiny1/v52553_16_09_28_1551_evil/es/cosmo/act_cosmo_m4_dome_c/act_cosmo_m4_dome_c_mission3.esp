# es\cosmo\act_cosmo_m4_dome_c\act_cosmo_m4_dome_c_mission3.esp
#
# Mission 3, the Hive assault: the console starts working and the Hive come
# for it. The objective clears once the last wave dies; enc_dome_c_m4 runs
# the waves.

c_object_sensor_host o_terminal_invis_device
c_sequence_host seq_m_cue1
c_sequence_host seq_d_o3_s03
generic_objective obj_m4_o3a
c_squad_sensor_host sq_hive_assault_trooper03a
c_squad_sensor_host sq_hive_assault_trooper03b
c_squad_sensor_host sq_hive_assault_trooper03c
c_squad_sensor_host sq_hive_assault_heavy03a

thread init: pass

thread complete: pass

thread main:
    o_terminal_invis_device.create()
    sleep(5)
    obj_m4_o3a.objective_begin_immediate(nil)
    seq_m_cue1.set_switch_mask(31)
    # the Knight drops last: the wave is over once it is in and all four are dead
    sleep_until(sq_hive_assault_heavy03a.alive_count() > 0)
    sleep_until(last_wave_alive_count() == 0)
    seq_m_cue1.set_switch_mask(63)
    sleep(2)
    seq_m_cue1.stop()
    seq_d_o3_s03.start()
    sleep(2)
    obj_m4_o3a.objective_end_silent()

def last_wave_alive_count():
    return sq_hive_assault_trooper03a.alive_count() + sq_hive_assault_trooper03b.alive_count() + sq_hive_assault_trooper03c.alive_count() + sq_hive_assault_heavy03a.alive_count()
