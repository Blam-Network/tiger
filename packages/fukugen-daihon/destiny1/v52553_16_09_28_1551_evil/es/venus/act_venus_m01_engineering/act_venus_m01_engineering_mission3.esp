# es\venus\act_venus_m01_engineering\act_venus_m01_engineering_mission3.esp
#
# Mission 3, on to the Academy entrance. The music comes in at its trigger or
# after twenty seconds; the Ghost speaks at the entrance.

generic_objective pf_enter_academy
c_trigger_volume_slot_host tv_entrance
c_player_trigger_sensor_host pt_entrance bind(tv_entrance)
c_nav_point_host ap_entrance
c_sequence_host venus_m01_music_cue1
c_player_trigger_sensor_host pt_venus_m01_cue1_start
c_player_trigger_sensor_host pt_vn01_020_30
c_sequence_host md_vn01_020_50

thread init: pass

thread complete: pass

thread main:
    venus_m01_music_cue1.set_switch_mask(2)
    pt_vn01_020_30.enable()
    venus_m01_cue1.wake()
    pf_enter_academy.objective_begin(ap_entrance)
    sleep_until(pt_entrance.is_triggered())
    pf_enter_academy.objective_end_silent()
    venus_m01_020_d50.wake()
    sleep_until(md_vn01_020_50.is_done())

thread venus_m01_cue1:
    sleep_until_timeout(pt_venus_m01_cue1_start.is_triggered(), 20)
    venus_m01_music_cue1.start()
    venus_m01_music_cue1.set_switch_mask(3)

thread venus_m01_020_d50:
    md_vn01_020_50.start()
    print("md_vn01_020_50")
