# es\mars\act_mars_m05_warbase\act_mars_m05_warbase_mission3.esp
#
# Mission 3, phase_4_mesa: use the console on the mesa. The Ghost talks while
# the objective is up; using the console cuts the lines, plays the next one
# and, once the phase has cleared, sets off the mesa's alarm. The console is
# the mesa's own object (the identifier is the table's; its name is not
# cracked).

interactable_objective pf_objective_button bind("0x481977E3")
c_sequence_host seq_d_o1_s06
c_sequence_host seq_d_o1_s07
c_sequence_host seq_d_o1_s08
c_sequence_host seq_alarm_mesa

thread init: pass

thread complete: pass

thread main:
    pf_objective_button.objective_begin()
    seq_d_o1_s06.start()
    seq_d_o1_s07.start()
    sleep_until(pf_objective_button.is_complete())
    sleep(1.2)
    seq_d_o1_s06.stop()
    seq_d_o1_s07.stop()
    sleep(1)
    seq_d_o1_s08.start()
    sleep(2.2)
    pf_objective_button.objective_end_silent()
    sleep(3)
    seq_alarm_mesa.start()
    sleep(3)
