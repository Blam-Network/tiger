# es\mars\act_mars_m05_warbase\act_mars_m05_warbase_mission2.esp
#
# Mission 2, phase_3_mesa_goto: through the Rubicon to the mesa. Clears as a
# player enters the mesa's bubble (public; enc_mesa_amb1's Cabal).

c_location_sensor_host mesa
trigger_bubble_objective pf_objective_goto bind(mesa)

thread init: pass

thread complete: pass

thread main:
    pf_objective_goto.objective_begin()
    sleep_until(pf_objective_goto.is_complete())
    pf_objective_goto.objective_end_silent()
