# es\mars\act_mars_m01_valley\act_mars_m01_valley_mission4.esp
#
# Mission 4, the battleground and the Cabal checkpoint: ride to the
# checkpoint, then use its console. The battleground lines are started
# together and play off their own volumes on the way; the checkpoint music
# starts on pt_checkpoint_music_start (unknown_11b7a83e) and moves on with
# the objectives. The road and bunker Cabal belong to enc_checkpoint_m01.
#
# One run: the 2 s after the console is the gap to the next phase.

trigger_volume_objective sp_objective_goto
interactable_objective sp_objective_console bind("0x47DCE9B0")
c_trigger_volume_slot_host tv_checkpoint_music_start
c_player_trigger_sensor_host pt_checkpoint_music_start bind(tv_checkpoint_music_start)
c_sequence_host seq_music_checkpoint
c_sequence_host seq_dialog_plains_base_complete
c_sequence_host seq_dialog_plains_battleground_transition
c_sequence_host seq_dialog_battleground
c_sequence_host seq_dialog_battleground_checkpoint_transition
c_sequence_host seq_dialog_checkpoint_console
c_sequence_host seq_dialog_checkpoint_console_complete

thread init: pass

thread complete: pass

thread main:
    insertion_point()
    pt_checkpoint_music_start.reset()
    for line in [seq_dialog_plains_base_complete, seq_dialog_plains_battleground_transition, seq_dialog_battleground, seq_dialog_battleground_checkpoint_transition]:
        line.start()
    sp_objective_goto.objective_begin()
    sleep_until(sp_objective_goto.is_complete())
    sp_objective_goto.objective_end_silent()
    seq_dialog_battleground_checkpoint_transition.stop()
    seq_music_checkpoint.set_switch_mask(3)
    seq_dialog_checkpoint_console.start()
    sp_objective_console.objective_begin()
    sleep(55)
    sp_objective_console.objective_end_silent()
    seq_dialog_checkpoint_console_complete.start()
    sleep(2)
