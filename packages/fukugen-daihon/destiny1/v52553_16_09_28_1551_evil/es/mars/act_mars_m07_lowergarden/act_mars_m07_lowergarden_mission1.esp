# es\mars\act_mars_m07_lowergarden\act_mars_m07_lowergarden_mission1.esp
#
# Mission 1, the Barrens: the mission starts once the players are in, with
# the intro music and the Ghost's lines for the walk to the valley. The
# valley gate line is armed here too; it plays off its own volume.

c_sequence_host seq_music_intro
c_sequence_host seq_dialog_plains_intro
c_sequence_host seq_dialog_checkpoint_valley_transition
c_sequence_host seq_dialog_valley_gate

thread init: pass

thread complete: pass

thread main:
    sleep_until(c_player_script_utilities.all_players_are_ready())
    c_lifetime_script_utilities.get_lifetime_sensor().set_state(e_activity_lifetime_state.active)
    seq_music_intro.start()
    seq_dialog_plains_intro.start()
    seq_dialog_checkpoint_valley_transition.start()
    seq_dialog_valley_gate.start()
