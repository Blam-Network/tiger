# es\moon\act_moon_m1_launchtubes\act_moon_m1_launchtubes_mission1.esp
#
# Mission 1, the intro: the cinematic over the Moon. The player spawns at the
# accelerator once it has played.

cinematic_midmission pf_cine_109_mnr

thread init: pass

thread complete: pass

thread main:
    sleep(1)
    pf_cine_109_mnr.start()
    sleep_until(pf_cine_109_mnr.is_complete())
