# es\cosmo\cosmo_portal1_activity\cosmo_portal1_activity_mission2.esp
#
# Mission 2, the refinery: reach the door, then clear the playfight squads.
# The phase's wake triggers start the refinery's entrance trash and its
# playfight; the squads themselves belong to the refinery encounter.

# @hard_wipe()  (off: Codie, 2026-10-22)
trigger_volume_objective obj_s1_phase01_m1
generic_objective obj_s1_phase01_m2
nav_point ap_refinery_central01
encounter_handle enc_refinery_portal1
trigger_volume tv_wake_trash01
player_trigger pt_wake_trash01 bind(tv_wake_trash01)
trigger_volume tv_wake_playfight01
player_trigger pt_wake_playfight01 bind(tv_wake_playfight01)

script init(): pass

script complete(): pass

script main():
    sc_wake_trash.wake()
    sc_wake_playfight.wake()
    obj_s1_phase01_m1.objective_begin()
    sleep_until(obj_s1_phase01_m1.is_complete())
    obj_s1_phase01_m1.objective_end_silent()
    obj_s1_phase01_m2.objective_begin(ap_refinery_central01)
    sleep_until(playfight_alive_count() > 0)
    sleep_until(playfight_alive_count() == 0)
    sleep(1)
    obj_s1_phase01_m2.objective_end_silent()

script sc_wake_trash():
    pt_wake_trash01.reset()
    sleep_until(pt_wake_trash01.is_triggered())
    enc_refinery_portal1.sc_trash.wake()

script sc_wake_playfight():
    pt_wake_playfight01.reset()
    sleep_until(pt_wake_playfight01.is_triggered())
    enc_refinery_portal1.sc_playfight.wake()

def playfight_alive_count():
    enc = enc_refinery_portal1
    return enc.sq_playfight_hive01.alive_count() + enc.sq_playfight_hive02.alive_count() + enc.sq_playfight_fallen01.alive_count() + enc.sq_playfight_fallen02.alive_count()
