# es\cosmo\cosmo_portal1_activity\cosmo_portal1_activity_mission7.esp
#
# Mission 7, Sepiks Prime: kill the servitor. Its squad counts it alive until
# its own death edge, so its teleports never read as a death; the phase ends
# as it dies and its adds die with it.

# @hard_wipe()  (off: Codie, 2026-10-22)
encounter_handle enc_ship_portal1
generic_objective obj_s1_phase06_m1
nav_point ap_kill_boss01

script init(): pass

script complete(): pass

script main():
    enc = enc_ship_portal1
    enc.sc_boss_fight.wake()
    obj_s1_phase06_m1.objective_begin(ap_kill_boss01)
    sleep_until(enc.sq_bossbattle_boss01.alive_count() > 0)
    sleep_until(enc.sq_bossbattle_boss01.alive_count() == 0)
    enc.end_boss_fight()
    obj_s1_phase06_m1.objective_end_silent()
