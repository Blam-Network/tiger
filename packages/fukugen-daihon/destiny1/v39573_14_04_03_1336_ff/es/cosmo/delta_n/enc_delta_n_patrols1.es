# es\cosmo\delta_n\enc_delta_n_patrols1.es
#
# The patrol beacons of the delta north: three hotspots a player uses to
# take a patrol mission, which cosmo_patrols_1 hands out. They are up from
# the bundle's load and stay up; the controller takes each use and the
# beacon is ready again.
#
# No capture has been in this zone; its beacons run as retail 2.3.1's delta
# south and graveyard beacons did.

@activity_bundle("enc_delta_n_patrols1")

patrol_terminal patrol_terminal
patrol_terminal patrol_terminal_1
patrol_terminal patrol_terminal_2
