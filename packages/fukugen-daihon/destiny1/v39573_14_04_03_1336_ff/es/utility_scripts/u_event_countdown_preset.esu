# es\utility_scripts\u_event_countdown_preset.esu
#
# The countdown (Warsat) events' presentation (their pf_preset): the public
# event objective, and the dialogue and music the event plays as it goes.
# TU0's is the 360 alpha's with its sequences renamed and the pre-engage volume
# moved out to the event; the bindings are the 360 alpha's.

player_objective po_event_countdown
sequence seq_intro_behavior
sequence seq_warsat_announce bind(po_event_countdown, e_sequence_suppression_behavior.postpone)
sequence seq_warsat_announce_generic
sequence seq_warsat_start bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_engage
sequence seq_warsat_engage_generic
sequence seq_warsat_update_time bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_update_time_generic
sequence seq_warsat_update_progress bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_update_progress_generic
sequence seq_warsat_ending_time bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_ending_time_generic
sequence seq_warsat_ending_progress bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_ending_progress_generic
sequence seq_warsat_complete_gold bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_complete_gold_generic
sequence seq_warsat_complete_silver bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_complete_silver_generic
sequence seq_warsat_complete_bronze bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_complete_bronze_generic
sequence seq_warsat_complete_failure bind(po_event_countdown, e_sequence_suppression_behavior.skip)
sequence seq_warsat_complete_failure_generic
sequence seq_warsat_music1 bind(po_event_countdown, e_sequence_suppression_behavior.postpone)
trigger_volume tv_warsat_start_audio
