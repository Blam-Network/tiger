{
  "name": "@blamnetwork/rsat",
  "version": "1.0.0",
  "description": "Schema-first Destiny RSAT bitstream encode/decode for TypeScript",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node ../../scripts/write-cjs-package-json.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "docs": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Blam-Network/tiger.git",
    "directory": "packages/rsat"
  },
  "homepage": "https://blam-network.github.io/rsat/",
  "keywords": [
    "destiny",
    "rsat",
    "bitstream",
    "schema",
    "replication",
    "blam"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@blamnetwork/blf": "^1.1.0-beta.7"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
