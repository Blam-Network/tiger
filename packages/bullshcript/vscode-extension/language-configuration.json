{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["\"", "\""], ["'", "'"]],
  "onEnterRules": [
    {
      "beforeText": "^\\s*(?:def|static def|script|command_script|class|struct|enum|if|elif|else|while|for|switch|case|default)\\b.*:\\s*(#.*)?$",
      "action": { "indent": "indent" }
    }
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:def|static def|script|command_script|class|struct|enum|if|elif|else|while|for|switch|case|default)\\b.*:\\s*(#.*)?$",
    "decreaseIndentPattern": "^\\s*(?:elif|else|case|default)\\b.*:\\s*$"
  }
}
