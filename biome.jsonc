{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core"],
  "files": {
    "includes": [
      "!**/dist",
      "!**/dist-cjs",
      "!**/node_modules",
      "!**/test/corpus",
      "!**/docs/.vitepress",
      "!**/*.generated.ts"
    ]
  },
  "linter": {
    "rules": {
      "style": {
        "useNumericSeparators": "off",
        "useFilenamingConvention": "off"
      },
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      }
    }
  },
  "overrides": [
    {
      // Binary formats and the Lua VM are bit twiddling all the way down.
      "includes": [
        "packages/*/src/**",
        "packages/bullshcript/test/**",
        "packages/bullshcript/tools/**",
        "packages/gibbon/test/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useDefaultSwitchClause": "off",
            "noParameterAssign": "off"
          }
        }
      }
    },
    {
      // The schema DSL's field types are generic all the way down.
      "includes": ["packages/rsat/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noShadowRestrictedNames": "off"
          },
          "style": {
            "noNamespace": "off",
            "useUnifiedTypeSignatures": "off"
          }
        }
      }
    },
    {
      // Name hash cracking: FNV run forwards and backwards.
      "includes": ["scripts/names/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noBitwiseOperators": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts"],
      "linter": {
        "rules": {
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": [
        "scripts/**",
        "packages/*/scripts/**",
        "packages/*/tools/**"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
